		var conState = E('div', { 'class': 'gs-hint' }, 'состояние консоли: —');
		function conAct(action) {
			view.act(callConsole, { action: action,
				ip: (conIp.value || '').trim(), sub: (conSel.value || ''),
				countries: (conCc.value || '').trim() });
		}
		// The card used to be empty after every reload: nothing ever asked the router what the
		// lane is. `console_status` is read-only, so it is safe to call on each render; after a
		// switch the reload re-renders and reads it again.
		callConsoleStatus().then(function(cs) {
			cs = cs || {};
			conIp.value = cs.ip || '';
			conCc.value = cs.countries || '';
			conSel.value = cs.sub ? String(cs.sub) : '';
			var cc = cs.config || {};
			// `state` distinguishes "on and matching" from "on but traffic goes elsewhere"
			// and from "could not check"; enabled/rule/tun stay for older backends.
			var csState = cs.state || '—';
			var csUnknown = (cs.unknown && cs.unknown.length)
				? ' · не проверено: ' + cs.unknown.join(', ') : '';
			conState.textContent = 'состояние консоли: ' + (cs.enabled ? 'включена' : 'выключена')
				+ ' · состояние: ' + csState
				+ ' · правило: ' + (cs.rule ? 'есть' : 'нет')
				+ ' · туннель Console: ' + (cs.tun ? 'поднят' : 'нет')
				+ ' · группа CONSOLE: ' + (cc.group ? 'есть' : 'нет')
				+ ' · провайдер console: ' + (cc.provider ? 'есть' : 'нет')
				+ csUnknown;
		}).catch(function() {
			// A router whose backend has no such method must still render the card.
			conState.textContent = 'состояние консоли: нет данных';
		});
		// The archive is built on the router and handed back through the same authenticated ubus
		// call as the rest of the panel: the owner gets a file, not a path in /tmp to hunt for
		// (review 15.11, #15). The object URL is created from those bytes only - no network
		// response is ever put into href, so a broken answer cannot navigate the panel away.
		function saveBundle(res, statusEl) {
			if (!res || !res.data) {
				statusEl.textContent = 'архив не получен: ' + ((res && res.error) || 'нет данных');
				return false;
			}
			var bin = atob(res.data);
			var bytes = new Uint8Array(bin.length);
			for (var i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
			var blob = new Blob([bytes], { type: 'application/gzip' });
			var url = URL.createObjectURL(blob);
			var a = E('a', { 'href': url, 'download': res.name || 'geomask-diagnostics.tar.gz' });
			document.body.appendChild(a);
			a.click();
			document.body.removeChild(a);
			setTimeout(function() { URL.revokeObjectURL(url); }, 10000);
			statusEl.textContent = 'архив сохранён: ' + (res.name || '')
				+ ' (' + (res.bytes || 0) + ' байт)';
			return true;
		}
		var conCard = E('div', { 'class': 'gs-card' }, [
			E('h3', {}, 'Игровая консоль — отдельный выход'),
			E('div', { 'class': 'gs-row' }, [
				E('span', { 'class': 'gs-label' }, 'IP консоли'), conIp,
