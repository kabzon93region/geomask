{
	"_comment": "Single source of truth for the geo-sync RPC surface. tools/gen-geo-rpc.py regenerates all four integration points from this manifest: assets/geo-sync (rpcd list+call), assets/acl-geo-sync.json, assets/geo-backend.sh (dispatcher cases), assets/geo-sync-page.js (rpc.declare block). Method order here is canonical and used everywhere.",
	"rpc_object": "geo-sync",
	"backend": "/usr/bin/geo-backend.sh",
	"acl": {
		"group": "luci-app-geo-sync",
		"description": "Grant access to geo masking + AI routing panel",
		"read_extra": {
			"system": ["info"]
		}
	},
	"methods": [
		{ "name": "status", "acl": "read", "args": [], "js": "callStatus" },
		{ "name": "leases", "acl": "read", "args": [], "js": "callLeases" },
		{ "name": "log", "acl": "read", "args": [], "js": "callLog" },
		{ "name": "backups", "acl": "read", "args": [], "js": "callBackups" },
		{ "name": "stack", "acl": "read", "args": [], "js": "callStack" },
		{ "name": "nodescan", "acl": "write", "args": [], "js": "callNodescan", "backend_body": [
			"  nodescan)   # kick the node audit in background (returns immediately; panel re-reads stack)",
			"    ( /usr/bin/geomask-node-scan.sh >/dev/null 2>&1 & )",
			"    printf '{\"ok\":true,\"started\":true}\\n' ;;"
		] },
		{ "name": "nodes_get", "acl": "read", "args": [], "js": "callNodesGet" },
		{ "name": "nodes_paths_get", "acl": "read", "args": [], "js": "callNodesPathsGet" },
		{ "name": "nodes_path_save", "acl": "write", "args": ["path_id", "countries", "expected_revision"], "js": "callNodesPathSave", "js_positional": true },
		{ "name": "nodes_path_check", "acl": "write", "args": ["path_id"], "js": "callNodesPathCheck", "js_positional": true },
		{ "name": "nodes_audit_events_get", "acl": "read", "args": ["path_id", "before", "limit"], "js": "callNodesAuditEventsGet", "js_positional": true },
		{ "name": "nodes_audit_job_get", "acl": "read", "args": ["job_id"], "js": "callNodesAuditJobGet", "js_positional": true },
		{ "name": "nodes_audit_cancel", "acl": "write", "args": ["job_id"], "js": "callNodesAuditCancel", "js_positional": true },
		{ "name": "nodes_set", "acl": "write", "args": ["enabled", "schedule", "countries", "asns", "base", "provider"], "js": "callNodesSet" },
		{ "name": "sync_set", "acl": "write", "args": ["interval"], "js": "callSyncSet" },
		{ "name": "syncd_set", "acl": "write", "args": ["state"], "js": "callSyncdSet" },
		{ "name": "pin_set", "acl": "write", "args": ["state"], "js": "callPinSet" },
		{ "name": "lists_get", "acl": "read", "args": [], "js": "callListsGet" },
		{ "name": "lists_seed", "acl": "write", "args": [], "js": "callListsSeed" },
		{ "name": "yt_get", "acl": "read", "args": [], "js": "callYtGet" },
		{ "name": "yt_mode", "acl": "write", "args": ["mode"], "js": "callYtMode" },
		{ "name": "yt_reset", "acl": "write", "args": [], "js": "callYtReset" },
		{ "name": "torrent_get", "acl": "read", "args": [], "js": "callTorGet" },
		{ "name": "torrent_refresh", "acl": "write", "args": [], "js": "callTorRefresh" },
		{ "name": "torrent_listener", "acl": "write", "args": ["state"], "js": "callTorListener" },
		{ "name": "torrent_extra", "acl": "write", "args": ["hosts"], "js": "callTorExtra" },
		{ "name": "sync_lists", "acl": "write", "args": [], "js": "callLists" },
		{ "name": "aidns", "acl": "write", "args": [], "js": null, "backend": "cmd_aidns_apply" },
		{ "name": "google", "acl": "write", "args": [], "js": "callGoogle" },
		{ "name": "global", "acl": "write", "args": ["mode"], "js": "callGlobal" },
		{ "name": "ipv6", "acl": "write", "args": ["state"], "js": "callIpv6" },
		{ "name": "dev_add", "acl": "write", "args": ["ip", "mode", "mac", "name"], "js": "callDevAdd" },
		{ "name": "dev_del", "acl": "write", "args": ["ip"], "js": "callDevDel" },
		{ "name": "ai_sub_get", "acl": "read", "args": [], "js": "callAiSubGet" },
		{ "name": "ai_sub_set", "acl": "write", "args": ["url"], "js": "callAiSubSet" },
		{ "name": "subs_list", "acl": "read", "args": [], "js": "callSubsList" },
		{ "name": "subs_seed", "acl": "write", "args": [], "js": "callSubsSeed" },
		{ "name": "sub_add", "acl": "write", "args": ["name", "url"], "js": "callSubAdd" },
		{ "name": "sub_del", "acl": "write", "args": ["id"], "js": "callSubDel" },
		{ "name": "ai_sub_use", "acl": "write", "args": ["id"], "js": "callAiSubUse" },
		{ "name": "vpn_sub_use", "acl": "write", "args": ["id"], "js": "callVpnSubUse" },
		{ "name": "vpnnp_sub_use", "acl": "write", "args": ["id"], "js": "callVpnnpSubUse" },
		{ "name": "mod_list", "acl": "read", "args": [], "js": "callModList" },
		{ "name": "mod_check", "acl": "write", "args": [], "js": "callModCheck" },
		{ "name": "mod_update", "acl": "write", "args": ["module_id", "force"], "js": "callModUpdate", "js_positional": true, "backend_body": [
			"  mod_update)   # install one module's files from modules/index.json",
			"    cmd_mod_update \"$2\" \"$3\" ;;"
		] },		{ "name": "diag_list", "acl": "read", "args": [], "js": "callDiagList" },
		{ "name": "diag_run", "acl": "write", "args": ["check"], "js": "callDiagRun", "js_positional": true },
		{ "name": "diag_log", "acl": "read", "args": ["check"], "js": "callDiagLog", "js_positional": true },
		{ "name": "diag_domain", "acl": "write", "args": ["domain", "live"], "js": "callDiagDomain", "js_positional": true },
		{ "name": "upd_check", "acl": "read", "args": ["force"], "js": "callUpdCheck" },
		{ "name": "upd_status", "acl": "read", "args": [], "js": "callUpdStatus" },
		{ "name": "upd_apply", "acl": "write", "args": [], "js": "callUpdApply" },
		{ "name": "nodes_path_preview", "acl": "write", "args": ["path_id", "report_id", "expected_path_revision", "expected_source_revision"], "js": "callNodesPathPreview", "js_positional": true },
		{ "name": "nodes_path_apply", "acl": "write", "args": ["path_id", "preview_id", "expected_path_revision"], "js": "callNodesPathApply", "js_positional": true },
		{ "name": "nodes_path_revoke", "acl": "write", "args": ["path_id"], "js": "callNodesPathRevoke", "js_positional": true },
		{ "name": "nodes_path_apply_status", "acl": "read", "args": ["path_id"], "js": "callNodesPathApplyStatus", "js_positional": true },
		{ "name": "mtrickle_sync", "acl": "write", "args": [], "js": "callMtrickleSync" },
		{ "name": "nodes_audit_schedule_get", "acl": "read", "args": ["path_id"], "js": "callNodesAuditScheduleGet", "js_positional": true },
		{ "name": "nodes_audit_schedule_set", "acl": "write", "args": ["path_id", "enabled", "time", "mode"], "js": "callNodesAuditScheduleSet", "js_positional": true }
	]
}
