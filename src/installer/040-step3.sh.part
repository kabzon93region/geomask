step3_check() {
  _need=0
  if ! have mihomo; then bad "mihomo binary missing"; return 1; fi
  _c="$(P $MIHOMO_CONF)"
  if [ ! -s "$_c" ]; then bad "$MIHOMO_CONF missing (шаг subs при запуске создаст конфиг и спросит обе ссылки)"; return 1; fi
  _np=$(grep -c 'type: http' "$_c" 2>/dev/null || echo 0)
  if [ "$_np" -ge 1 ] 2>/dev/null; then info "proxy-providers: $_np (need >=1: VPN sub; AI borrows its USA nodes)"; else bad "proxy-providers: $_np (need >=1 VPN subscription)"; _need=1; fi
  for g in VPN-noP2P AI; do
    if grep -q "name: $g$" "$_c" 2>/dev/null; then info "slot $g: present"; else bad "slot $g: missing"; _need=1; fi
  done
  grep -qE '^[[:space:]]*- name: VPN$' "$_c" 2>/dev/null \
    && info "default tunnel group VPN: present (main lists ride the P2P-tolerant subscription)" \
    || info "default tunnel group VPN: absent (single tunnel - main lists ride VPN-noP2P)"
  grep -q 'RULE-SET,ai,AI' "$_c" 2>/dev/null && info "rule ai->AI: present" || { bad "rule ai->AI missing"; _need=1; }
  grep -qE 'RULE-SET,mtrickle,(VPN|VPN-noP2P)' "$_c" 2>/dev/null \
    && info "rule mtrickle->$(grep -oE 'RULE-SET,mtrickle,[A-Za-z0-9_-]+' "$_c" | head -1 | cut -d, -f3): present" \
    || { bad "rule mtrickle->VPN missing"; _need=1; }
  grep -q 'ai-devices' "$_c" 2>/dev/null && info "listeners (ai-devices): present" || { bad "listeners (ai-devices:7891) missing"; _need=1; }
  if grep -q 'torrent-direct' "$_c" 2>/dev/null; then
    # v1.23.1: the torrent listener is the P2P egress. It MUST be pinned to the P2P-tolerant
    # lane (VPN/sub2) or to DIRECT - NEVER to AI (AI is now node-relay, the provider that banned
    # the sub for BitTorrent) and never rule-based (then peers leak to node-relay via IP marks).
    # v1.29.0: the panel rewrites the config in flow style (`- name:` at column 0), the
    # installer writes block style - the parse must accept both, it used to demand 4 spaces.
    _tp=$(awk '
      /^[[:space:]]*-[[:space:]]*name:[[:space:]]*torrent-direct[[:space:]]*$/ {f=1; next}
      f && /^[[:space:]]*proxy:/ {sub(/^[[:space:]]*proxy:[[:space:]]*/,""); sub(/[[:space:]]+#.*/,""); print; exit}
      f && /^[[:space:]]*-[[:space:]]*name:/ {exit}
      f && /^[A-Za-z]/ {exit}' "$_c")
    case "$_tp" in
      VPN)    info "listener (torrent-direct:7894 -> VPN, P2P-tolerant): present" ;;
      DIRECT) info "listener (torrent-direct:7894 -> DIRECT): present (off node-relay; add the VPN lane to hide the real IP)" ;;
      AI)     bad "torrent listener pinned to AI = node-relay - P2P would re-ban the subscription"; _need=1 ;;
      '')     bad "torrent listener has no fixed policy - peers can reach node-relay via MagiTrickle IP marks"; _need=1 ;;
      *)      bad "torrent listener policy '$_tp' - expected VPN or DIRECT (never AI)"; _need=1 ;;
    esac
  else warn "torrent-direct listener missing (torrent clients cannot be pinned away from node-relay)"; fi
  grep -qE '^[[:space:]]*- SRC-PORT,41552,(VPN|VPN-noP2P|DIRECT)$' "$_c" 2>/dev/null \
    && info "torrent peer guard (SRC-PORT -> tolerant/DIRECT): present" \
    || warn "SRC-PORT,41552 guard absent or not on VPN-DIRECT - incoming peers may reach node-relay"
  # R01/P1 (v1.23.2): node-relay (VPN-noP2P) MagiTrickle groups must carry NO static IP
  # ranges - a bare-IP torrent peer matching one is fwmarked straight to the P2P-forbidden
  # provider, bypassing mihomo. Domain rules are fine (they route via DNS-learned ipsets).
  _mts="$(P /etc/magitrickle/state/config.yaml)"
  if [ -f "$_mts" ]; then
    _nrs=$(awk '/^  interface:/{r=($0 ~ /VPN-noP2P/)} r&&/^    type: subnet/{c++} END{print c+0}' "$_mts")
    [ "${_nrs:-0}" = "0" ] && info "node-relay groups: no static IP ranges (a torrent peer cannot be fwmarked to the forbidden sub)" \
      || bad "node-relay (VPN-noP2P) has $_nrs static IP range(s) - a torrent peer could match one; remove them (R01)"
  fi
  # v1.29.0: ports may be written as a flow list `[443, 8443, 5228]` or as a block list
  # (`ports:` + `- 5228`); the panel/mihomo rewrite uses the block form. Check the value
  # inside the sniffer section, not one particular spelling of it.
  if awk '/^sniffer:/{f=1; next} f && /^[A-Za-z]/{exit} f' "$_c" 2>/dev/null \
     | grep -qE '(^|[^0-9])5228([^0-9]|$)'; then
    info "sniffer TLS 5228 (Google push): present"
  else
    bad "sniffer TLS 5228 missing (B-017: Google push уходит DIRECT)"; _need=1
  fi
  grep -q '^ipv6: false' "$_c" 2>/dev/null && info "mihomo ipv6: false" || warn "mihomo ipv6: true — на роутере IPv6 отключён, рекомендуется false"
  grep -q 'DOMAIN-SUFFIX,youtube.com)),REJECT' "$_c" 2>/dev/null && info "QUIC reject (видео -> TCP): present" || warn "QUIC reject rules missing (B-016: тротлинг QUIC-видео)"
  grep -qE 'RULE-SET,ytvpn,(VPN|VPN-noP2P)' "$_c" 2>/dev/null && info "ytvpn rule: present" || warn "ytvpn rule missing (IP-blocked googlevideo edges won't route to a tunnel)"
  # v1.14.4: torrents must never be swallowed by the VPN lists (owner policy 30.10)
  # v1.21.7: the owner moved torrent/tracker domains from DIRECT onto the P2P-tolerant VPN
  # lane, so either target is correct now - only a missing ruleset is a problem.
  grep -qE 'RULE-SET,torrentsites,DIRECT' "$_c" 2>/dev/null \
    && info "torrent sites -> DIRECT (Cloudflare rejects the VPN exit)" \
    || warn "torrentsites rule missing - forum sites may return 502 through the VPN lane"
  grep -qE 'RULE-SET,torrentdirect,(DIRECT|VPN|VPN-noP2P)' "$_c" 2>/dev/null \
    && info "torrentdirect rule: present ($(awk -F, '/RULE-SET,torrentdirect/{print $3; exit}' "$_c"))" \
    || warn "torrentdirect rule missing (tracker domains can still go to the wrong subscription)"
  # v1.17.0: lane invariant. A torrent peer is always a bare IP, so no IP rule may reach the
  # subscription that forbids P2P. When the P2P-tolerant "VPN" lane exists the IP ruleset must be
  # split out into mtrickle_bulk.yaml and routed there.
  if grep -q 'name: VPN$' "$_c" 2>/dev/null; then
    if grep -qE '^\s*-\s*IP-CIDR' "$(P /etc/mihomo/ruleset/mtrickle.yaml)" 2>/dev/null; then
      bad "mtrickle.yaml still contains IP-CIDR rules - P2P peers can reach the restricted VPN-noP2P sub"
      _need=1
    else info "lane invariant: mtrickle.yaml has no IP rules"; fi
    grep -q 'RULE-SET,mtrickle_bulk,VPN' "$_c" 2>/dev/null \
      && info "lane: IP ruleset -> VPN (P2P-tolerant)" \
      || { bad "lane: mtrickle_bulk -> VPN rule missing"; _need=1; }
    grep -q 'RULE-SET,ytvpn,VPN' "$_c" 2>/dev/null \
      && info "lane: youtube edge pins -> VPN" \
      || warn "ytvpn pins still go to VPN-noP2P (bulk video traffic on a sub that may dislike it)"
  else
    info "lane: VPN not configured (single tunnel - IP rules stay on VPN-noP2P)"
  fi
  # v1.19.0: a port or protocol match is not a protocol classifier - any client can pick that
  # port, so nothing address-shaped may be routed to the subscription that forbids P2P.
  # Only meaningful when a separate P2P-tolerant lane exists: on a single-tunnel box the one
  # group is both, and port rules have nowhere else to go.
  if grep -qE '^[[:space:]]*- name: VPN-noP2P$' "$_c" 2>/dev/null && grep -qE '^[[:space:]]*- name: VPN$' "$_c" 2>/dev/null; then
    _np_bad=$(awk '/^rules:/{f=1;next} f&&/^[^ ]/{exit} f' "$_c" \
      | grep -E 'VPN-noP2P$' | grep -cE 'SRC-PORT|DST-PORT|IP-CIDR|NETWORK')
    if [ "${_np_bad:-0}" -gt 0 ]; then
      bad "$_np_bad rule(s) send ports/IPs/protocols to VPN-noP2P - a torrent client can just pick that port"
      _need=1
    else info "restricted slot takes domain rules only (no port/IP/protocol matches)"; fi
  fi
  if grep -qE '^[[:space:]]*- DST-PORT,(6969|1337|2710|8081|451|5944),' "$_c" 2>/dev/null; then
    bad "legacy blanket P2P DST-PORT rule present - it sits above the ai ruleset and hijacks AI relays on those ports"
    _need=1
  else
    info "no blanket P2P port rules (trackers pinned by torrentdirect only)"
  fi
  for rf in /etc/mihomo/ruleset/mtrickle.yaml /etc/mihomo/ruleset/ai.yaml /etc/mihomo/ruleset/ytdirect.yaml /etc/mihomo/ruleset/ytvpn.yaml /etc/mihomo/ruleset/torrentdirect.yaml; do
    if [ -s "$(P "$rf")" ]; then info "ruleset: $rf ($(grep -c 'DOMAIN-SUFFIX' "$(P "$rf")" 2>/dev/null || echo '?') suffixes)"; else warn "ruleset empty/missing: $rf (sync step will create)"; fi
  done
  if mihomo -d /etc/mihomo -t >/dev/null 2>&1; then info "mihomo -t: PASS"; else bad "mihomo -t: FAIL"; _need=1; fi
  return $_need
}
step3_apply() {
  _c="$(P $MIHOMO_CONF)"
  # v1.30.15: a foreign config is not "an existing config" - rewriting it loses tun, dns,
  # secret and every custom rule. Taking it over must be an explicit decision.
  if ! _mihomo_guard "$_c" "step3"; then
    info "  Варианты:"
    info "    sh $0 --adopt-config --vpn-url '<ссылка>' --auto   взять конфиг под управление"
    info "    полная замена шаблоном (потеря tun/dns/secret): --replace-config"
    info "    или перенесите подписку/группы вручную и запустите без --adopt-config"
    return 1
  fi
  _vpnu="$GM_VPN_URL"
  if [ -s "$_c" ]; then
    [ -z "$_vpnu" ] && _vpnu=$(_prov_url "$_c" sub)
    [ -z "$_vpnu" ] && _vpnu=$(any_provider_url "$_c")
  fi
  # v1.23.0: AI no longer has its own subscription - it borrows node-relay (sub) and keeps only
  # USA nodes (v1.22.8). Only the VPN subscription URL is required; the old AI sub (de5) is retired.
  if [ -z "$_vpnu" ]; then
    if [ "$GM_AUTO" != 1 ] && [ "$GM_YES" != 1 ] && [ -t 0 ]; then
      info "Подписка не задана — введите ссылку (общая VPN-подписка; AI берёт из неё USA-узлы)"
      _vpnu=$(prompt_url "Ссылка на ОБЩУЮ VPN-подписку" "" "") || { bad "URL VPN-подписки не задан"; return 1; }
    else
      bad "subscription URL unknown - pass --vpn-url (or keep existing config)"
      return 1
    fi
  fi
  info "VPN provider URL: $(_maskurl "$_vpnu")"
  ask "  Write mihomo config (VPN sub + AI USA from it; backup kept)?" || { warn "skipped"; return 1; }
  write_mihomo_config "$_vpnu" "" || return 1
  if [ "$GM_RESTART" = 1 ]; then
    # A failed restart is a failed step: `|| true` reported success while the candidate was
    # rolled back and the VPN never came up with the new config.
    # P10 (audit 18.11.2026): mihomo was started before the ifup hook that (re)installs the
  # VPN default in tables 100/102 existed - the first start of a fresh router could leave the
  # VPN default missing until somebody re-plugged an interface. Install the hook before the
  # restart; step5 still updates it on upgrades, this only covers the first start.
  if ! mod_skipped guard && [ ! -s "$(P /etc/hotplug.d/iface/99-default-vpn-route)" ]; then
    save_stream /etc/hotplug.d/iface/99-default-vpn-route 755 <<'ASSET_EOF'
@@ASSET:99-default-vpn-route@@
ASSET_EOF
  fi
  safe_mihomo_restart || { bad "mihomo restart failed - шаг 3 не завершён"; return 1; }
  elif api_refresh_provider sub "$_vpnu"; then
    info "providers refreshed via API (no restart, VPN stays up)"
  elif svc_alive mihomo; then
    warn "mihomo is running: restart later to apply (rerun with --restart)"
  else
    info "starting mihomo..."
    if initd mihomo start >/dev/null 2>&1; then
      info "mihomo started"
    else
      bad "mihomo не запустился - проверьте: logread | tail -20"
      return 1
    fi
  fi
  return 0
}
step3_verify() { step3_check; }

# write a fresh 2-provider mihomo config: write_mihomo_config <vpn_url> <ai_url>
# validates with `mihomo -t`, keeps backup of the previous config; no restart here.
write_mihomo_config() { # <vpn-url> <ai-url> - public entry: serialised live-config rewrite (R04)
  # rpcd is reloaded in step2 and the panel can already commit through geomask-config-tx.py
  # when step3 calls this: without the SAME kernel lock the installer's mv could land on top
  # of a panel commit (lost update / mixed file) and the transaction CAS would be worthless.
  # Rank config-tx(30) is above the installer's maintenance(10), so the fixed order holds.
  if ! command -v gm_lock_acquire >/dev/null 2>&1; then
    bad "lock helper missing - refusing to rewrite the mihomo config"
    return 1
  fi
  if ! gm_lock_acquire config-tx 30; then
    bad "mihomo config is busy (config transaction lock) - reinstall aborted, nothing changed"
    return 1
  fi
  _wmc_rc=0
  _write_mihomo_config_unlocked "$@" || _wmc_rc=$?
  gm_lock_release config-tx
  return $_wmc_rc
}

