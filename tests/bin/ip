#!/bin/sh
# stub ip: rule show/add -> state/ip_rules; link show -> fake Mihomo; addr show -> LAN IP
case "$*" in
  "rule show") cat "${GM_STATE:-/tmp}/ip_rules" 2>/dev/null; exit 0 ;;
  "rule add "*) printf '%s\n' "$*" >> "${GM_STATE:-/tmp}/ip_rules"; exit 0 ;;
  "rule del "*) exit 0 ;;
  *"addr show"*)
    # the router's LAN address, plus the AI-DNS alias the aidns step adds
    echo "    inet 192.168.0.1/24 brd 192.168.0.255 scope global br-lan"
    echo "    inet 192.168.0.53/24 brd 192.168.0.255 scope global br-lan"
    exit 0 ;;
  *link*show*) echo "3: Mihomo: <POINTOPOINT,UP> mtu 8500"; exit 0 ;;
  *) exit 0 ;;
esac
