#!/bin/sh
# stub ubus:
#   ubus list            -> object names from $GM_STATE/ubus_objects
#   ubus -v list NAME    -> fake method table (>=100 quoted lines for zapret-manager)
OBJ="${GM_STATE:-/tmp}/ubus_objects"
if [ "$1" = "-v" ] && [ "$2" = "list" ]; then
  case "${3:-}" in
    zapret-manager)
      i=0; while [ $i -lt 110 ]; do printf '\t"method%d": {}\n' "$i"; i=$((i+1)); done
      exit 0 ;;
    *) exit 1 ;;
  esac
fi
if [ "$1" = "list" ]; then
  [ -f "$OBJ" ] && cat "$OBJ"
  exit 0
fi
exit 1
