#!/bin/sh
# stub curl: canned responses
#   *generate_204* with -w -> prints 204
#   *9090/proxies*        -> prints JSON with VPN+AI groups
for a in "$@"; do
  case "$a" in
    *9090/proxies*)
      printf '{"proxies":{"AI":{"alive":true},"VPN":{"alive":true},"GLOBAL":{}}}\n'
      exit 0 ;;
    *generate_204*)
      # only emit code if -w was requested
      printf '204'
      exit 0 ;;
  esac
done
exit 0
