PF_REASONS=""
_pf_reason() { # collect one refusal reason (JSON later)
  if [ -n "${PF_REASONS:-}" ]; then
    PF_REASONS="$PF_REASONS
$1"
  else
    PF_REASONS="$1"
  fi
}

_reinstall_obj_type() { # _reinstall_obj_type <install-path> -> regular|symlink|dir|absent|unknown
  _rot="$(P "$1")"
  if [ -L "$_rot" ]; then printf 'symlink'; return 0; fi
  if [ -f "$_rot" ]; then printf 'regular'; return 0; fi
  if [ -d "$_rot" ]; then printf 'dir'; return 0; fi
  if [ -e "$_rot" ]; then printf 'unknown'; return 0; fi    # fifo/socket/device node
  if ls -d "$_rot" >/dev/null 2>&1; then printf 'unknown'; return 0; fi
  printf 'absent'
}

_pf_svc_enabled() { # _pf_svc_enabled <initd-names-slash-separated> -> 0|1|unknown
  if [ ! -d "$(P /etc/rc.d)" ] || ! ls "$(P /etc/rc.d)" >/dev/null 2>&1; then
    printf 'unknown'; return 0
  fi
  for _pfe_name in $(printf '%s' "$1" | tr '/' ' '); do
    if ls "$(P /etc/rc.d)" 2>/dev/null | grep -qE "^[SK][0-9][0-9]${_pfe_name}$"; then
      printf '1'; return 0
    fi
  done
  printf '0'    # no autostart link: a determinate "not enabled", even without init script
}

_pf_svc_running() { # _pf_svc_running <pid-or-port> <mode> -> 0|1|unknown
  case "${2:-pidof}" in
    pgrep)
      have pgrep || { printf 'unknown'; return 0; }
      pgrep -f "$1" >/dev/null 2>&1 && printf '1' || printf '0'
      ;;
    port)
      if have netstat; then
        netstat -ltnu 2>/dev/null | grep -q ":$1 " && printf '1' || printf '0'
      else
        printf 'unknown'
      fi
      ;;
    *)
      if have pidof; then
        pidof "$1" >/dev/null 2>&1 && printf '1' || printf '0'
      elif have pgrep; then
        pgrep -x "$1" >/dev/null 2>&1 && printf '1' || printf '0'
      else
        printf 'unknown'
      fi
      ;;
  esac
}

# Fail-closed preflight of a reinstall: run BEFORE the first mutation (backup_gate writes
# too). The full rollback is only promised when every runtime object of the write-set
# manifest is observable and restorable; anything unknown refuses the run. Output is one
# JSON line on stdout:
#   rc=0  {"ok":true,"armed":"no-package-install"}
#   rc=1  {"ok":false,"error":"reinstall not started: unprovable state","reasons":[...]}
# A refusal here is NOT a "rollback succeeded": nothing has been changed yet.
reinstall_preflight() {
  PF_REASONS=""
  GM_REINSTALL_NO_PKG=1     # arm: from here on pkg_install refuses every package call
  if [ -n "${GM_AUTO_LANE:-}" ]; then
    _pf_reason "GM_AUTO_LANE is armed: geomask-lane.sh would create network/firewall uci sections and service state outside the per-object snapshot; unset GM_AUTO_LANE to reinstall"
  fi
  # 1) dependencies - presence only, NEVER apk/opkg
  for _pf_d in cp mv rm mkdir chmod cmp date find sed awk grep cut tr head tail wc df \
               mktemp tar gzip python3 curl crontab uci ip mihomo; do
    have "$_pf_d" || _pf_reason "dependency missing: $_pf_d (auto-install is forbidden during reinstall; install it manually first)"
  done
  if have python3 && ! python3 -c 'import yaml' >/dev/null 2>&1; then
    _pf_reason "dependency missing: python3-yaml (python3 -c 'import yaml' fails; auto-install is forbidden during reinstall)"
  fi
  # R04: lock primitive is mandatory on the target. Without it every writer (route, console,
  # config transaction, cron) refuses to mutate; the installer must refuse first instead of
  # installing a system whose writers all fail closed. No mkdir fallback exists on purpose.
  if [ "$(uname -s 2>/dev/null)" = Linux ]; then
    have flock || _pf_reason "dependency missing: flock (BusyBox applet; auto-install is forbidden during reinstall - use an image that ships it)"
    if have python3 && ! python3 -c 'import fcntl' >/dev/null 2>&1; then
      _pf_reason "dependency missing: python3 fcntl (the config transaction lock is fail-closed without it)"
    fi
  fi
  _pf_scope_ai=0
  module_selected ai_dns && [ ! -f "$(P /etc/geomask-aidns.off)" ] && _pf_scope_ai=1
  if [ "$_pf_scope_ai" = 1 ]; then
    for _pf_d in nft nslookup; do
      have "$_pf_d" || _pf_reason "dependency missing: $_pf_d (ai_dns module in scope)"
    done
    if ! have https-dns-proxy && [ ! -x "$(P /usr/sbin/https-dns-proxy)" ]; then
      _pf_reason "https-dns-proxy is missing - step 4 would need a package install, which is forbidden during reinstall"
    fi
  fi
  # 2) snapshot observers must be intact (crontab/rc.d/dirs/tmp), or the snapshot cannot
  #    capture - and later prove - the state it promises to restore.
  if ! have pidof && ! have pgrep; then
    _pf_reason "runtime state unobservable: neither pidof nor pgrep is available"
  fi
  crontab -l >/dev/null 2>&1
  _pf_rc=$?
  case "$_pf_rc" in
    0|1) : ;;
    *) _pf_reason "crontab state unobservable (crontab -l rc=$_pf_rc)" ;;
  esac
  if [ ! -d "$(P /etc/rc.d)" ] || ! ls "$(P /etc/rc.d)" >/dev/null 2>&1; then
    _pf_reason "rc.d autostart links unobservable: cannot enumerate /etc/rc.d"
  fi
  for _pf_d in /usr/lib /usr/bin /etc/mihomo; do
    [ -d "$(P "$_pf_d")" ] && ls "$(P "$_pf_d")" >/dev/null 2>&1 \
      || _pf_reason "snapshot observer broken: cannot enumerate $_pf_d"
  done
  for _pf_d in /usr/lib/geomask /etc/mihomo/ruleset; do
    if [ -d "$(P "$_pf_d")" ] && ! ls "$(P "$_pf_d")" >/dev/null 2>&1; then
      _pf_reason "snapshot observer broken: cannot enumerate $_pf_d"
    fi
  done
  _pf_probe=$(mktemp -d "$(P /tmp)/geomask-pf-XXXXXX" 2>/dev/null)
  if [ -n "${_pf_probe:-}" ]; then rm -rf "$_pf_probe"; else
    _pf_reason "snapshot observer broken: cannot create a probe directory in /tmp"
  fi
  # 3) every runtime object of the manifest: observable and classifiable
  while IFS='|' read -r _pf_id _pf_kind _pf_f1 _pf_f2 _pf_f3; do
    [ -n "${_pf_id:-}" ] || continue
    case "$_pf_kind" in
      service)
        case "$_pf_id" in
          svc.ai-doh|svc.dnsmasq-ai) [ "$_pf_scope_ai" = 1 ] || continue ;;
          svc.hev-socks5-tunnel) module_selected path_ai || module_selected ai_dns || continue ;;
          svc.hev-nop2p) [ -n "${GM_AUTO_LANE:-}" ] || continue ;;
          svc.ksmbd) module_selected backup_share || continue ;;
        esac
        _pf_en=$(_pf_svc_enabled "$_pf_f1")
        _pf_run=$(_pf_svc_running "$_pf_f2" "$_pf_f3")
        [ "$_pf_en" = unknown ] && _pf_reason "runtime state unobservable: $_pf_id (enabled unknown)"
        [ "$_pf_run" = unknown ] && _pf_reason "runtime state unobservable: $_pf_id (running unknown)"
        ;;
      crontab) : ;;      # checked above
      links)   : ;;      # checked above
      uci)
        uci -q get "$_pf_f1" >/dev/null 2>&1
        _pf_rc=$?
        [ "$_pf_rc" -le 1 ] || _pf_reason "uci state unobservable: $_pf_f1 (rc=$_pf_rc)"
        ;;
      ip-rule)
        ip rule show >/dev/null 2>&1 || _pf_reason "ip rule state unobservable (ip rule show failed)"
        ;;
      nft-table)
        [ "$_pf_scope_ai" = 1 ] || continue
        nft list table $_pf_f1 >/dev/null 2>&1
        _pf_rc=$?
        [ "$_pf_rc" -le 1 ] || _pf_reason "nft state unobservable: $_pf_f1 (rc=$_pf_rc)"
        ;;
      alias)
        uci -q get "$_pf_f1" >/dev/null 2>&1
        _pf_rc=$?
        [ "$_pf_rc" -le 1 ] || _pf_reason "alias state unobservable: $_pf_f1 (rc=$_pf_rc)"
        ;;
      sysctl)
        [ "${GM_IPV6:-off}" = keep ] && continue
        _pf_sc="$(P "$_pf_f1")"
        if [ ! -d "$_pf_sc" ] || ! ls "$_pf_sc" >/dev/null 2>&1; then
          _pf_reason "kernel sysctl state unobservable: $_pf_f1"
        else
          for _pf_k in all default; do
            [ -r "$_pf_sc/$_pf_k/disable_ipv6" ] \
              || _pf_reason "kernel sysctl state unobservable: $_pf_f1/$_pf_k/disable_ipv6"
          done
        fi
        ;;
      file|file-shared)
        _pf_t=$(_reinstall_obj_type "$_pf_f1")
        case "$_pf_t" in
          unknown)
            _pf_reason "unobservable object: $_pf_f1" ;;
          symlink)
            _pf_reason "unrestorable object: $_pf_f1 is a symlink (the snapshot restores bytes, not links)" ;;
          dir)
            _pf_reason "unrestorable object: $_pf_f1 is a directory, expected $_pf_f2" ;;
          absent)
            [ "$_pf_f2" = regular ] \
              && _pf_reason "unrestorable object: $_pf_f1 is absent but tracked as regular" ;;
        esac
        case "$_pf_kind" in
          file-shared)
            [ -e "$(P "$_pf_f1")" ] && [ ! -r "$(P "$_pf_f1")" ] \
              && _pf_reason "unobservable object: $_pf_f1 is not readable" ;;
        esac
        if [ "$_pf_f3" = seed-risk ]; then
          # The seeder rewrites an EMPTY MagiTrickle config; that write is not covered by a
          # proven rollback, so it must be refused before the transaction starts.
          if [ -f "$(P "$_pf_f1")" ] \
             && ! grep -qE '^[[:space:]]*-[[:space:]]*name:' "$(P "$_pf_f1")" 2>/dev/null; then
            _pf_reason "MagiTrickle state: an empty $_pf_f1 would be rewritten by the seeder - rollback unprovable"
          fi
        fi
        ;;
      dirs)
        : ;;      # checked above
      dir)
        _pf_probe=$(mktemp -d "$(P "$_pf_f1")/geomask-pf-XXXXXX" 2>/dev/null)
        if [ -n "${_pf_probe:-}" ]; then rm -rf "$_pf_probe"; else
          _pf_reason "snapshot observer broken: probe directory in $_pf_f1"
        fi
        ;;
      *)
        _pf_reason "manifest object with unknown kind: $_pf_id ($_pf_kind)" ;;
    esac
  done <<EOF
$REINSTALL_PREFLIGHT_OBJECTS
EOF
  # R03 phase 2a (review G): every byte-snapshot write-set object is classified by type
  # before any mutation. A symlink would be followed by cp -p (the snapshot would capture
  # and later restore the TARGET's bytes), an unreadable file captures nothing - both make
  # the promised rollback unprovable and refuse the run. Absence is fine: the reinstall
  # installs these objects itself (SBA records absent).
  while IFS='|' read -r _pf_bp _pf_be; do
    [ -n "${_pf_bp:-}" ] || continue
    _pf_t=$(_reinstall_obj_type "$_pf_bp")
    case "$_pf_t" in
      symlink)
        if [ "$_pf_be" = dir-or-absent ] && [ -d "$(P "$_pf_bp")" ] \
           && _rs_safe_path "$_pf_bp"; then
          :
        else
          _pf_reason "unrestorable object: $_pf_bp is a symlink (the snapshot stores bytes, not links)"
        fi ;;
      unknown)
        _pf_reason "unobservable object: $_pf_bp" ;;
      dir)
        [ "$_pf_be" = dir-or-absent ] \
          || _pf_reason "unrestorable object: $_pf_bp is a directory, expected $_pf_be" ;;
      regular)
        if [ "$_pf_be" = dir-or-absent ]; then
          _pf_reason "unrestorable object: $_pf_bp is a regular file, expected $_pf_be"
        elif [ ! -r "$(P "$_pf_bp")" ]; then
          _pf_reason "unobservable object: $_pf_bp is not readable (the snapshot would capture nothing)"
        fi ;;
    esac
  done <<EOF
${REINSTALL_PREFLIGHT_BYTE_FILES:-}
EOF
  if [ -n "${PF_REASONS:-}" ]; then
    _pf_json=''
    _pf_first=1
    while IFS= read -r _pf_line; do
      [ -n "$_pf_line" ] || continue
      _pf_esc=$(printf '%s' "$_pf_line" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')
      if [ "$_pf_first" = 1 ]; then _pf_first=0; else _pf_json="$_pf_json,"; fi
      _pf_json="$_pf_json\"$_pf_esc\""
    done <<EOF
$PF_REASONS
EOF
    printf '{"ok":false,"error":"reinstall not started: unprovable state","reasons":[%s]}\n' "$_pf_json"
    return 1
  fi
  printf '{"ok":true,"armed":"no-package-install"}\n'
  return 0
}

# full flow: uninstall -> install geo -> rewrite mihomo 2-subs -> sync+cron -> services -> verify
menu_reinstall() {
  hdr "REINSTALL" "Удалить -> установить -> настроить geomask"
  warn "Удалены и переустановлены: гео-оверлей LuCI, sync-скрипт, cron."
  warn "Mihomo конфиг: существующий 2-подписочный сохраняется (патчатся только ссылки подписок);"
  warn "без конфига/маркеров подписок — запись шаблоном (старый — в бэкапе)."
  warn "Mihomo НЕ перезапускается: подписки применяются через API без обрыва VPN."
  _c="$(P $MIHOMO_CONF)"
  _curv=""
  if [ -s "$_c" ]; then _curv=$(_prov_url "$_c" sub); fi
  # Every refusal is decided BEFORE the first removal: a foreign config, no room for the
  # snapshot, no way to reach the LAN. Nothing has been touched at this point.
  if [ -s "$_c" ] && ! geomask_config_shaped "$_c" && [ "${GM_ADOPT:-0}" != 1 ] \
     && [ "${GM_REPLACE:-0}" != 1 ]; then
    bad "на роутере свой конфиг mihomo - переустановка его не перезапишет"
    info "  Точечное управление: --adopt-config; полная замена с потерей настроек: --replace-config"
    return 1
  fi
  _free=$(df -k "$(P /tmp)" 2>/dev/null | awk 'NR==2{print $4}')
  case "$_free" in
    ''|*[!0-9]*) ;;
    *) [ "$_free" -lt 5120 ] && { bad "мало места в /tmp (${_free} КБ) - переустановка отменена"; return 1; } ;;
  esac
  ask "Продолжить переустановку?" || { warn "отменено"; return 1; }
  # Ownership of the mihomo config is decided by the YAML parser: without it a geomask
  # config looks foreign and the flow would uninstall everything and then refuse. Check
  # BEFORE the first removal, not at step 3, and only when there is a config to judge.
  if [ -s "$(P $MIHOMO_CONF)" ] && ! _py_yaml_ok; then
    bad "python3 и/или python3-yaml недоступны - владение конфигом mihomo не определить"
    info "  Установите пакеты и повторите: apk add python3 python3-yaml (или opkg install ...)"
    return 1
  fi
  # R03: fail-closed preflight BEFORE the first mutation (backup_gate writes files too).
  # The module selection decides which runtime objects are in scope, so it is settled
  # first; then the manifest-based preflight proves dependencies - without apk/opkg -
  # observability of every runtime object and the snapshot observers. Anything unknown
  # refuses the reinstall with the JSON error, nothing having been touched.
  modules_maybe_prompt
  if ! reinstall_preflight; then
    bad "переустановка не запущена: недоказуемое состояние (см. JSON выше)"
    info "  Ничего не изменено. Установите недостающие зависимости вручную и повторите."
    return 1
  fi
  # R04: single instance. The preflight above is read-only; from here on the run mutates
  # save_stream targets, uci, services and crontab, so two reinstallers must not interleave.
  # The kernel lock is a try-lock: the second run refuses immediately and nothing is
  # unlocked on the way out (the kernel releases a killed run).
  if ! gm_lock_acquire maintenance 0; then
    bad "переустановка уже выполняется: второй экземпляр не запущен (блокировка maintenance)"
    info "  Дождитесь завершения текущей переустановки или перезагрузки; ничего не изменено."
    return 1
  fi
  backup_gate || { gm_lock_release maintenance; return 1; }
  # R05: catch up on ifup events queued before the reinstall, inline under `maintenance`.
  drain_route_queue || warn "route queue not fully applied before reinstall - see error-100"
  _vpn=$(prompt_url "Ссылка на ОБЩУЮ VPN-подписку (AI берёт из неё USA-узлы)" "$_curv" "$GM_VPN_URL") || { bad "URL подписки не задан"; gm_lock_release maintenance; return 1; }
  # A snapshot from an earlier failed attempt may still hold the only copy of the old
  # components: never delete a fixed name here (same rule as the backup park, F03).
  _snap=$(mktemp -d "$(P /tmp)/geomask-reinstall-XXXXXX" 2>/dev/null) \
    || { bad "не удалось создать каталог снимка в /tmp"; gm_lock_release maintenance; return 1; }
  _reinstall_snapshot "$_snap" || { bad "не удалось сохранить текущие компоненты - переустановка отменена"; rm -rf "$_snap"; gm_lock_release maintenance; return 1; }
  if ! _reinstall_steps "$_vpn"; then
    bad "переустановка не завершена - возвращаю прежние компоненты"
    if ! _reinstall_restore "$_snap"; then
      bad "rollback incomplete / recovery required: снимок сохранён в $_snap (не удаляйте его)"
    else
      info "откат проверен: прежние компоненты и runtime восстановлены"
    fi
    gm_lock_release maintenance
    return 1
  fi
  # R05: the reinstall may have been preceded by ifup events that queued while the old helper
  # was still in place; apply them with the new helper while `maintenance` is still held.
  drain_route_queue || warn "route queue not fully applied after reinstall - see error-100"
  rm -rf "$_snap"
  gm_lock_release maintenance
  log "Пересстановка geomask завершена."
  return 0
}

menu_loop() {
  while :; do
    clr
    print_banner
    echo
    dashboard
    show_menu
    printf '\n%sВыберите пункт:%s ' "$C_Y" "$NC"
    read -r _c || exit 0
    case "$_c" in
      1) diag_quick; PAUSE ;;
      2) menu_master || true; PAUSE ;;
      3) hdr "PANEL" "Панель Гео: переустановка/обновление"
         warn "Обновляет файлы панели (backend/rpcd/acl/страница); mihomo не трогается."
         run_step 2 || true; PAUSE ;;
      f|F) menu_reinstall || true; PAUSE ;;
      0|q|Q|"") exit 0 ;;
      *) printf '%sнеизвестный пункт%s\n' "$C_R" "$NC"; sleep 1 ;;
    esac
  done
}

usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; }

# ---- args ----
while [ $# -gt 0 ]; do
  case "$1" in
    --auto) GM_AUTO=1 ;;
    --check) GM_CHECK_ONLY=1 ;;
    --yes|-y) GM_YES=1 ;;
    --restart) GM_RESTART=1 ;;
    --backup) GM_BACKUP=1 ;;
    --reinstall) GM_REINSTALL=1 ;;
    --adopt-config) GM_ADOPT=1 ;;
    --replace-config) GM_REPLACE=1 ;;
    --step) shift; GM_STEP="${1:-}" ;;
    --vpn-url) shift; GM_VPN_URL="${1:-}" ;;
    --ai-url) shift; GM_AI_URL="${1:-}" ;;
    --modules) shift; GM_MODULES=$(printf '%s' "${1:-}" | tr ',' ' ') ;;
    --modules=*) GM_MODULES=$(printf '%s' "${1#--modules=}" | tr ',' ' ') ;;
    --list-modules)
      for _m in $GM_ALL_MODULES; do
        if module_required "$_m"; then _tag="[обязательный]"; else _tag="[по выбору]   "; fi
        printf "  %-18s %s %s\n" "$_m" "$_tag" "$(module_label "$_m")"
      done
      exit 0 ;;
    --seed-lists) GM_SEED_LISTS=1 ;;
    --ipv6) shift; GM_IPV6="${1:-off}" ;;
    --ipv6=*) GM_IPV6="${1#--ipv6=}" ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'unknown option: %s (see --help)\n' "$1"; exit 2 ;;
  esac
  shift
done

# validate --modules: a typo would otherwise install nothing and report success.
# A function, not an inline block: the regression test used to re-implement this logic and
# could pass while the installer itself was broken.
normalize_modules() { # normalize_modules <selection> -> validated selection with required modules
  _sel="$1"
  _valid=""
  for _m in $_sel; do
    case " $GM_ALL_MODULES " in
      *" $_m "*) _valid="$_valid $_m" ;;
      *) printf 'unknown module: %s (see --list-modules)\n' "$_m" >&2; return 2 ;;
    esac
  done
  _sel=$(printf '%s' "$_valid" | sed 's/^ *//;s/  */ /g')
  # core and path_vpn are not optional: the interactive picker adds them, the CLI used to
  # accept a set without them and install a product that cannot route anything.
  for _m in $GM_REQUIRED_MODULES; do
    case " $_sel " in *" $_m "*) ;; *) _sel="$_sel $_m" ;; esac
  done
  printf '%s' "$_sel" | sed 's/^ *//;s/  */ /g'
}

if [ -n "$GM_MODULES" ]; then
  GM_MODULES=$(normalize_modules "$GM_MODULES") || exit 2
fi

case "$GM_IPV6" in
  off|keep) ;;
  *) printf 'unknown --ipv6 value: %s (off|keep)\n' "$GM_IPV6" >&2; exit 2 ;;
esac

# hard pin: router owner may forbid restarts permanently via flag file
if [ "$GM_RESTART" = 1 ] && [ -f "$(P /root/.geomask-norestart)" ]; then
  log "NOTE: /root/.geomask-norestart present - ignoring --restart (owner forbids VPN interruption)."
  GM_RESTART=0
fi

RC=0
# The self-update runner holds the `updater` lock and passes its descriptor to this installer.
# Close it here: the runner still holds that lock, and no service we start below may inherit
# the descriptor and keep the updater lock alive after the update has finished.
if command -v gm_lock_close_inherited >/dev/null 2>&1; then gm_lock_close_inherited; fi
if [ "$GM_BACKUP" = 1 ]; then
  _b=$(ensure_backup full) && { info "полный бэкап: $_b"; info "SMB (свежая копия): \\\\$(lan_ip)\\geomask-backups ; история на ПК: geomask\\fetch_backup.ps1"; RC=0; } || { bad "полный бэкап не создан"; RC=1; }
elif [ "$GM_REINSTALL" = 1 ]; then
  menu_reinstall || RC=1
elif [ "$GM_SEED_LISTS" = 1 ]; then
  if backup_gate; then write_lists_assets && seed_lists force || RC=1; else RC=1; fi
elif [ -n "$GM_STEP" ]; then
  run_step "$GM_STEP" || RC=1
elif [ "$GM_AUTO" = 1 ] || [ "$GM_CHECK_ONLY" = 1 ]; then
  log "geomask v$GM_VERSION  mode: $([ "$GM_CHECK_ONLY" = 1 ] && echo check || echo auto)"
  if [ "$GM_CHECK_ONLY" != 1 ] && ! preflight; then
    bad "preflight не пройден - ничего не изменено"
    log ""
    log "== SUMMARY: pass=$PASS fail=$FAILCNT skipped_steps=$SKIP =="
    exit 1
  fi
  for n in 1 2 3 4 5 6 7; do
    if [ "$GM_CHECK_ONLY" = 1 ]; then
      run_step "$n" || true
    else
      run_step "$n" || { [ $? -eq 1 ] && { RC=1; bad "aborting on step $n failure"; break; }; }
    fi
  done
else
  menu_loop
fi

log ""
log "${C_DIM}== SUMMARY: pass=$PASS fail=$FAILCNT skipped_steps=$SKIP ==$NC"
[ "$FAILCNT" -eq 0 ] || RC=1
exit $RC
