#!/bin/sh
# stub wget: success for installer download (writes dummy file big enough)
out=""
url=""
prev=""
for a in "$@"; do
  [ "$prev" = "-O" ] && out="$a"
  case "$a" in http*|https*) url="$a" ;; esac
  prev="$a"
done
if [ -n "$out" ]; then
  # 100KB dummy so size check passes
  i=0; : > "$out"
  while [ $i -lt 100 ]; do dd if=/dev/zero bs=1024 count=1 2>/dev/null >> "$out"; i=$((i+1)); done
  exit 0
fi
exit 0
