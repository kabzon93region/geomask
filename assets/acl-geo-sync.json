{
	"luci-app-geo-sync": {
		"description": "Grant access to geo masking + AI routing panel",
		"read": {
			"ubus": {
				"geo-sync": [ "status", "leases", "log", "backups", "stack", "ai_sub_get", "subs_list", "upd_check", "upd_status" ],
				"system": [ "info" ]
			}
		},
		"write": {
			"ubus": {
				"geo-sync": [ "sync_lists", "aidns", "google", "global", "ipv6", "dev_add", "dev_del", "ai_sub_set", "sub_add", "sub_del", "ai_sub_use", "vpn_sub_use", "subs_seed", "upd_apply" ]
			}
		}
	}
}
