pkg_install() { # pkg_install <pkg>... -> 0 only when the package manager reports success
  if [ "${GM_REINSTALL_NO_PKG:-0}" = 1 ]; then
    warn "переустановка: автоустановка пакетов запрещена ($*) - зависимость должна быть установлена заранее"
    return 1
  fi
  if have apk; then
    info "installing: $* (apk)"
    apk update >/dev/null 2>&1 || warn "apk update failed - trying the current index"
    apk add "$@" >/dev/null 2>&1
  elif have opkg; then
    info "installing: $* (opkg)"
    opkg update >/dev/null 2>&1 || warn "opkg update failed - trying the current index"
    opkg install "$@" >/dev/null 2>&1
  else
    return 1
  fi
}

# The runtime objects of the reinstall write-set (tests/reinstall_write_set.json).
# Format: id|kind|f1|f2|f3 where kind decides the fields:
#   service  -> initd-name(s, '/'-separated) | pid-or-port | mode (pidof|pgrep|port)
#   crontab|links -> - | - | -
#   uci      -> probe key (uci -q get) | - | -
#   ip-rule  -> - | - | -
#   nft-table-> table spec | - | -
#   alias    -> uci key of the alias address | - | -
#   sysctl   -> /proc/sys/net/ipv6/conf | - | -
#   file|file-shared -> install path | expected (regular|regular-or-absent) | extra (seed-risk|-)
#   dirs     -> - | - | -      dir -> probe dir | - | -
# Tri-state enabled/running per service: enabled from /etc/rc.d links, running from
# pidof/pgrep/netstat. Any `unknown` is an ERROR, not a maybe.
REINSTALL_PREFLIGHT_OBJECTS="svc.dnsmasq|service|dnsmasq|dnsmasq|pidof
svc.mihomo|service|mihomo|mihomo|pidof
svc.magitrickle|service|magitrickle|magitrickled|pidof
svc.hev-socks5-tunnel|service|hev-socks5-tunnel|hev-socks5-tunnel|pidof
svc.hev-nop2p|service|hev-nop2p|hev-socks5-tunnel|pidof
svc.rpcd|service|rpcd|rpcd|pidof
svc.ai-doh|service|ai-doh|5055|port
svc.dnsmasq-ai|service|dnsmasq-ai|5353|port
svc.geomask-syncd|service|geomask-syncd|geomask-syncd.sh|pgrep
svc.network|service|network|netifd|pidof
svc.firewall|service|firewall|fw4|pidof
svc.ksmbd|service|ksmbd/ksmbd1|ksmbd|pidof
cron.user|crontab|-|-|-
rc.d|links|-|-|-
uci.network|uci|network.lan|-|-
uci.dhcp|uci|dhcp.lan|-|-
uci.ksmbd|uci|ksmbd|-|-
net.fwmark-rule|ip-rule|-|-|-
net.nft-ai-dns|nft-table|inet geomask_ai_dns|-|-
net.alias-lanai|alias|network.lanai.ipaddr|-|-
sysctl.kernel|sysctl|/proc/sys/net/ipv6/conf|-|-
file.passwd|file-shared|/etc/passwd|regular|-
file.group|file-shared|/etc/group|regular|-
shared.magitrickle-config|file-shared|/etc/magitrickle/state/config.yaml|regular-or-absent|seed-risk
shared.zapret-exclude|file-shared|/opt/zapret/ipset/zapret-hosts-user-exclude.txt|regular-or-absent|-
shared.zapret-force|file-shared|/opt/zapret/ipset/zapret-hosts-user.txt|regular-or-absent|-
file.mihomo-config|file|/etc/mihomo/config.yaml|regular-or-absent|-
dir.tracked|dirs|-|-|-
dir.node-audit-state|dir|/etc/geomask/node-audit/state|-|-
tmp.scratch|dir|/tmp|-|-"

# R03 phase 2a (review G): every write-set object whose snapshot stores BYTES
# (manifest snapshot SB/SBA/SAP - tests/reinstall_write_set.json). The preflight
# classifies each object's type before any mutation: a symlink would be followed by
# cp -p (it would capture and later restore the target's bytes), an unreadable file
# captures nothing - both are refusals. Format: install-path|expected with
# regular-or-absent or dir-or-absent. This table is cross-checked against the manifest
# by tests/reinstall_manifest.py (check_byte_table). Documented boundary (manifest
# meta.preflight_boundary): dynamic temp classes, snapshot=NONE transients and runtime
# effects without a file representation are not type-classified here.
REINSTALL_PREFLIGHT_BYTE_FILES="/usr/lib/geomask/geomask-node-audit.py|regular-or-absent
/usr/lib/geomask/geomask-audit-state.py|regular-or-absent
/usr/lib/geomask/geomask-config-tx.py|regular-or-absent
