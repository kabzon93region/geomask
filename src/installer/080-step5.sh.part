step5_apply() {
  _save5_before=${SAVE_FAIL:-0}
  save_stream /root/sync_mtrickle_mihomo.sh 755 <<'ASSET_EOF'
@@ASSET:sync_mtrickle_mihomo.sh@@
ASSET_EOF
  save_stream /etc/mihomo/ruleset/ytdirect.yaml 644 <<'ASSET_EOF'
@@ASSET:ytdirect.yaml@@
ASSET_EOF
  # v1.29.0: the core mihomo config always references these rulesets, so a deselected
  # module must still leave a valid (empty) file behind - otherwise `mihomo -t` fails.
  ruleset_stub youtube /etc/mihomo/ruleset/ytdirect.yaml
  # v1.13.3: googlevideo -> VPN. Source of truth is the MagiTrickle group "GoogleVideo VPN";
  # sync regenerates ytvpn.yaml from it. Seed the file only if missing so mihomo -t passes before
  # first sync; never clobber an existing one here.
  if [ ! -s "$(P /etc/mihomo/ruleset/ytvpn.yaml)" ]; then
    save_stream /etc/mihomo/ruleset/ytvpn.yaml 644 <<'ASSET_EOF'
@@ASSET:ytvpn.yaml@@
ASSET_EOF
  else
    info "ytvpn list: keeping existing /etc/mihomo/ruleset/ytvpn.yaml (sync-managed)"
  fi
  ruleset_stub youtube /etc/mihomo/ruleset/ytvpn.yaml
  # v1.17.0: lane split - IP rules must never reach the restricted VPN subscription.
  # mtrickle_bulk.yaml is sync-generated; seed it empty so mihomo -t passes before the first sync.
  if [ ! -s "$(P /etc/mihomo/ruleset/mtrickle_bulk.yaml)" ]; then
    printf '%s\n%s\n' '# AUTO-GENERATED by /root/sync_mtrickle_mihomo.sh from magitrickle config - DO NOT EDIT' 'payload: []' > "$(P /etc/mihomo/ruleset/mtrickle_bulk.yaml)"
    info "mtrickle_bulk list: created empty (sync will fill it)"
  else
    info "mtrickle_bulk list: keeping existing /etc/mihomo/ruleset/mtrickle_bulk.yaml"
  fi
  # v1.15.0: torrent tracker allow-list -> DIRECT (static asset, generated by geomask-torrent.sh)
  if [ ! -s "$(P /etc/mihomo/ruleset/torrentdirect.yaml)" ]; then
    save_stream /etc/mihomo/ruleset/torrentdirect.yaml 644 <<'ASSET_EOF'
@@ASSET:torrentdirect.yaml@@
ASSET_EOF
  else
    info "torrentdirect list: keeping existing /etc/mihomo/ruleset/torrentdirect.yaml"
  fi
  ruleset_stub torrent /etc/mihomo/ruleset/torrentdirect.yaml
  # v1.20.4: zapret force-list exceptions (direction B). Owner-edited; never overwritten.
  if [ -s "$(P /etc/geomask/zapret-force-keep.txt)" ]; then
    info "zapret force-keep: keeping existing /etc/geomask/zapret-force-keep.txt"
  else
    mkdir -p "$(P /etc/geomask)" 2>/dev/null
    save_stream /etc/geomask/zapret-force-keep.txt 644 <<'ASSET_EOF'
@@ASSET:zapret-force-keep.txt@@
ASSET_EOF
  fi
  # v1.25.0: domains that must bypass zapret DPI even though they go DIRECT (Yandex).
  if [ -s "$(P /etc/geomask/zapret-always-exclude.txt)" ]; then
    info "zapret always-exclude: keeping existing /etc/geomask/zapret-always-exclude.txt"
  else
    mkdir -p "$(P /etc/geomask)" 2>/dev/null
    save_stream /etc/geomask/zapret-always-exclude.txt 644 <<'ASSET_EOF'
@@ASSET:zapret-always-exclude.txt@@
ASSET_EOF
  fi
  # v1.17.0: torrent admin - rebuild the tracker ruleset / toggle the DIRECT listener from the panel
  if module_selected torrent; then mkdir -p "$(P /etc/geomask/torrent)" 2>/dev/null; fi
  save_stream /usr/bin/geomask-torrent.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-torrent.sh@@
ASSET_EOF
  # v1.21.4: keep an existing lane across reinstalls - it carries an interface the owner may have
  # assigned MagiTrickle lists to, and losing it silently reroutes those lists.
  if [ -e "$(P /sys/class/net/VPN-noP2P)" ] && [ -x "$(P /usr/bin/geomask-lane.sh)" ]; then
    info "lane VPN-noP2P: already present, left untouched"
  elif [ -x "$(P /usr/bin/geomask-lane.sh)" ] && [ -n "${GM_AUTO_LANE:-}" ]; then
    "$(P /usr/bin/geomask-lane.sh)" install >/dev/null 2>&1 || warn "lane install failed"
  fi
  # v1.22.1: DNS safety audit - read-only, explains "site address not found" before it happens
  save_stream /usr/bin/geomask-dnscheck.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-dnscheck.sh@@
ASSET_EOF
  # v1.21.0: extra tunnel lane - gives MagiTrickle's interface dropdown a real netdev that
  # always exits through the restricted subscription, so a list can be pointed at it directly.
  save_stream /usr/bin/geomask-lane.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-lane.sh@@
ASSET_EOF
  # v1.20.6: morning check - read-only audit the owner runs after the restricted
  # subscription comes back, before enabling the torrent client again.
  save_stream /usr/bin/geomask-morning-check.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-morning-check.sh@@
ASSET_EOF
  # v1.18.0: VPN lane audit - record what tries to use the P2P-restricted subscription while it
  # is offline, so the operator can see the future load before switching it back on.
  if [ ! -s "$(P /etc/geomask/vpnwatch.conf)" ]; then
    save_stream /etc/geomask/vpnwatch.conf 644 <<'ASSET_EOF'
@@ASSET:geomask-vpnwatch.conf@@
ASSET_EOF
  else
    info "vpnwatch conf: keeping existing /etc/geomask/vpnwatch.conf"
  fi
  save_stream /usr/bin/geomask-vpnwatch.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-vpnwatch.sh@@
ASSET_EOF
  cron_ensure diagnostic '# geomask-vpnwatch$' '* * * * * /usr/bin/geomask-vpnwatch.sh --tick >/dev/null 2>&1 # geomask-vpnwatch'
  save_stream /etc/hotplug.d/iface/99-default-vpn-route 755 <<'ASSET_EOF'
@@ASSET:99-default-vpn-route@@
ASSET_EOF
  # pristine copy: the backend restores it if the live script ever goes missing, and it is
  # the only place that knows this router's LAN device and TUN name
  save_stream /usr/lib/geomask/99-default-vpn-route.dist 755 <<'ASSET_EOF'
@@ASSET:99-default-vpn-route@@
ASSET_EOF
  save_stream /usr/bin/geomask-guard.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-guard.sh@@
ASSET_EOF
  save_stream /etc/hotplug.d/iface/99-geomask-guard 755 <<'ASSET_EOF'
@@ASSET:99-geomask-guard@@
ASSET_EOF
  cron_ensure guard '# geomask-guard$' '*/5 * * * * /usr/bin/geomask-guard.sh >/dev/null 2>&1 # geomask-guard'
  if crontab -l 2>/dev/null | grep -q 'sync_mtrickle_mihomo'; then
    info "cron already present"
  else
    if _cron_begin; then
      ( crontab -l 2>/dev/null; echo '*/5 * * * * /root/sync_mtrickle_mihomo.sh' ) | crontab - 2>/dev/null && info "cron added: */5 sync" || warn "cannot set crontab"
      _cron_end
    else
      warn "cron: lock unavailable - the */5 sync line was not added"
    fi
  fi
  # v1.11.0: nightly node audit (registry check of every subscription server)
  save_stream /usr/bin/geomask-node-scan.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-node-scan.sh@@
ASSET_EOF
  if [ ! -s "$(P /etc/geomask-nodes.conf)" ]; then
    save_stream /etc/geomask-nodes.conf 644 <<'ASSET_EOF'
@@ASSET:geomask-nodes.conf@@
ASSET_EOF
  else
    info "nodes conf: keeping existing /etc/geomask-nodes.conf"
  fi
  # v1.28.0: the night audit is now owned by the per-path scheduler.
  # The legacy 03:30 nodescan cron keeps running for paths that were never configured,
  # so a reinstall cannot silently stop auditing a router the owner never migrated.
  # Migration only seeds check-only schedules; it never enables auto-apply.
  _migrate_nodescan_cron() {
    if crontab -l 2>/dev/null | grep -q 'geomask-node-scan.*geomask-nodescan'; then
      _old_time=$(crontab -l 2>/dev/null | grep 'geomask-node-scan.*geomask-nodescan' \
                  | awk '{printf "%02d:%02d", $2, $1}' | head -1)
      [ -n "$_old_time" ] || _old_time="03:30"
      if [ -f "$(P /usr/lib/geomask/geomask-node-audit.py)" ]; then
        _seeded=$(python3 - "$_old_time" <<'PYEOF' 2>/dev/null || echo 0
import sys
sys.path.insert(0, '/usr/lib/geomask')
import importlib.util
spec = importlib.util.spec_from_file_location(
    'node_audit', '/usr/lib/geomask/geomask-node-audit.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
when = sys.argv[1]
seeded = 0
for ident in ('vpn', 'vpn_nop2p', 'ai'):
    current = mod.schedule_get(ident).get('schedule') or {}
    if current.get('enabled'):
        continue          # the owner already chose a schedule: never overwrite it
    mod.schedule_set(ident, 'true', when, 'check-only')
    seeded += 1
print(seeded)
PYEOF
)
        info "legacy nodescan cron found (${_old_time}); seeded check-only schedules for ${_seeded:-0} unconfigured path(s)"
      else
        warn "node-audit module missing: leaving the legacy nodescan cron untouched"
      fi
    else
      info "legacy nodescan cron: none"
    fi
  }
  _migrate_nodescan_cron
  # Install the legacy cron only if it is absent AND no path has a schedule, so a router
  # that the owner migrated is not audited twice every night.
  if crontab -l 2>/dev/null | grep -q 'geomask-node-scan'; then
    info "nodescan cron already present"
  elif [ "$(nodescan_schedule_active)" = "1" ]; then
    info "per-path scheduler is active: not adding the legacy nodescan cron"
  else
    if _cron_begin; then
      ( crontab -l 2>/dev/null; echo '30 3 * * * /usr/bin/geomask-node-scan.sh >/dev/null 2>&1 # geomask-nodescan' ) | crontab - 2>/dev/null && info "cron added: 03:30 nodescan" || warn "cannot set crontab"
      _cron_end
    else
      warn "cron: lock unavailable - the legacy nodescan line was not added"
    fi
  fi
  # v1.14.0: YouTube edge watchdog - failing *.googlevideo.com edges get pinned to VPN,
  # released back to zapret nightly. Source of truth stays in MagiTrickle (group feeds ytvpn.yaml).
  save_stream /usr/bin/geomask-ytwatch.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-ytwatch.sh@@
ASSET_EOF
  if [ ! -s "$(P /etc/geomask-ytwatch.conf)" ]; then
    save_stream /etc/geomask-ytwatch.conf 644 <<'ASSET_EOF'
@@ASSET:geomask-ytwatch.conf@@
ASSET_EOF
  else
    # Keeping the operator's file must not mean "never learn new options": every key that the
    # shipped default introduces is appended if absent. Existing values are never touched -
    # that is how blanket_permanent failed to reach a live router and had to be added by hand.
    save_stream /tmp/geomask-ytwatch.conf.new 644 <<'ASSET_EOF'
@@ASSET:geomask-ytwatch.conf@@
ASSET_EOF
    _added=$(python3 - "$(P /etc/geomask-ytwatch.conf)" /tmp/geomask-ytwatch.conf.new <<'PYEOF'
import sys
live_p, new_p = sys.argv[1], sys.argv[2]
live=open(live_p,encoding='utf-8',errors='replace').read()
have={l.split('=',1)[0].strip() for l in live.splitlines() if '=' in l and not l.strip().startswith('#')}
add=[l for l in open(new_p,encoding='utf-8',errors='replace').read().splitlines()
     if '=' in l and not l.strip().startswith('#') and l.split('=',1)[0].strip() not in have]
if add:
    open(live_p,'a',encoding='utf-8',newline='\n').write('\n# added by geomask upgrade\n'+'\n'.join(add)+'\n')
print(len(add))
PYEOF
) || _added=0
    rm -f /tmp/geomask-ytwatch.conf.new
    if [ "${_added:-0}" != "0" ]; then
      info "ytwatch conf: kept existing settings, added $_added new option(s)"
    else
      info "ytwatch conf: keeping existing /etc/geomask-ytwatch.conf"
    fi
  fi
  # v1.20.4: the scan runs every minute (was */5). An old entry is rewritten in place;
  # v1.29.0: the migration only runs for a selected module, and cron_ensure owns creation.
  if module_selected youtube \
     && crontab -l 2>/dev/null | grep -qE '^\*/5 \* \* \* \* /usr/bin/geomask-ytwatch\.sh.*# geomask-ytwatch$'; then
    if _cron_begin; then
      ( crontab -l 2>/dev/null | sed 's|^\*/5 \* \* \* \* /usr/bin/geomask-ytwatch.sh|*/1 * * * * /usr/bin/geomask-ytwatch.sh|' ) | crontab - 2>/dev/null \
        && info "ytwatch cron migrated */5 -> */1" || warn "cannot migrate the ytwatch cron"
      _cron_end
    else
      warn "cron: lock unavailable - the ytwatch migration was not attempted"
    fi
  fi
  cron_ensure youtube '# geomask-ytwatch$' '*/1 * * * * /usr/bin/geomask-ytwatch.sh >/dev/null 2>&1 # geomask-ytwatch'
  cron_ensure youtube '# geomask-ytwatch-reset$' '20 4 * * * /usr/bin/geomask-ytwatch.sh --reset >/dev/null 2>&1 # geomask-ytwatch-reset'
  # v1.29.1: diagnostics logs keep 7 days (each run prunes its own file; this catches idle ones)
  cron_ensure doctor '# geomask-doctor-prune$' '40 4 * * * /usr/lib/geomask/geomask-doctor.py prune >/dev/null 2>&1 # geomask-doctor-prune'
  # v1.10.0: event sync watchdog - magitrickle save -> sync within ~seconds (cron stays as backup)
  # R03: during a reinstall package installs are forbidden (GM_REINSTALL_NO_PKG) - the
  # watchdog falls back to its 10s mtime poll without inotifywait.
  if have apk && [ "${GM_REINSTALL_NO_PKG:-0}" != 1 ]; then apk add inotifywait >/dev/null 2>&1 || true; fi
  save_stream /usr/bin/geomask-syncd.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-syncd.sh@@
ASSET_EOF
  save_stream /etc/init.d/geomask-syncd 755 <<'ASSET_EOF'
@@ASSET:geomask-syncd.init@@
ASSET_EOF
  initd geomask-syncd enable >/dev/null 2>&1 || true
  if pgrep -f geomask-syncd.sh >/dev/null 2>&1; then
    info "syncd: already running"
  else
    initd geomask-syncd restart >/dev/null 2>&1 || true
    sleep 1
    pgrep -f geomask-syncd.sh >/dev/null 2>&1 && info "syncd: started" || warn "syncd: cannot start (check logread)"
  fi
  if ! svc_alive magitrickled; then
    info "starting magitrickle..."
    initd magitrickle start >/dev/null 2>&1 || true
  fi
  if [ "$GM_RESTART" = 1 ]; then
    info "running sync once (--restart)..."
    sh "$(P /root/sync_mtrickle_mihomo.sh)" 2>&1 | sed 's/^/  | /' || true
  else
    warn "sync not run (it may restart mihomo). Run later: sh /root/sync_mtrickle_mihomo.sh  or use --restart"
  fi
  # v1.13.0: ship the lists template + seeder, and auto-seed MagiTrickle if it is empty (fresh install).
  write_lists_assets; _s5_lists=$?
  seed_lists ""; _s5_seed=$?
  # v1.29.0: a run that installs sync can also be the only install step (`--step 5 --modules=...`).
  modules_state_sync; _s5_state=$?
  # I12 (audit 18.11.2026): this step used to return 0 no matter what happened to the writes,
  # the seed or the module state, so verify then accepted the old asset as "present".
  _step5_apply_result "$_save5_before" "$_s5_seed" "$_s5_lists" "$_s5_state" || return 1
  return 0
}

# Split out so the failure contract is testable without running the whole step.
_step5_apply_result() { # <save-fail-before> <seed-rc> <lists-rc> <state-rc>
  _sar=0
  if [ "${SAVE_FAIL:-0}" != "${1:-0}" ]; then
    bad "не все файлы записаны (ошибок: $((SAVE_FAIL - ${1:-0})))"
    _sar=1
  fi
  [ "${2:-0}" = 0 ] || { bad "MagiTrickle lists not seeded (rc=$2)"; _sar=1; }
  [ "${3:-0}" = 0 ] || { bad "list assets not written (rc=$3)"; _sar=1; }
  [ "${4:-0}" = 0 ] || { bad "module state not recorded (rc=$4)"; _sar=1; }
  return $_sar
}
step5_verify() { step5_check; }

# ============================================================ STEP 6: services (start missing only)
SVC_LIST="dnsmasq magitrickled mihomo hev-socks5-tunnel rpcd ai-doh dnsmasq-ai"
# ai-doh/dnsmasq-ai run as generic binaries (https-dns-proxy/dnsmasq), so pidof
# by service name never matches - check their listening ports instead.
aidns_svc_ok() {
  case "$1" in
    ai-doh)     netstat -ltnu 2>/dev/null | grep -q '127.0.0.1:5055 ' ;;
    dnsmasq-ai)
      _aiip=${AIDNS_IP:-$(aidns_ip)}
      [ -n "$_aiip" ] && netstat -ltnu 2>/dev/null | grep -q "$_aiip:5353 " ;;
  esac
}
step6_check() {
  _need=0
  for s in $SVC_LIST; do
    case "$s" in
      magitrickled) _p=magitrickled ;;
      *) _p=$s ;;
    esac
    if [ -f "$(P /etc/geomask-aidns.off)" ] && { [ "$s" = ai-doh ] || [ "$s" = dnsmasq-ai ]; }; then
      info "$s: AI-DNS disabled - skipped"; continue
    fi
    if ! module_selected ai_dns && { [ "$s" = ai-doh ] || [ "$s" = dnsmasq-ai ]; }; then
      info "$s: модуль ai_dns не выбран - skipped"; continue
    fi
    if [ "$s" = hev-socks5-tunnel ] && ! module_selected path_ai && ! module_selected ai_dns; then
      info "$s: не нужен выбранным модулям - skipped"; continue
    fi
    case "$s" in
      ai-doh|dnsmasq-ai)
        if aidns_svc_ok "$s"; then info "$s: listening"
        else warn "$s: NOT listening"; _need=1; fi
        ;;
      *) svc_alive "$_p" && info "$s: running" || { warn "$s: NOT running"; _need=1; } ;;
    esac
  done
  return $_need
}
step6_apply() {
  for s in $SVC_LIST; do
    _p=$s; [ "$s" = magitrickled ] && _p=magitrickle
    if [ -f "$(P /etc/geomask-aidns.off)" ] && { [ "$s" = ai-doh ] || [ "$s" = dnsmasq-ai ]; }; then
      info "$s: AI-DNS disabled - skipped"; continue
    fi
    if ! module_selected ai_dns && { [ "$s" = ai-doh ] || [ "$s" = dnsmasq-ai ]; }; then
      info "$s: модуль ai_dns не выбран - skipped"; continue
    fi
    if [ "$s" = hev-socks5-tunnel ] && ! module_selected path_ai && ! module_selected ai_dns; then
      info "$s: не нужен выбранным модулям - skipped"; continue
    fi
    case "$s" in
      ai-doh|dnsmasq-ai)
        if aidns_svc_ok "$s"; then info "$s: already listening - untouched"; continue; fi
        info "starting $s (not listening)..."
        initd "$s" start >/dev/null 2>&1 || warn "cannot start $s"
        ;;
      *)
        if svc_alive "$s"; then info "$s: already running - untouched"; continue; fi
        info "starting $s (it was down)..."
        initd "$_p" start >/dev/null 2>&1 || warn "cannot start $s"
        ;;
    esac
  done
  return 0
}
step6_verify() { step6_check; }

# ============================================================ STEP 7: end-to-end verify (read-only)
# Groups a fresh install must have (I01, audit 18.11.2026). The template creates VPN-noP2P and
# AI; `VPN` is the optional second tunnel the panel adds later, so its absence is the documented
# single-tunnel topology, not a broken install. A VPN group that IS declared in the config but
# missing from the API means mihomo did not load it - that stays a failure.
_step7_groups() {
  _sg_need=0
  if _sg_px=$(controller_curl -f -m 5 -s "http://127.0.0.1:9090/proxies" 2>/dev/null); then
    if printf '%s' "$_sg_px" | grep -q '"VPN-noP2P"'; then
      info "mihomo group VPN-noP2P: in API"
    else
      bad "mihomo group VPN-noP2P missing"; _sg_need=1
    fi
    if printf '%s' "$_sg_px" | grep -q '"AI"'; then
      info "mihomo group AI: in API"
    else
      bad "mihomo group AI missing"; _sg_need=1
    fi
    if printf '%s' "$_sg_px" | grep -q '"VPN"'; then
      info "mihomo group VPN: in API"
    elif grep -qE '^[[:space:]]*- name: VPN$' "$(P "$MIHOMO_CONF")" 2>/dev/null; then
      bad "mihomo group VPN: declared in the config but missing from the API"; _sg_need=1
    else
      info "mihomo group VPN: not used (single tunnel - main lists ride VPN-noP2P)"
    fi
  else
    bad "mihomo controller request failed (check authentication/connectivity)"; _sg_need=1
  fi
  return $_sg_need
}

