#!/bin/sh
# geomask.sh - geo-masking overlay + 2-subscription mihomo stack for OpenWrt
# Workflow: check -> geo overlay -> mihomo 2 subs -> AI-DNS (no DNS leak) -> magitrickle sync -> services -> verify
#
# Usage:
#   sh geomask.sh              interactive menu (status dashboard + actions loop)
#   sh geomask.sh --reinstall  delete -> install -> configure geomask (asks for 2 subscription URLs)
#   sh geomask.sh --backup     create a full settings backup (LuCI-restorable) and exit
#   sh geomask.sh --auto       all steps unattended: check, apply if needed, verify; stop on FAIL
#   sh geomask.sh --check      read-only report of every step (no changes, no downloads)
#   sh geomask.sh --step N     single step N interactively
#   sh geomask.sh --yes        never ask (with --auto/--step/--reinstall)
#   sh geomask.sh --restart    allow mihomo/magitrickle restarts where needed (drops VPN ~3s)
#   sh geomask.sh --vpn-url U --ai-url U    set subscription URLs (kept secret in config only)
#   sh geomask.sh --seed-lists  restore MagiTrickle domain lists from the bundled template (all groups)
#   sh geomask.sh --list-modules   what is mandatory and what is optional
#   sh geomask.sh --modules=core,path_vpn   install only the modules this router needs
#   sh geomask.sh --adopt-config  take an existing (non-geomask) mihomo config under management
#   sh geomask.sh --replace-config  rewrite an existing config with the template (drops tun/dns/secret)
#   sh geomask.sh --help
#
# Install (jsDelivr CDN - fast, shows download progress):
#   curl -fL -m 60 -o /tmp/geomask.sh 'https://cdn.jsdelivr.net/gh/kabzon93region/geomask@master/geomask.sh' && sh /tmp/geomask.sh
# wget fallback:
#   wget -T 30 -O /tmp/geomask.sh 'https://cdn.jsdelivr.net/gh/kabzon93region/geomask@master/geomask.sh' && sh /tmp/geomask.sh
# GitHub raw (can be VERY slow from some networks -> looks like a hang; prefer jsDelivr):
#   sh <(wget -qO - 'https://raw.githubusercontent.com/kabzon93region/geomask/master/geomask.sh')
#
# SAFETY: never reboots the router; never restarts working services (only starts missing ones);
#         never touches network/pppoe config; backups before every file write and before ANY
#         mihomo restart (full settings backup via sysupgrade -b -> /root/geomask-backups/,
#         built in /tmp then moved, freshest one kept, published read-only over SMB as
#         'geomask-backups' with links in the panel - v1.9.0),
#         mihomo restart = trial-run on shifted ports FIRST, restart only if the trial starts,
#         and automatic rollback to the previous config if the restarted service does not
#         answer. Hard pin: /root/.geomask-norestart disables --restart entirely.

set -u

GM_VERSION="1.31.0"
GM_PREFIX="${GM_PREFIX:-}"          # path prefix for tests (empty on real router)
GM_YES=0
GM_AUTO=0
GM_CHECK_ONLY=0
GM_RESTART=0
GM_BACKUP=0
GM_REINSTALL=0
GM_SEED_LISTS=0
GM_ADOPT=0
GM_REPLACE=0
GM_STEP=""
GM_VPN_URL=""
GM_AI_URL=""
# IPv6 is OFF by default (owner decision 14.11.2026): geomask tunnels IPv4 only, so a global
# IPv6 address leaves for the WAN directly and shows the real address and country.
# `--ipv6=keep` is the only way to keep IPv6 on the router.
GM_IPV6=off

# ---- paths shared by the backup, SMB and module code (used before their sections) ----
BACKUP_DIR=/root/geomask-backups
SMB_SHARE_NAME=geomask-backups
SMB_SHARE_ENABLE=/etc/geomask/backup-share.enable

# ---- embedded assets are injected by build.py into the heredocs below ----

PASS=0; FAILCNT=0; SKIP=0
# Counts failed writes so an apply step can refuse to report success. A heredoc call cannot
# carry `|| ...` without breaking the build-time asset parser, so save_stream records it.
SAVE_FAIL=0

log()  { printf '%s\n' "$*"; }
info() { printf '  %s\n' "$*"; }
ok()   { printf '  [OK] %s\n' "$*"; PASS=$((PASS+1)); }
bad()  { printf '  [FAIL] %s\n' "$*"; FAILCNT=$((FAILCNT+1)); }
warn() { printf '  [WARN] %s\n' "$*"; }
hdr()  { printf '\n== [%s] %s ==\n' "$1" "$2"; }

ask() { # ask "question" -> 0=yes  (auto/yes modes never block)
  [ "$GM_YES" = 1 ] && return 0
  [ "$GM_AUTO" = 1 ] && return 0
  printf '%s [y/N]: ' "$1"
  read -r _a || return 1
  case "$_a" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

P() { printf '%s%s' "$GM_PREFIX" "$1"; }

# ---- discovered names: nothing below may assume br-lan / pppoe-wan / 192.168.0.x ----
LAN_IF_CACHE=""
lan_iface() {
  [ -n "$LAN_IF_CACHE" ] && { printf '%s' "$LAN_IF_CACHE"; return 0; }
  _i=$(uci -q get network.lan.device 2>/dev/null)
  [ -n "$_i" ] || _i=$(uci -q get network.lan.ifname 2>/dev/null)
  case "$_i" in ''|*[!a-zA-Z0-9._-]*) _i="" ;; esac
  [ -n "$_i" ] || _i=br-lan
  LAN_IF_CACHE="$_i"
  printf '%s' "$_i"
}

lan_ip() {
  ip -4 addr show "$(lan_iface)" 2>/dev/null \
    | sed -n 's/.*inet \([0-9][0-9.]*\)\/.*/\1/p' | head -1
}

wan_iface() {
  # The device that actually carries the default route, not the uci interface name: on PPPoE
  # the uci name is `wan` while traffic leaves through `pppoe-wan`, and every consumer here
  # (MagiTrickle group interface, curl --interface) needs the device.
  #
  # netifd is asked first because it knows the L3 device; the routing table is only a
  # fallback, and the OLD fallback picked the first default - which on a policy-routed box is
  # the tunnel - then silently returned `pppoe-wan` when nothing matched (audit F17).
  _i=""
  if have ubus; then
    _i=$(ubus call network.interface.wan status 2>/dev/null \
         | sed -n 's/.*"l3_device"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -1)
    case "$_i" in ''|*[!a-zA-Z0-9._-]*) _i="" ;; esac
  fi
  _tun=$(mihomo_tun)
  if [ -z "$_i" ]; then
    for _cand in $(ip route show default 2>/dev/null | sed -n 's/.*dev \([a-zA-Z0-9._-]*\).*/\1/p'); do
      case "$_cand" in
        "$_tun"|Mihomo|AI|wg*|tun*|tap*) continue ;;
      esac
      _i=$_cand; break
    done
  fi
  if [ -z "$_i" ]; then
    for _k in network.wan.device network.wan.ifname network.wan6.device; do
      _cand=$(uci -q get "$_k" 2>/dev/null)
      case "$_cand" in ''|*[!a-zA-Z0-9._-]*) continue ;; esac
      # `wan` is the interface name, not a device: accept only something that exists
      ip link show "$_cand" >/dev/null 2>&1 && { _i=$_cand; break; }
    done
  fi
  # No guess: an empty answer means "unknown", and callers must not configure a direct lane
  # on an interface nobody verified.
  printf '%s' "$_i"
}

mihomo_tun() { # the TUN device mihomo is configured to create
  _d=$(awk '/^tun:/{f=1;next} f&&/^[^ ]/{exit} f&&/^[[:space:]]*device:/{gsub(/^[[:space:]]*device:[[:space:]]*/,"");print;exit}' \
       "$(P /etc/mihomo/config.yaml)" 2>/dev/null)
  case "$_d" in ''|*[!a-zA-Z0-9._-]*) _d=Mihomo ;; esac
  printf '%s' "$_d"
}

# Address for the second (AI) dnsmasq. An explicit override wins; otherwise .53 inside the
# real LAN subnet, and only when that is a usable, unoccupied host address. The old version
# always replaced the last octet with 53: on a /25 that address is outside the LAN, and on a
# router whose own address ends in .53 the alias "already existed" while the DNAT pointed at
# the router itself. When no safe address can be chosen the caller must refuse to configure
# AI-DNS instead of sending devices to a DNS that does not answer.
_aidns_usable() { # _aidns_usable <candidate> <lan-ip> <prefix>
  awk -v ip="$1" -v lan="$2" -v p="$3" 'BEGIN{
    n=split(ip,A,"."); m=split(lan,B,".");
    if (n != 4 || m != 4) exit 1;
    for (i=1; i<=4; i++) { if (A[i] !~ /^[0-9]+$/ || A[i] < 0 || A[i] > 255) exit 1 }
    for (i=1; i<=4; i++) { if (B[i] !~ /^[0-9]+$/ || B[i] < 0 || B[i] > 255) exit 1 }
    ipn=((A[1]*256+A[2])*256+A[3])*256+A[4];
    lann=((B[1]*256+B[2])*256+B[3])*256+B[4];
    size=2^(32-p);
    net=int(lann/size)*size;
    if (ipn < net+1 || ipn > net+size-2) exit 1;   # network/broadcast are not hosts
    if (ipn == lann) exit 1;                        # the router itself
    exit 0
  }'
}

_prefix_to_mask() { # _prefix_to_mask <prefix> -> dotted netmask
  awk -v p="$1" 'BEGIN{
    v=0; for (i=0; i<p; i++) v+=2^(31-i);
    printf "%d.%d.%d.%d", int(v/16777216)%256, int(v/65536)%256, int(v/256)%256, v%256
  }'
}

# 0 when <ip> is already in use by something other than our own alias on <iface>.
# Absence of a neighbour entry does not prove the address is free; it only rules out a host
# that answered recently, so the caller still refuses when the answer is ambiguous.
_aidns_taken() { # _aidns_taken <ip> <iface>
  _at="$1"
  ip -4 addr show "$2" 2>/dev/null | grep -q " $_at/" && return 1   # our own alias
  ip -4 addr show 2>/dev/null | grep -q " $_at/" && return 0
  ip neigh show "$_at" 2>/dev/null | grep -q 'lladdr' && return 0
  return 1
}

aidns_ip() {
  _ip=$(lan_ip)
  case "$_ip" in *.*.*.*) ;; *) printf ''; return 0 ;; esac
  _if=$(lan_iface)
  _pfx=$(ip -4 addr show "$_if" 2>/dev/null | sed -n 's/.*inet [0-9.]*\/\([0-9][0-9]*\).*/\1/p' | head -1)
  case "$_pfx" in ''|*[!0-9]*) _pfx=24 ;; esac
  [ "$_pfx" -ge 1 ] 2>/dev/null || _pfx=24
  [ "$_pfx" -le 30 ] 2>/dev/null || { printf ''; return 0; }
  # An explicit override is still an address on THIS LAN. The old code returned any four
  # dot-separated pieces without a single check, so 999.1.1.1 or the router's own address
  # became the DNAT target and the alias was written to uci (audit 14.11.2026, F11).
  _ov=$(tr -d ' \r\n' < "$(P /etc/geomask-aidns.ip)" 2>/dev/null)
  if [ -n "$_ov" ]; then
    if ! _aidns_usable "$_ov" "$_ip" "$_pfx"; then
      printf '  [WARN] AI-DNS: адрес из /etc/geomask-aidns.ip (%s) не подходит для %s/%s - AI-DNS не настраивается\n' "$_ov" "$_ip" "$_pfx" >&2
      printf ''; return 0
    fi
    if _aidns_taken "$_ov" "$_if"; then
      printf '  [WARN] AI-DNS: адрес %s из /etc/geomask-aidns.ip уже занят - AI-DNS не настраивается\n' "$_ov" >&2
      printf ''; return 0
    fi
    printf '%s' "$_ov"; return 0
  fi
  # An alias this installer created earlier is not a conflict: keep it on re-runs.
  _cur=$(uci -q get network.lanai.ipaddr 2>/dev/null)
  case "$_cur" in
    *.*.*.*)
      if _aidns_usable "$_cur" "$_ip" "$_pfx" && ! _aidns_taken "$_cur" "$_if"; then
        printf '%s' "$_cur"; return 0
      fi
      ;;
  esac
  _cand=$(printf '%s' "$_ip" | cut -d. -f1-3).53
  _aidns_usable "$_cand" "$_ip" "$_pfx" || { printf ''; return 0; }
  # Already assigned to another interface, or a neighbour answers for it: a collision, not a
  # free address. Both checks are cheap and prevent pointing DNS at someone else's host.
  _aidns_taken "$_cand" "$_if" && { printf ''; return 0; }
  printf '%s' "$_cand"
}

# Keep authentication out of curl argv and diagnostics; read the active config on each call.
controller_curl() {
  python3 - "$(P /etc/mihomo/config.yaml)" "$@" <<'GM_CONTROLLER_PY'
import json, re, subprocess, sys

def controller_headers(path):
    with open(path, encoding='utf-8') as config:
        for line in config:
            match = re.match(r'^secret:\s*(.*)$', line.rstrip('\r\n'))
            if not match:
                continue
            value = match.group(1).strip()
            if value.startswith('"'):
                value, end = json.JSONDecoder().raw_decode(value)
                tail = match.group(1).strip()[end:].strip()
                if tail and not tail.startswith('#'):
                    raise ValueError('Invalid controller secret')
            elif value.startswith("'"):
                quoted = re.fullmatch(r"'((?:[^']|'')*)'\s*(?:#.*)?", value)
                if not quoted:
                    raise ValueError('Invalid controller secret')
                value = quoted.group(1).replace("''", "'")
            else:
                value = re.split(r'\s+#', value, maxsplit=1)[0].strip()
                if value.startswith('#'):
                    value = ''
                if value.startswith(('|', '>', '[', '{', '&', '*', '!')):
                    raise ValueError('Unsupported controller secret')
            if not isinstance(value, str) or any(ord(c) < 32 or ord(c) == 127 for c in value):
                raise ValueError('Invalid controller secret')
            return {'Authorization': 'Bearer ' + value} if value else {}
    return {}

try:
    headers = controller_headers(sys.argv[1])
    options = ''.join('header = ' + json.dumps(k + ': ' + v, ensure_ascii=False) + '\n'
                      for k, v in headers.items())
    result = subprocess.run(['curl', '--config', '-', *sys.argv[2:]],
                            input=options.encode('utf-8'))
    sys.exit(result.returncode)
except Exception:
    print('Controller request failed (configuration or transport error)', file=sys.stderr)
    sys.exit(1)
GM_CONTROLLER_PY
}

# ---- mihomo config: ownership, validation, provider discovery -----------------
# A config that already carries geomask's layout (provider + the two groups it manages) can
# be patched in place. Anything else belongs to the owner: it is never overwritten silently,
# because a rewrite drops tun/dns/secret and every custom rule with it.
#
# Ownership is a STRUCTURAL question. The previous version grepped for a line `  sub:` and
# for two `- name:` lines anywhere in the file, so a foreign YAML with `proxy-providers.own`
# and a `rule-providers.sub` was taken over, and --vpn-url then rewrote the rule-provider's
# URL instead of a proxy-provider (audit 14.11.2026, F06). Without a YAML parser the answer
# is "not ours": refusing is the safe direction.
# The router always has python3. A test host may expose only `python`, or a broken `python3`
# alias that `command -v` still finds - so the interpreter is probed, not assumed.
_mihomo_py() {
  # `-` makes the interpreter read the program from stdin and pass the rest as sys.argv.
  if [ -n "${GM_PYTHON:-}" ]; then "$GM_PYTHON" - "$@" 2>/dev/null; return; fi
  if python3 -c 'pass' >/dev/null 2>&1; then python3 - "$@" 2>/dev/null
  else python - "$@" 2>/dev/null; fi
}

# PyYAML is what decides ownership of the mihomo config; ask the same interpreter the parser
# would use, not a hard-coded `python3`.
_py_yaml_ok() {
  if [ -n "${GM_PYTHON:-}" ]; then "$GM_PYTHON" -c 'import yaml' >/dev/null 2>&1; return; fi
  python3 -c 'import yaml' >/dev/null 2>&1 && return 0
  python -c 'import yaml' >/dev/null 2>&1
}

geomask_config_shaped() { # geomask_config_shaped <file>
  _f="$1"
  [ -s "$_f" ] || return 1
  grep -qxF '# geomask-managed: 1' "$_f" 2>/dev/null && return 0
  _mihomo_py "$_f" <<'PYEOF'
import sys
try:
    import yaml
except Exception:
    raise SystemExit(1)
try:
    with open(sys.argv[1], encoding='utf-8') as fh:
        data = yaml.safe_load(fh)
except Exception:
    raise SystemExit(1)
if not isinstance(data, dict):
    raise SystemExit(1)
providers = data.get('proxy-providers')
groups = data.get('proxy-groups')
if not isinstance(providers, dict) or 'sub' not in providers:
    raise SystemExit(1)
if not isinstance(groups, list):
    raise SystemExit(1)
names = {g.get('name') for g in groups if isinstance(g, dict)}
raise SystemExit(0 if {'VPN-noP2P', 'AI'} <= names else 1)
PYEOF
}

_mihomo_has_provider() { # _mihomo_has_provider <file> <provider> -> 0 when it exists
  _mihomo_py "$1" "$2" <<'PYEOF'
import sys
try:
    import yaml
except Exception:
    raise SystemExit(1)
try:
    with open(sys.argv[1], encoding='utf-8') as fh:
        data = yaml.safe_load(fh)
except Exception:
    raise SystemExit(1)
providers = data.get('proxy-providers') if isinstance(data, dict) else None
raise SystemExit(0 if isinstance(providers, dict) and sys.argv[2] in providers else 1)
PYEOF
}

any_provider_url() { # first http provider url in the config (any provider name)
  _mihomo_py "$1" <<'PYEOF'
import sys
try:
    import yaml
except Exception:
    raise SystemExit(1)
try:
    with open(sys.argv[1], encoding='utf-8') as fh:
        data = yaml.safe_load(fh)
except Exception:
    raise SystemExit(1)
providers = data.get('proxy-providers') if isinstance(data, dict) else None
if not isinstance(providers, dict):
    raise SystemExit(0)
for entry in providers.values():
    url = entry.get('url') if isinstance(entry, dict) else None
    if isinstance(url, str) and url.strip():
        print(url.strip())
        break
PYEOF
}

mihomo_validate() { # mihomo_validate <config-file>  - the CANDIDATE, never the live file
  [ -s "$1" ] || return 1
  mihomo -d "$(P /etc/mihomo)" -f "$1" -t >/dev/null 2>&1
}

# extract provider url from mihomo config: _prov_url <file> <provider-name>
_prov_url() {
  _mihomo_py "$1" "$2" <<'PYEOF'
import sys
try:
    import yaml
except Exception:
    raise SystemExit(1)
try:
    with open(sys.argv[1], encoding='utf-8') as fh:
        data = yaml.safe_load(fh)
except Exception:
    raise SystemExit(1)
providers = data.get('proxy-providers') if isinstance(data, dict) else None
entry = providers.get(sys.argv[2]) if isinstance(providers, dict) else None
url = entry.get('url') if isinstance(entry, dict) else None
if isinstance(url, str) and url.strip():
    print(url.strip())
PYEOF
}

# ---- modules: which parts of geomask get installed -------------------------
# core and path_vpn are mandatory: without the core nothing runs, without the VPN
# lane the product has no purpose. Everything else is optional and can be left out
# with --modules=... so a router only carries the features its owner wants.
GM_REQUIRED_MODULES="core path_vpn"
GM_ALL_MODULES="core luci guard path_vpn path_vpn_nop2p path_ai ai_dns youtube torrent diagnostic doctor device_modes backup_share self_update admission_service"
GM_MODULES=""

module_required() { case " $GM_REQUIRED_MODULES " in *" $1 "*) return 0 ;; esac; return 1; }
module_selected() {
  [ -z "$GM_MODULES" ] && return 0
  case " $GM_MODULES " in *" $1 "*) return 0 ;; esac
  return 1
}
module_label() {
  case "$1" in
    core) echo "geomask (ядро): синк, node-audit, лейн, списки" ;;
    luci) echo "Админка LuCI: панель, бэкенд, RPC" ;;
    guard) echo "geomask-guard: сторож маршрута после ifup" ;;
    path_vpn) echo "VPN-лейн (основной туннель)" ;;
    path_vpn_nop2p) echo "VPN-noP2P (без торрентов)" ;;
    path_ai) echo "AI-лейн (Google/OpenAI/Claude)" ;;
    ai_dns) echo "DNS-over-HTTPS для AI-устройств" ;;
    youtube) echo "YouTube: watchdog и списки доменов" ;;
    torrent) echo "Торренты: правила и слушатель" ;;
    diagnostic) echo "Старые проверки: dnscheck, vpnwatch, утренняя проверка" ;;
    doctor) echo "Центр диагностики: проверки, маршруты, логи" ;;
    device_modes) echo "Режимы устройств (исключения из туннеля)" ;;
    backup_share) echo "SMB-шар с бэкапами" ;;
    self_update) echo "Самообновление из GitHub" ;;
    admission_service) echo "Служба допуска AI-устройств" ;;
    *) echo "" ;;
  esac
}
module_owns_path() { # echoes the module id that owns an install path, if any
  GM_PATH_MODULE=""
  case "$1" in
@@MODULE_PATHS@@
  esac
  [ -n "$GM_PATH_MODULE" ] && echo "$GM_PATH_MODULE"
}
module_skip_path() { # true when the path belongs to a module the owner did not select
  _m=$(module_owns_path "$1")
  [ -n "$_m" ] || return 1
  module_selected "$_m" && return 1
  return 0
}

save_stream() { # save_stream <target-path> <mode>  (content on stdin)
  if module_skip_path "$1"; then
    cat >/dev/null 2>&1 || true
    info "skip $1: module '$(module_owns_path "$1")' not selected"
    return 0
  fi
  _t="$(P "$1")"; _m="$2"
  mkdir -p "$(dirname "$_t")" || { SAVE_FAIL=$((SAVE_FAIL+1)); return 1; }
  _tmp="$_t.zmnew"
  cat > "$_tmp" || { rm -f "$_tmp"; SAVE_FAIL=$((SAVE_FAIL+1)); return 1; }
  if [ -f "$_t" ] && cmp -s "$_tmp" "$_t"; then
    # identical bytes: keep the file, but repair a lost mode. Returning before chmod left an
    # entrypoint non-executable forever after a restore or a botched copy.
    chmod "$_m" "$_t" 2>/dev/null || true
    rm -f "$_tmp"
    info "unchanged: $1"
    return 0
  fi
  if [ -f "$_t" ]; then
    cp -p "$_t" "$_t.bak_geomask_$(date +%s 2>/dev/null || echo bak)" 2>/dev/null || true
  fi
  chmod "$_m" "$_tmp" 2>/dev/null || true
  mv -f "$_tmp" "$_t" || { SAVE_FAIL=$((SAVE_FAIL+1)); return 1; }
  info "written: $1 (mode $_m)"
  return 0
}

# ---- optional modules: gates shared by check and apply ---------------------
# A module the owner did not select is never written, so every check that used to fail
# the install for its missing piece asks mod_skipped first. Cron entries are the trap:
# creation lives in step5_apply, verification in step5_check, and verification used to
# abort the whole run - so both halves go through cron_ensure / cron_verify, which read
# the same module flag. Never wrap only one half.
mod_skipped() { # mod_skipped <module> -> 0 (and a note) when the module is not selected
  module_selected "$1" && return 1
  info "пропущен: модуль '$1' не выбран"
  return 0
}

cron_ensure() { # cron_ensure <module> <marker-ere> <cron-line>
  mod_skipped "$1" && return 0
  if crontab -l 2>/dev/null | grep -qE -- "$2"; then info "cron: уже есть ($2)"; return 0; fi
  ( crontab -l 2>/dev/null; printf '%s\n' "$3" ) | crontab - 2>/dev/null \
    && info "cron: добавлен ($2)" || warn "cron: не удалось записать ($2)"
}

cron_verify() { # cron_verify <module> <marker-ere> <label> [soft]
  mod_skipped "$1" && return 0
  if crontab -l 2>/dev/null | grep -qE -- "$2"; then info "$3: present"; return 0; fi
  if [ "${4:-hard}" = soft ]; then warn "$3: отсутствует"
  else bad "$3: отсутствует"; _need=1; fi
}

ruleset_stub() { # ruleset_stub <module> <install-path> - keep `mihomo -t` valid without the module
  mod_skipped "$1" >/dev/null || return 0
  [ -s "$(P "$2")" ] && return 0
  mkdir -p "$(dirname "$(P "$2")")" 2>/dev/null
  printf '%s\n%s\n' "# module '$1' is not selected: ruleset kept empty" 'payload: []' > "$(P "$2")"
  info "ruleset: $2 kept empty (module '$1' not selected)"
}

# ---- the selection is remembered on the router ------------------------------
# /etc/geomask/modules.json is the single source of truth for "which modules does this
# router carry": the installer writes it, the panel and the per-module updater read it.
MODULES_STATE=/etc/geomask/modules.json

modules_state_read() { # prints the stored selection; rc=1 when there is none
  [ -s "$(P $MODULES_STATE)" ] || return 1
  python3 - "$(P $MODULES_STATE)" <<'PYEOF' 2>/dev/null
import json, sys
try:
    data = json.load(open(sys.argv[1], encoding='utf-8'))
except Exception:
    raise SystemExit(1)
print(' '.join(str(item) for item in (data.get('selected') or [])))
PYEOF
}

modules_state_write() { # modules_state_write <module>...
  [ $# -gt 0 ] || return 0
  mkdir -p "$(P /etc/geomask)" 2>/dev/null || true
  python3 - "$(P $MODULES_STATE)" "$@" <<'PYEOF' 2>/dev/null || warn "modules: не удалось записать $MODULES_STATE"
import json, sys
json.dump({'selected': sys.argv[2:]},
          open(sys.argv[1], 'w', encoding='utf-8', newline='\n'),
          ensure_ascii=False, indent=2)
PYEOF
}

module_effective_list() { # the modules this run installs (all, unless --modules narrowed it)
  if [ -n "$GM_MODULES" ]; then printf '%s\n' "$GM_MODULES"; else printf '%s\n' "$GM_ALL_MODULES"; fi
}

modules_state_sync() { # remember the effective selection, only when it changed
  _want=$(module_effective_list)
  _have=$(modules_state_read 2>/dev/null || true)
  [ "$_want" = "$_have" ] && return 0
  # Narrowing the selection does not delete anything: say it once, with the way out.
  for _m in $_have; do
    case " $_want " in
      *" $_m "*) ;;
      *) warn "модуль '$_m' снят с выбора, его файлы остались на роутере (удалит --reinstall)" ;;
    esac
  done
  modules_state_write $_want
}

choose_modules() { # interactive picker; required modules are always installed
  _cur=$(modules_state_read 2>/dev/null || true)
  [ -n "$_cur" ] || _cur="$GM_ALL_MODULES"
  echo
  printf '%sМодули%s: обязательные ставятся всегда, остальные — по выбору.\n' "$C_Y" "$NC"
  _i=0
  for _m in $GM_ALL_MODULES; do
    _i=$((_i+1))
    if module_required "$_m"; then _mk="обязательный"; _mc="$C_G"
    else
      case " $_cur " in
        *" $_m "*) _mk="выбран"; _mc="$C_G" ;;
        *)         _mk="по выбору"; _mc="$C_DIM" ;;
      esac
    fi
    printf '  %s%2d)%s %-18s %s  %s[%s]%s\n' "$C_B" "$_i" "$NC" "$_m" "$(module_label "$_m")" "$_mc" "$_mk" "$NC"
  done
  printf 'Номера через запятую [Enter = оставить текущий выбор, all = все]: '
  read -r _ans || _ans=""
  case "$_ans" in
    "") GM_MODULES=$_cur ;;
    all|ALL|все|ВСЕ|Все) GM_MODULES="$GM_ALL_MODULES" ;;
    *)
      _sel=""
      for _tok in $(printf '%s' "$_ans" | tr ',' ' '); do
        case "$_tok" in
          *[!0-9]*) warn "не номер: $_tok"; continue ;;
        esac
        _m=$(printf '%s\n' $GM_ALL_MODULES | sed -n "${_tok}p")
        if [ -z "$_m" ]; then warn "нет модуля с номером $_tok"; continue; fi
        case " $_sel " in *" $_m "*) ;; *) _sel="$_sel $_m" ;; esac
      done
      for _m in $GM_REQUIRED_MODULES; do
        case " $_sel " in *" $_m "*) ;; *) _sel="$_sel $_m" ;; esac
      done
      GM_MODULES=$(printf '%s' "$_sel" | sed 's/^ *//;s/  */ /g')
      ;;
  esac
  info "модули: $GM_MODULES"
}

modules_maybe_prompt() { # ask at most once per run, and only when the run can install
  [ -n "$GM_MODULES" ] && return 0
  [ "${GM_MODULES_ASKED:-0}" = 1 ] && return 0
  # GM_MODULES_ASK=1 lets the sandbox harness drive the picker without a tty.
  if [ "${GM_MODULES_ASK:-0}" != 1 ]; then
    if [ "$GM_YES" = 1 ] || [ "$GM_AUTO" = 1 ] || [ "$GM_CHECK_ONLY" = 1 ]; then
      # unattended runs keep the router's own selection; "no --modules" used to mean "all",
      # which made an update re-install modules the owner had deliberately left out
      _stored=$(modules_state_read 2>/dev/null || true)
      [ -n "$_stored" ] && GM_MODULES="$_stored"
      return 0
    fi
    [ -t 0 ] || return 0
  fi
  GM_MODULES_ASKED=1
  choose_modules
}

have() { command -v "$1" >/dev/null 2>&1; }

svc_alive() { pidof "$1" >/dev/null 2>&1; }

initd() { # initd <svc> <action>  - respects GM_PREFIX for tests
  "$(P /etc/init.d/$1)" "$2" 2>/dev/null
}

# ============================================================ PREFLIGHT
# Everything that can only fail later is checked here, before the first byte is written:
# a reset router must not end up with a panel and no working mihomo config.
preflight() {
  _need=0
  _c="$(P $MIHOMO_CONF)"
  if [ -z "$GM_VPN_URL" ]; then
    _u=""
    [ -s "$_c" ] && _u=$(_prov_url "$_c" sub)
    if [ -z "$_u" ] && [ -s "$_c" ]; then _u=$(any_provider_url "$_c"); fi
    if [ -z "$_u" ]; then
      if [ -s "$_c" ] && ! geomask_config_shaped "$_c" && [ "${GM_ADOPT:-0}" != 1 ] \
         && [ "${GM_REPLACE:-0}" != 1 ]; then
        bad "preflight: на роутере свой конфиг mihomo, подписка не задана"
        info "  Либо --vpn-url '<ссылка>' (геомаск перепишет конфиг по шаблону),"
        info "  либо --adopt-config (взять текущий конфиг под управление, сохранив его),"
        info "  либо --replace-config (явная замена шаблоном)."
      else
        bad "preflight: не задана ссылка VPN-подписки"
        info "  Запустите: sh $0 --vpn-url 'https://...' --auto"
      fi
      _need=1
    fi
  fi
  if have python3 && ! python3 -c 'import yaml' >/dev/null 2>&1; then
    have apk || have opkg || { bad "preflight: нет apk/opkg - python3-yaml не поставить"; _need=1; }
  fi
  [ -n "$(lan_ip)" ] || { bad "preflight: не определён адрес LAN ($(lan_iface)) - слушатели некуда привязать"; _need=1; }
  return $_need
}

# ============================================================ STEP 1: env
step1_check() {
  _need=0
  [ -f "$(P /etc/openwrt_release)" ] && info "OpenWrt: $(grep '^DISTRIB_RELEASE=' "$(P /etc/openwrt_release)" 2>/dev/null | cut -d"'" -f2)" || { bad "not OpenWrt (/etc/openwrt_release missing)"; _need=1; }
  if have apk; then info "pkg manager: apk"; elif have opkg; then info "pkg manager: opkg"; else bad "no apk/opkg"; _need=1; fi
  # v1.30.5: geomask is an overlay over mihomo, not a standalone product. Saying so here
  # means a bare/reset router stops at step 1, before a single file is written, instead of
  # installing the panel and only then reporting "mihomo binary missing" at step 3.
  if have mihomo; then info "mihomo: present"
  else bad "mihomo: MISSING - geomask is an overlay over mihomo; install mihomo first (its config, subscriptions and TUN come from it)"; _need=1; fi
  if have magitrickled || [ -f "$(P /etc/init.d/magitrickle)" ]; then info "magitrickle: present"
  else bad "magitrickle: MISSING - domain lists and per-domain routing live there; install magitrickle first"; _need=1; fi
  for c in python3 curl; do
    if have "$c"; then info "$c: present"; else warn "$c: MISSING - will be installed at apply (apk/opkg)"; _need=1; fi
  done
  # v1.30.15: PyYAML is a hard runtime dependency (slot patcher, audit state, node audit).
  # CI installed it on the runner, so a reset router without python3-yaml was never tested.
  if have python3; then
    if python3 -c 'import yaml' >/dev/null 2>&1; then info "python3-yaml: present"
    else warn "python3-yaml: MISSING - will be installed at apply (apk/opkg)"; _need=1; fi
  fi
  # the AI lane is a second hev-socks5-tunnel instance; without the binary it cannot exist
  if module_selected path_ai || module_selected ai_dns; then
    if have hev-socks5-tunnel || [ -x "$(P /usr/bin/hev-socks5-tunnel)" ]; then info "hev-socks5-tunnel: present"
    else warn "hev-socks5-tunnel: MISSING - нужен для AI-пути и AI-DNS; в фидах его нет, ставится с базовым стеком"; fi
  else
    info "hev-socks5-tunnel: не требуется выбранными модулями"
  fi
  _tmp=$(df -m "$(P /tmp)" 2>/dev/null | awk 'NR==2{print $4}')
  if [ -n "${_tmp:-}" ] && [ "$_tmp" -ge 20 ] 2>/dev/null; then info "/tmp free: ${_tmp}MB"; else warn "/tmp free low or unknown"; _need=1; fi
  _root=$(df -m "$(P /)" 2>/dev/null | awk 'NR==2{print $4}')
  if [ -n "${_root:-}" ] && [ "$_root" -ge 30 ] 2>/dev/null; then info "root free: ${_root}MB"; else warn "root free low or unknown"; _need=1; fi
  _code=$(curl -m 5 -s -o /dev/null -w '%{http_code}' http://www.gstatic.com/generate_204 2>/dev/null)
  if [ "$_code" = "204" ]; then info "internet: OK (204 via router path)"; else warn "internet check: HTTP ${_code:-none} (WAN may be down)"; _need=1; fi
  return $_need
}
# v1.30.6: python3 and curl are installed by the installer itself. A reset router has
# neither, and the owner should not have to know package names - the rest of geomask
# (sync, module updater, doctor, backend) does not run without python3.
step1_apply() {
  _missing=""
  for _c in python3 curl; do have "$_c" || _missing="$_missing $_c"; done
  # package name differs from the import name: python3-yaml provides `import yaml`.
  # Checked even when python3 itself is absent: requiring python3 first installed python3
  # and then failed the yaml verification on a bare router.
  if ! have python3 || ! python3 -c 'import yaml' >/dev/null 2>&1; then
    _missing="$_missing python3-yaml"
  fi
  if [ -z "$_missing" ]; then
    info "packages: python3 and curl already present"
    return 0
  fi
  _missing=$(echo "$_missing" | sed 's/^ *//')
  if have apk; then
    info "installing: $_missing (apk)"
    apk update >/dev/null 2>&1 || warn "apk update failed - trying the current index"
    if apk add $_missing >/dev/null 2>&1; then info "installed: $_missing"
    else bad "apk add $_missing failed - check the internet and free space"; return 1; fi
  elif have opkg; then
    info "installing: $_missing (opkg)"
    opkg update >/dev/null 2>&1 || warn "opkg update failed - trying the current index"
    if opkg install $_missing >/dev/null 2>&1; then info "installed: $_missing"
    else bad "opkg install $_missing failed - check the internet and free space"; return 1; fi
  else
    bad "no apk/opkg - install $_missing manually, then re-run"
    return 1
  fi
  for _c in python3 curl; do
    have "$_c" || { bad "$_c still missing after install"; return 1; }
  done
  if ! python3 -c 'import yaml' >/dev/null 2>&1; then
    bad "python3-yaml still missing after install - панель не сможет назначать подписки"
    return 1
  fi
  info "packages: python3, python3-yaml and curl ready"
  return 0
}
step1_verify() { step1_check; }

# ============================================================ STEP 2: geo overlay (ours)

# ============================================================ STEP 2: geo overlay (ours)
step2_check() {
  _need=0
  for f in /usr/lib/geomask/geomask-node-audit.py \
           /usr/lib/geomask/geomask-audit-state.py \
           /usr/lib/geomask/geomask-config-tx.py \
           /usr/lib/geomask/geomask-config-owner.py \
           /usr/lib/geomask/geomask-apply.py \
           /usr/lib/geomask/geomask-lane-torrent.py \
           /usr/lib/geomask/geomask-sync-youtube.py \
           /usr/lib/geomask/geomask-audit-scheduler.py \
           /usr/lib/geomask/geomask-subscription-status.py \
           /usr/lib/geomask/geomask-slot-patch.py \
           /usr/lib/geomask/geomask-console.py \
           /usr/lib/geomask/geomask-dnsguard.sh \
           /usr/lib/geomask/geomask-routes.sh; do
    if [ -s "$(P "$f")" ]; then info "present: $f"; else bad "missing: $f"; _need=1; fi
  done
  # v1.30.0: the panel is its own module; without it there is nothing to register in ubus
  if module_selected luci; then
    for f in /usr/bin/geo-backend.sh /usr/libexec/rpcd/geo-sync \
             /usr/share/rpcd/acl.d/luci-app-geo-sync.json \
             /usr/share/luci/menu.d/luci-app-geo-sync.json \
             /www/luci-static/resources/view/geo-sync/main.js; do
      if [ -s "$(P "$f")" ]; then info "present: $f"; else bad "missing: $f"; _need=1; fi
    done
    if have ubus && ubus list 2>/dev/null | grep -qx 'geo-sync'; then info "ubus geo-sync: registered"; else bad "ubus geo-sync not registered"; _need=1; fi
  else
    mod_skipped luci
  fi
  # v1.29.0: what this router is supposed to carry, and what the owner left out
  _sel=$(modules_state_read 2>/dev/null || true)
  if [ -n "$_sel" ]; then
    _off=""
    for _m in $GM_ALL_MODULES; do
      case " $_sel " in *" $_m "*) ;; *) _off="$_off $_m" ;; esac
    done
    info "модули: $_sel${_off:+ (не выбраны:$_off)}"
  else
    info "модули: выбор не записан - считаем, что выбраны все"
  fi
  if module_selected backup_share; then
    if [ -e "$(P /etc/ksmbd/ksmbd.conf)" ]; then
      # The share is published only after an explicit opt-in. Without the marker its absence
      # is the expected state: requiring it here made --auto fail step 2 on every fresh
      # system with ksmbd installed, because apply deliberately creates nothing (F15).
      if [ -f "$(P $SMB_SHARE_ENABLE)" ]; then
        if grep -qF "[$SMB_SHARE_NAME]" "$(P /etc/ksmbd/ksmbd.conf)" 2>/dev/null; then
          info "SMB share $SMB_SHARE_NAME: present"
        else
          bad "SMB share $SMB_SHARE_NAME missing (opt-in marker exists)"; _need=1
        fi
      else
        info "SMB share: автопубликация выключена (opt-in: touch $SMB_SHARE_ENABLE) - проверка пропущена"
      fi
    fi
  else
    info "пропущен: SMB-шар с бэкапами (модуль 'backup_share' не выбран)"
  fi
  return $_need
}
step2_apply() {
  _save_before=${SAVE_FAIL:-0}
  save_stream /usr/lib/geomask/geomask-node-audit.py 755 <<'ASSET_EOF'
@@ASSET:geomask-node-audit.py@@
ASSET_EOF
  save_stream /usr/lib/geomask/geomask-audit-state.py 755 <<'ASSET_EOF'
@@ASSET:geomask-audit-state.py@@
ASSET_EOF
  save_stream /usr/lib/geomask/geomask-config-tx.py 755 <<'ASSET_EOF'
@@ASSET:geomask-config-tx.py@@
ASSET_EOF
  save_stream /usr/lib/geomask/geomask-config-owner.py 755 <<'ASSET_EOF'
@@ASSET:geomask-config-owner.py@@
ASSET_EOF
  save_stream /usr/lib/geomask/geomask-apply.py 755 <<'ASSET_EOF'
@@ASSET:geomask-apply.py@@
ASSET_EOF
  save_stream /usr/lib/geomask/geomask-lane-torrent.py 755 <<'ASSET_EOF'
@@ASSET:geomask-lane-torrent.py@@
ASSET_EOF
  save_stream /usr/lib/geomask/geomask-sync-youtube.py 755 <<'ASSET_EOF'
@@ASSET:geomask-sync-youtube.py@@
ASSET_EOF
  save_stream /usr/lib/geomask/geomask-audit-scheduler.py 755 <<'ASSET_EOF'
@@ASSET:geomask-audit-scheduler.py@@
ASSET_EOF
  save_stream /usr/lib/geomask/geomask-subscription-status.py 755 <<'ASSET_EOF'
@@ASSET:geomask-subscription-status.py@@
ASSET_EOF
  save_stream /usr/lib/geomask/geomask-slot-patch.py 755 <<'ASSET_EOF'
@@ASSET:geomask-slot-patch.py@@
ASSET_EOF
  save_stream /usr/bin/geo-backend.sh 755 <<'ASSET_EOF'
@@ASSET:geo-backend.sh@@
ASSET_EOF
  # Shared route-table helper: the ifup hotplug script and the backend both use it, so the
  # two copies of the mirroring logic can never drift apart (audit 14.11.2026, F01/F02).
  save_stream /usr/lib/geomask/geomask-routes.sh 644 <<'ASSET_EOF'
@@ASSET:geomask-routes.sh@@
ASSET_EOF
  save_stream /usr/lib/geomask/geomask-module-update.py 755 <<'ASSET_EOF'
@@ASSET:geomask-module-update.py@@
ASSET_EOF
  # v1.30.1: safe editor for the MagiTrickle lists (add/remove one domain at a time).
  save_stream /usr/lib/geomask/geomask-lists-edit.py 755 <<'ASSET_EOF'
@@ASSET:geomask-lists-edit.py@@
ASSET_EOF
  # v1.29.1: the diagnostics engine behind the "Диагностика" tab - checks, route trace, logs.
  save_stream /usr/lib/geomask/geomask-doctor.py 755 <<'ASSET_EOF'
@@ASSET:geomask-doctor.py@@
ASSET_EOF
  # v1.31.0: strict DNS with an emergency reserve (owner decision 14.11.2026).
  save_stream /usr/lib/geomask/geomask-dnsguard.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-dnsguard.sh@@
ASSET_EOF
  # v1.31.0: the console lane patcher (provider + select group + listener in one place).
  save_stream /usr/lib/geomask/geomask-console.py 755 <<'ASSET_EOF'
@@ASSET:geomask-console.py@@
ASSET_EOF
  # v1.31.0: the diagnostic bundle redactor (`uci show`, mihomo YAML, controller JSON,
  # log text) and the verify gate the backend runs before it packs anything.
  save_stream /usr/lib/geomask/geomask-diag-redact.py 755 <<'ASSET_EOF'
@@ASSET:geomask-diag-redact.py@@
ASSET_EOF
  save_stream /usr/lib/geomask/geomask-diag-spool.py 755 <<'ASSET_EOF'
@@ASSET:geomask-diag-spool.py@@
ASSET_EOF
  save_stream /etc/geomask/modules-index.json 644 <<'ASSET_EOF'
@@ASSET:module-index.json@@
ASSET_EOF
  # the updater caches the catalogue for an hour; right after an install that cache still
  # describes the previous release, so every file looked locally modified. Drop it here.
  rm -f "$(P /tmp)/geomask-modules-index.json" 2>/dev/null || true
  save_stream /usr/libexec/rpcd/geo-sync 755 <<'ASSET_EOF'
@@ASSET:geo-sync@@
ASSET_EOF
  save_stream /usr/share/rpcd/acl.d/luci-app-geo-sync.json 644 <<'ASSET_EOF'
@@ASSET:acl.json@@
ASSET_EOF

  # v1.30.3: the release identity of THIS router. The panel compares the GitHub release
  # against this file, so a leftover installer copy in /root cannot make it offer a downgrade.
  printf '%s\n' "$GM_VERSION" > "$(P /etc/geomask/version)" 2>/dev/null || true

  # Baseline for per-module updates: record the hashes and the versions we just installed
  # (--versions: files this release generates, like mihomo rulesets, are not byte-equal).
  [ -f /etc/geomask/modules-index.json ] && \
    python3 /usr/lib/geomask/geomask-module-update.py seed --versions \
      --index-file /etc/geomask/modules-index.json >/dev/null 2>&1 || true
  # v1.29.0: remember which modules this router carries (panel + per-module updater read it).
  modules_state_sync
  save_stream /usr/share/luci/menu.d/luci-app-geo-sync.json 644 <<'ASSET_EOF'
@@ASSET:menu.json@@
ASSET_EOF
  save_stream /www/luci-static/resources/view/geo-sync/main.js 644 <<'ASSET_EOF'
@@ASSET:geo-main.js@@
ASSET_EOF
  info "reloading rpcd + luci menu..."
  initd rpcd reload 2>/dev/null || true
  sleep 1
  # procd can coalesce the uninstall+install reload pair in --reinstall and drop
  # the second signal -> geo-sync stays unregistered; re-send until it appears.
  ubus list 2>/dev/null | grep -qx 'geo-sync' || { initd rpcd reload 2>/dev/null || true; sleep 2; }
  ubus list 2>/dev/null | grep -qx 'geo-sync' || { initd rpcd reload 2>/dev/null || true; sleep 2; }
  if module_selected backup_share; then
    ensure_smb_share || { bad "SMB share не создана (см. сообщения выше)"; return 1; }
  else
    info "пропущен: SMB-шар с бэкапами (модуль 'backup_share' не выбран)"
  fi
  # A write failure above must never be reported as a successful apply: the reinstall flow
  # used to continue and only check that the ubus object existed (audit 14.11.2026, F12).
  if [ "${SAVE_FAIL:-0}" != "${_save_before:-0}" ]; then
    bad "не все файлы записаны (ошибок: $((SAVE_FAIL - _save_before)))"
    return 1
  fi
  return 0
}
step2_verify() { step2_check; }

# ============================================================ STEP 3: mihomo 2-subscription config
MIHOMO_CONF=/etc/mihomo/config.yaml

step3_check() {
  _need=0
  if ! have mihomo; then bad "mihomo binary missing"; return 1; fi
  _c="$(P $MIHOMO_CONF)"
  if [ ! -s "$_c" ]; then bad "$MIHOMO_CONF missing (шаг subs при запуске создаст конфиг и спросит обе ссылки)"; return 1; fi
  _np=$(grep -c 'type: http' "$_c" 2>/dev/null || echo 0)
  if [ "$_np" -ge 1 ] 2>/dev/null; then info "proxy-providers: $_np (need >=1: VPN sub; AI borrows its USA nodes)"; else bad "proxy-providers: $_np (need >=1 VPN subscription)"; _need=1; fi
  for g in VPN-noP2P AI; do
    if grep -q "name: $g$" "$_c" 2>/dev/null; then info "slot $g: present"; else bad "slot $g: missing"; _need=1; fi
  done
  grep -qE '^[[:space:]]*- name: VPN$' "$_c" 2>/dev/null \
    && info "default tunnel group VPN: present (main lists ride the P2P-tolerant subscription)" \
    || info "default tunnel group VPN: absent (single tunnel - main lists ride VPN-noP2P)"
  grep -q 'RULE-SET,ai,AI' "$_c" 2>/dev/null && info "rule ai->AI: present" || { bad "rule ai->AI missing"; _need=1; }
  grep -qE 'RULE-SET,mtrickle,(VPN|VPN-noP2P)' "$_c" 2>/dev/null \
    && info "rule mtrickle->$(grep -oE 'RULE-SET,mtrickle,[A-Za-z0-9_-]+' "$_c" | head -1 | cut -d, -f3): present" \
    || { bad "rule mtrickle->VPN missing"; _need=1; }
  grep -q 'ai-devices' "$_c" 2>/dev/null && info "listeners (ai-devices): present" || { bad "listeners (ai-devices:7891) missing"; _need=1; }
  if grep -q 'torrent-direct' "$_c" 2>/dev/null; then
    # v1.23.1: the torrent listener is the P2P egress. It MUST be pinned to the P2P-tolerant
    # lane (VPN/sub2) or to DIRECT - NEVER to AI (AI is now node-relay, the provider that banned
    # the sub for BitTorrent) and never rule-based (then peers leak to node-relay via IP marks).
    # v1.29.0: the panel rewrites the config in flow style (`- name:` at column 0), the
    # installer writes block style - the parse must accept both, it used to demand 4 spaces.
    _tp=$(awk '
      /^[[:space:]]*-[[:space:]]*name:[[:space:]]*torrent-direct[[:space:]]*$/ {f=1; next}
      f && /^[[:space:]]*proxy:/ {sub(/^[[:space:]]*proxy:[[:space:]]*/,""); sub(/[[:space:]]+#.*/,""); print; exit}
      f && /^[[:space:]]*-[[:space:]]*name:/ {exit}
      f && /^[A-Za-z]/ {exit}' "$_c")
    case "$_tp" in
      VPN)    info "listener (torrent-direct:7894 -> VPN, P2P-tolerant): present" ;;
      DIRECT) info "listener (torrent-direct:7894 -> DIRECT): present (off node-relay; add the VPN lane to hide the real IP)" ;;
      AI)     bad "torrent listener pinned to AI = node-relay - P2P would re-ban the subscription"; _need=1 ;;
      '')     bad "torrent listener has no fixed policy - peers can reach node-relay via MagiTrickle IP marks"; _need=1 ;;
      *)      bad "torrent listener policy '$_tp' - expected VPN or DIRECT (never AI)"; _need=1 ;;
    esac
  else warn "torrent-direct listener missing (torrent clients cannot be pinned away from node-relay)"; fi
  grep -qE '^[[:space:]]*- SRC-PORT,41552,(VPN|VPN-noP2P|DIRECT)$' "$_c" 2>/dev/null \
    && info "torrent peer guard (SRC-PORT -> tolerant/DIRECT): present" \
    || warn "SRC-PORT,41552 guard absent or not on VPN-DIRECT - incoming peers may reach node-relay"
  # R01/P1 (v1.23.2): node-relay (VPN-noP2P) MagiTrickle groups must carry NO static IP
  # ranges - a bare-IP torrent peer matching one is fwmarked straight to the P2P-forbidden
  # provider, bypassing mihomo. Domain rules are fine (they route via DNS-learned ipsets).
  _mts="$(P /etc/magitrickle/state/config.yaml)"
  if [ -f "$_mts" ]; then
    _nrs=$(awk '/^  interface:/{r=($0 ~ /VPN-noP2P/)} r&&/^    type: subnet/{c++} END{print c+0}' "$_mts")
    [ "${_nrs:-0}" = "0" ] && info "node-relay groups: no static IP ranges (a torrent peer cannot be fwmarked to the forbidden sub)" \
      || bad "node-relay (VPN-noP2P) has $_nrs static IP range(s) - a torrent peer could match one; remove them (R01)"
  fi
  # v1.29.0: ports may be written as a flow list `[443, 8443, 5228]` or as a block list
  # (`ports:` + `- 5228`); the panel/mihomo rewrite uses the block form. Check the value
  # inside the sniffer section, not one particular spelling of it.
  if awk '/^sniffer:/{f=1; next} f && /^[A-Za-z]/{exit} f' "$_c" 2>/dev/null \
     | grep -qE '(^|[^0-9])5228([^0-9]|$)'; then
    info "sniffer TLS 5228 (Google push): present"
  else
    bad "sniffer TLS 5228 missing (B-017: Google push уходит DIRECT)"; _need=1
  fi
  grep -q '^ipv6: false' "$_c" 2>/dev/null && info "mihomo ipv6: false" || warn "mihomo ipv6: true — на роутере IPv6 отключён, рекомендуется false"
  grep -q 'DOMAIN-SUFFIX,youtube.com)),REJECT' "$_c" 2>/dev/null && info "QUIC reject (видео -> TCP): present" || warn "QUIC reject rules missing (B-016: тротлинг QUIC-видео)"
  grep -qE 'RULE-SET,ytvpn,(VPN|VPN-noP2P)' "$_c" 2>/dev/null && info "ytvpn rule: present" || warn "ytvpn rule missing (IP-blocked googlevideo edges won't route to a tunnel)"
  # v1.14.4: torrents must never be swallowed by the VPN lists (owner policy 30.10)
  # v1.21.7: the owner moved torrent/tracker domains from DIRECT onto the P2P-tolerant VPN
  # lane, so either target is correct now - only a missing ruleset is a problem.
  grep -qE 'RULE-SET,torrentsites,DIRECT' "$_c" 2>/dev/null \
    && info "torrent sites -> DIRECT (Cloudflare rejects the VPN exit)" \
    || warn "torrentsites rule missing - forum sites may return 502 through the VPN lane"
  grep -qE 'RULE-SET,torrentdirect,(DIRECT|VPN|VPN-noP2P)' "$_c" 2>/dev/null \
    && info "torrentdirect rule: present ($(awk -F, '/RULE-SET,torrentdirect/{print $3; exit}' "$_c"))" \
    || warn "torrentdirect rule missing (tracker domains can still go to the wrong subscription)"
  # v1.17.0: lane invariant. A torrent peer is always a bare IP, so no IP rule may reach the
  # subscription that forbids P2P. When the P2P-tolerant "VPN" lane exists the IP ruleset must be
  # split out into mtrickle_bulk.yaml and routed there.
  if grep -q 'name: VPN$' "$_c" 2>/dev/null; then
    if grep -qE '^\s*-\s*IP-CIDR' "$(P /etc/mihomo/ruleset/mtrickle.yaml)" 2>/dev/null; then
      bad "mtrickle.yaml still contains IP-CIDR rules - P2P peers can reach the restricted VPN-noP2P sub"
      _need=1
    else info "lane invariant: mtrickle.yaml has no IP rules"; fi
    grep -q 'RULE-SET,mtrickle_bulk,VPN' "$_c" 2>/dev/null \
      && info "lane: IP ruleset -> VPN (P2P-tolerant)" \
      || { bad "lane: mtrickle_bulk -> VPN rule missing"; _need=1; }
    grep -q 'RULE-SET,ytvpn,VPN' "$_c" 2>/dev/null \
      && info "lane: youtube edge pins -> VPN" \
      || warn "ytvpn pins still go to VPN-noP2P (bulk video traffic on a sub that may dislike it)"
  else
    info "lane: VPN not configured (single tunnel - IP rules stay on VPN-noP2P)"
  fi
  # v1.19.0: a port or protocol match is not a protocol classifier - any client can pick that
  # port, so nothing address-shaped may be routed to the subscription that forbids P2P.
  # Only meaningful when a separate P2P-tolerant lane exists: on a single-tunnel box the one
  # group is both, and port rules have nowhere else to go.
  if grep -qE '^[[:space:]]*- name: VPN-noP2P$' "$_c" 2>/dev/null && grep -qE '^[[:space:]]*- name: VPN$' "$_c" 2>/dev/null; then
    _np_bad=$(awk '/^rules:/{f=1;next} f&&/^[^ ]/{exit} f' "$_c" \
      | grep -E 'VPN-noP2P$' | grep -cE 'SRC-PORT|DST-PORT|IP-CIDR|NETWORK')
    if [ "${_np_bad:-0}" -gt 0 ]; then
      bad "$_np_bad rule(s) send ports/IPs/protocols to VPN-noP2P - a torrent client can just pick that port"
      _need=1
    else info "restricted slot takes domain rules only (no port/IP/protocol matches)"; fi
  fi
  if grep -qE '^[[:space:]]*- DST-PORT,(6969|1337|2710|8081|451|5944),' "$_c" 2>/dev/null; then
    bad "legacy blanket P2P DST-PORT rule present - it sits above the ai ruleset and hijacks AI relays on those ports"
    _need=1
  else
    info "no blanket P2P port rules (trackers pinned by torrentdirect only)"
  fi
  for rf in /etc/mihomo/ruleset/mtrickle.yaml /etc/mihomo/ruleset/ai.yaml /etc/mihomo/ruleset/ytdirect.yaml /etc/mihomo/ruleset/ytvpn.yaml /etc/mihomo/ruleset/torrentdirect.yaml; do
    if [ -s "$(P "$rf")" ]; then info "ruleset: $rf ($(grep -c 'DOMAIN-SUFFIX' "$(P "$rf")" 2>/dev/null || echo '?') suffixes)"; else warn "ruleset empty/missing: $rf (sync step will create)"; fi
  done
  if mihomo -d /etc/mihomo -t >/dev/null 2>&1; then info "mihomo -t: PASS"; else bad "mihomo -t: FAIL"; _need=1; fi
  return $_need
}
step3_apply() {
  _c="$(P $MIHOMO_CONF)"
  # v1.30.15: a foreign config is not "an existing config" - rewriting it loses tun, dns,
  # secret and every custom rule. Taking it over must be an explicit decision.
  if [ -s "$_c" ] && ! geomask_config_shaped "$_c" && [ "${GM_ADOPT:-0}" != 1 ] \
     && [ "${GM_REPLACE:-0}" != 1 ]; then
    bad "на роутере свой конфиг mihomo, и он не от geomask"
    info "  Перезапись шаблоном потеряет tun/dns/secret и ваши правила - этого не будет."
    info "  Варианты:"
    info "    sh $0 --adopt-config --vpn-url '<ссылка>' --auto   взять конфиг под управление"
    info "    полная замена шаблоном (потеря tun/dns/secret): --replace-config"
    info "    или перенесите подписку/группы вручную и запустите без --adopt-config"
    return 1
  fi
  _vpnu="$GM_VPN_URL"
  if [ -s "$_c" ]; then
    [ -z "$_vpnu" ] && _vpnu=$(_prov_url "$_c" sub)
    [ -z "$_vpnu" ] && _vpnu=$(any_provider_url "$_c")
  fi
  # v1.23.0: AI no longer has its own subscription - it borrows node-relay (sub) and keeps only
  # USA nodes (v1.22.8). Only the VPN subscription URL is required; the old AI sub (de5) is retired.
  if [ -z "$_vpnu" ]; then
    if [ "$GM_AUTO" != 1 ] && [ "$GM_YES" != 1 ] && [ -t 0 ]; then
      info "Подписка не задана — введите ссылку (общая VPN-подписка; AI берёт из неё USA-узлы)"
      _vpnu=$(prompt_url "Ссылка на ОБЩУЮ VPN-подписку" "" "") || { bad "URL VPN-подписки не задан"; return 1; }
    else
      bad "subscription URL unknown - pass --vpn-url (or keep existing config)"
      return 1
    fi
  fi
  info "VPN provider URL: $(_maskurl "$_vpnu")"
  ask "  Write mihomo config (VPN sub + AI USA from it; backup kept)?" || { warn "skipped"; return 1; }
  write_mihomo_config "$_vpnu" "" || return 1
  if [ "$GM_RESTART" = 1 ]; then
    # A failed restart is a failed step: `|| true` reported success while the candidate was
    # rolled back and the VPN never came up with the new config.
    safe_mihomo_restart || { bad "mihomo restart failed - шаг 3 не завершён"; return 1; }
  elif api_refresh_provider sub "$_vpnu"; then
    info "providers refreshed via API (no restart, VPN stays up)"
  elif svc_alive mihomo; then
    warn "mihomo is running: restart later to apply (rerun with --restart)"
  else
    info "starting mihomo..."
    if initd mihomo start >/dev/null 2>&1; then
      info "mihomo started"
    else
      bad "mihomo не запустился - проверьте: logread | tail -20"
      return 1
    fi
  fi
  return 0
}
step3_verify() { step3_check; }

# write a fresh 2-provider mihomo config: write_mihomo_config <vpn_url> <ai_url>
# validates with `mihomo -t`, keeps backup of the previous config; no restart here.
write_mihomo_config() {
  _c="$(P $MIHOMO_CONF)"
  _vpnu="$1"; _aiu="$2"
  # The rollback source must be the file as it was BEFORE this run touched it. The old code
  # copied the already-replaced file in safe_mihomo_restart, so "rollback" restored the
  # broken candidate.
  _lanip=$(lan_ip)
  if [ -z "$_lanip" ]; then
    bad "не удалось определить адрес LAN ($(lan_iface)) - listener некуда привязать"
    info "  Проверьте: uci show network.lan; ip -4 addr show $(lan_iface)"
    return 1
  fi
  if [ -s "$_c" ] && [ -z "${GM_PRE_CONFIG:-}" ]; then
    GM_PRE_CONFIG="$_c.pre-run-$(date +%s 2>/dev/null || echo pre)"
    cp -p "$_c" "$GM_PRE_CONFIG" 2>/dev/null || GM_PRE_CONFIG=""
  fi
  # v1.30.19: the guard used to live only in step3_apply, so --reinstall (which calls this
  # function directly) rewrote an owner's config with the template. It belongs here.
  # --replace-config IS the owner's explicit decision to replace a foreign config, so it must
  # pass this guard - the flag used to be offered in the message and then rejected (F16).
  if [ -s "$_c" ] && ! geomask_config_shaped "$_c" && [ "${GM_ADOPT:-0}" != 1 ] \
     && [ "${GM_REPLACE:-0}" != 1 ]; then
    bad "на роутере свой конфиг mihomo - шаблон поверх него не пишется"
    info "  Взять его под управление без потери настроек: --adopt-config"
    info "  Полная замена шаблоном (tun/dns/secret и ваши правила будут потеряны): --replace-config"
    return 1
  fi
  # --- existing 2-subscription config: keep it as-is (custom rules, headers, sniffer)
  #     and only patch provider urls / ensure the ai-devices listener ---
  # --- existing config: keep it as-is (custom rules, headers, sniffer) and only patch
  #     provider urls / ensure the ai-devices listener. v1.23.0: de5 (the retired un1.pro AI
  #     sub) is no longer required and is stripped if still present; AI rides `sub`.
  # --replace-config means "replace the file", not "maybe patch it": the in-place branch used
  # to swallow the flag and keep the old secret, so the requested rewrite never happened.
  if [ -s "$_c" ] && [ "${GM_REPLACE:-0}" != 1 ] && geomask_config_shaped "$_c"; then
    if grep -qE '^  de5:[[:space:]]*$' "$_c"; then
      cp -p "$_c" "$_c.bak_geomask_$(date +%s)" || true
      awk 'BEGIN{sect="";d=0}
        /^[A-Za-z0-9_-]+:/ {sect=$1; sub(/:.*/,"",sect)}
        sect=="proxy-providers" && /^  de5:[[:space:]]*$/ {d=1; next}
        d && /^  [A-Za-z0-9_-]+:/ {d=0}
        d && /^[A-Za-z]/ {d=0}
        !d {print}' "$_c" > "$_c.de5rm" \
        && mihomo_validate "$_c.de5rm" && mv -f "$_c.de5rm" "$_c" && rm -f "$_c.de5rm" \
        && info "retired de5 provider removed from config" || { rm -f "$_c.de5rm"; warn "de5 removal skipped (validation)"; }
    fi
    _curv=$(_prov_url "$_c" sub)
    if [ -n "${_vpnu:-}" ] && [ "$_vpnu" != "$_curv" ]; then
      cp -p "$_c" "$_c.bak_geomask_$(date +%s)" || true
      # Patch `proxy-providers.sub.url` only. The old pattern matched ANY `  sub:` line, so a
      # `rule-providers.sub` received the VPN subscription URL (audit 14.11.2026, F06).
      if ! awk -v nu="$_vpnu" '
        BEGIN{sect="";f=0;done=0}
        /^[A-Za-z0-9_-]+:/ {sect=$1; sub(/:.*/,"",sect); if (sect != "proxy-providers") f=0}
        sect=="proxy-providers" && /^  [A-Za-z0-9_-]+:/ {
          name=$1; sub(/:.*/,"",name); f=(name=="sub")
        }
        f && /^    url:/ {print "    url: \"" nu "\""; done=1; f=0; next}
        {print}
        END{exit done?0:1}' "$_c" > "$_c.urlnew"; then
        rm -f "$_c.urlnew"; bad "provider url patch failed - точечное обновление невозможно, нужен --replace-config"; return 1
      fi
      mihomo_validate "$_c.urlnew" && mv -f "$_c.urlnew" "$_c" || { rm -f "$_c.urlnew"; bad "mihomo -t failed - config kept"; return 1; }
      info "provider url updated in place (sub)"
    fi
    if ! grep -q 'ai-devices' "$_c"; then
      cp -p "$_c" "$_c.bak_geomask_$(date +%s)" || true
      awk -v L="$_lanip" 'BEGIN{d=0}
        /^proxy-providers:/ && !d {print "listeners:";print "  - name: ai-devices";print "    type: mixed";print "    port: 7891";print "    listen: 127.0.0.1";print "    proxy: AI";print "  - name: torrent-direct";print "    type: mixed";print "    port: 7894";print "    listen: " L;print "";d=1}
        {print}' "$_c" > "$_c.zmnew" || return 1
      if mihomo_validate "$_c.zmnew"; then
        mv -f "$_c.zmnew" "$_c"; info "listeners block added to existing config (custom rules preserved)"
      else
        rm -f "$_c.zmnew"; bad "mihomo -t failed after adding listeners - config kept"; return 1
      fi
    else
      # v1.14.4: config already had listeners - make sure the torrent DIRECT one exists
      if ! grep -q 'torrent-direct' "$_c"; then
        cp -p "$_c" "$_c.bak_geomask_$(date +%s)" || true
        awk -v L="$_lanip" 'BEGIN{d=0} {print} (!d && $0 ~ /^    proxy: AI$/) {
              print "  - name: torrent-direct"; print "    type: mixed"; print "    port: 7894";
              print "    listen: " L; d=1 }' "$_c" > "$_c.tdnew" || return 1
        if mihomo_validate "$_c.tdnew"; then
          mv -f "$_c.tdnew" "$_c"; info "torrent-direct listener added (listeners already present)"
        else
          rm -f "$_c.tdnew"; bad "mihomo -t failed after adding torrent-direct - config kept"; return 1
        fi
      else
        info "existing 2-subscription config kept as-is (ai-devices + torrent-direct present)"
      fi
    fi
    # A controller bound to 0.0.0.0 (often without a secret) lets any LAN device switch nodes
    # and read connections. The template always used loopback; the in-place path did not, so
    # updated routers kept the old exposure (audit follow-up).
    _ec=$(grep -E '^external-controller:' "$_c" 2>/dev/null | head -1)
    case "$_ec" in
      ''|*127.0.0.1*|*localhost*) ;;
      *)
        cp -p "$_c" "$_c.bak_geomask_$(date +%s)" || true
        if sed 's|^external-controller:.*|external-controller: 127.0.0.1:9090|' "$_c" > "$_c.ecnew" \
           && mihomo_validate "$_c.ecnew" && mv -f "$_c.ecnew" "$_c"; then
          info "external-controller moved to 127.0.0.1:9090 (LAN devices could switch nodes)"
        else
          rm -f "$_c.ecnew"; warn "external-controller not changed (validation) - check it manually"
        fi
        ;;
    esac
    chmod 600 "$_c" 2>/dev/null
    return 0
  fi
  # The template below replaces the whole file. Reaching it with an existing config means
  # the in-place branch did not match, and rewriting would silently drop tun/dns/secret and
  # the owner's rules - even for a config that passed the ownership check. Only an explicit
  # --replace-config may do that.
  if [ -s "$_c" ] && [ "${GM_REPLACE:-0}" != 1 ]; then
    bad "точечное обновление конфига невозможно - шаблон поверх существующего не пишется"
    info "  Полная замена с потерей tun/dns/secret и ваших правил: --replace-config (бэкап сохраняется)"
    return 1
  fi
  if [ -s "$_c" ]; then warn "полная замена конфига mihomo по --replace-config (прежний файл в бэкапе)"; fi
  _hwid=$(grep -A1 'x-hwid' "$_c" 2>/dev/null | sed -n 's/^[[:space:]]*-[[:space:]]*"\(.*\)"/\1/p' | head -1)
  _tmpconf="$_c.zmnew"
  {
    printf '%s\n' '# geomask-managed: 1'
    printf '%s\n' 'mixed-port: 7890'
    printf '%s\n' 'allow-lan: true'
    printf '%s\n' 'bind-address: "0.0.0.0"'
    printf '%s\n' 'tcp-concurrent: true'
    printf '%s\n' 'mode: rule'
    printf '%s\n' 'log-level: info'
    printf '%s\n' 'ipv6: false'
    # Loopback only: every geomask client already talks to 127.0.0.1:9090, and a controller
    # bound to 0.0.0.0 with no secret let any LAN device switch nodes and read connections.
    printf '%s\n' 'external-controller: 127.0.0.1:9090'
    printf '%s\n' 'external-ui: ui'
    printf '%s\n' 'unified-delay: true'
    printf '%s\n' 'find-process-mode: off'
    printf '%s\n' 'profile:'
    printf '%s\n' '  store-selected: true'
    printf '%s\n' '  store-fake-ip: true'
    printf '\n'
    printf '%s\n' 'listeners:'
    printf '%s\n' '  - name: ai-devices'
    printf '%s\n' '    type: mixed'
    printf '%s\n' '    port: 7891'
    printf '%s\n' '    listen: 127.0.0.1'
    printf '%s\n' '    proxy: AI'
    printf '%s\n' '  # torrent clients point here (SOCKS5/HTTP). Fresh installs have no RESERVE lane,'
    printf '%s\n' '  # so a fixed policy is REQUIRED: without it the rule chain decides and peers on'
    printf '%s\n' '  # hosting-provider IPs land on the VPN sub (that is what got it blocked, 31.10).'
    printf '%s\n' '  # DIRECT keeps P2P off the VPN sub entirely; switch to AI if your VPN sub is the'
    printf '%s\n' '  # only usable tunnel, or drop the policy once a RESERVE lane takes the IP rules.'
    printf '%s\n' '  - name: torrent-direct'
    printf '%s\n' '    type: mixed'
    printf '%s\n' '    port: 7894'
    printf '    listen: %s\n' "$_lanip"
    printf '%s\n' '    proxy: DIRECT'
    printf '\n'
    printf '%s\n' 'proxy-providers:'
    printf '%s\n' '  sub:'
    printf '%s\n' '    type: http'
    printf '%s\n' '    proxy: DIRECT'
    if [ -n "${_hwid:-}" ]; then
      printf '%s\n' '    header:'
      printf '%s\n' '      x-hwid:'
      printf '%s\n' "        - \"$_hwid\""
    fi
    printf '%s\n' "    url: \"$_vpnu\""
    printf '%s\n' '    interval: 3600'
    # NO provider health-check on purpose (v1.21.3): mihomo removes nodes that fail it from the
    # group, so a slow or briefly unreachable subscription silently empties the lane and every
    # rule pointing at it starts returning 502. The proxy-group tests are enough.
    printf '\n'
    printf '%s\n' 'proxy-groups:'
    printf '%s\n' '  # slot VPN-noP2P: the subscription whose provider forbids P2P (default tunnel).'
    printf '%s\n' '  # A second, P2P-tolerant tunnel (slot VPN -> group "VPN") is created by the panel'
    printf '%s\n' '  # when a subscription is assigned to it; IP rules then move over there.'
    printf '%s\n' '  - name: VPN-noP2P'
    printf '%s\n' '    type: url-test'
    printf '%s\n' '    use:'
    printf '%s\n' '      - sub'
    printf '%s\n' '    exclude-filter: "Россия|Мобильный|РФ|Авто|Russia|Mobile|Auto|Албания|Хорватия|Литва|Латвия|Дания|Финляндия|Нидерланды-(5|13|16|18)($|[^0-9])|Германия-[234]($|[^0-9])|США-1($|[^0-9])|Турция"'
    printf '%s\n' '    url: "https://www.gstatic.com/generate_204"'
    printf '%s\n' '    interval: 180'
    printf '%s\n' '    tolerance: 99999'
    printf '%s\n' '    lazy: false'
    printf '%s\n' '  # AI lane: v1.22.8 - AI borrows the node-relay subscription (sub) and keeps only'
    printf '%s\n' '  # its genuine-USA nodes (the old un1.pro AI sub routed OpenAI via a Helsinki relay'
    printf '%s\n' '  # -> unsupported_country). v1.22.9 guards the egress nightly; v1.23.0 retires de5.'
    printf '%s\n' '  - name: AI'
    printf '%s\n' '    type: url-test'
    printf '%s\n' '    use:'
    printf '%s\n' '      - sub'
    printf '%s\n' "    filter: 'USA'"
    printf '%s\n' "    exclude-filter: 'HY2'"
    printf '%s\n' '    url: "https://www.gstatic.com/generate_204"'
    printf '%s\n' '    interval: 180'
    printf '%s\n' '    tolerance: 99999'
    printf '%s\n' '    lazy: false'
    printf '\n'
    printf '%s\n' 'rule-providers:'
    printf '%s\n' '  ai:'
    printf '%s\n' '    type: file'
    printf '%s\n' '    behavior: classical'
    printf '%s\n' '    path: /etc/mihomo/ruleset/ai.yaml'
    printf '%s\n' '  mtrickle:'
    printf '%s\n' '    type: file'
    printf '%s\n' '    behavior: classical'
    printf '%s\n' '    path: /etc/mihomo/ruleset/mtrickle.yaml'
    printf '%s\n' '  ytdirect:'
    printf '%s\n' '    type: file'
    printf '%s\n' '    behavior: classical'
    printf '%s\n' '    path: /etc/mihomo/ruleset/ytdirect.yaml'
    printf '%s\n' '  ytvpn:'
    printf '%s\n' '    type: file'
    printf '%s\n' '    behavior: classical'
    printf '%s\n' '    path: /etc/mihomo/ruleset/ytvpn.yaml'
    printf '%s\n' '  torrentdirect:'
    printf '%s\n' '    type: file'
    printf '%s\n' '    behavior: classical'
    printf '%s\n' '    path: /etc/mihomo/ruleset/torrentdirect.yaml'
    printf '%s\n' '  torrentsites:'
    printf '%s\n' '    type: file'
    printf '%s\n' '    behavior: classical'
    printf '%s\n' '    path: /etc/mihomo/ruleset/torrentsites.yaml'
    printf '\n'
    printf '%s\n' 'rules:'
    printf '%s\n' '  # AUTO-SYNC from magitrickle: /root/sync_mtrickle_mihomo.sh - DO NOT EDIT MANUALLY'
    printf '%s\n' '  # v1.15.0: no blanket DST-PORT rules for P2P - they sat ABOVE the ai ruleset and'
    printf '%s\n' '  # hijacked AI relays that happen to use those ports. Trackers are pinned by the'
    printf '%s\n' '  # torrentdirect ruleset below (managed by geomask-torrent.sh).'
    printf '%s\n' '  # v1.20.0: the old hand-written "DOMAIN-SUFFIX,rutracker.*,DIRECT" pins were removed.'
    printf '%s\n' '  # Torrent sites belong in a MagiTrickle group on a direct interface - that is the'
    printf '%s\n' '  # single place where direction is decided; a pin above the rules silently outranks'
    printf '%s\n' '  # whatever group the owner puts the domain in.'
    printf '%s\n' '  # QUIC forced to TCP for video hosts (RKN UDP-443 throttle, B-016)'
    printf '%s\n' '  - AND,((NETWORK,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,googlevideo.com)),REJECT'
    printf '%s\n' '  - AND,((NETWORK,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,youtube.com)),REJECT'
    printf '%s\n' '  - AND,((NETWORK,UDP),(DST-PORT,443),(DOMAIN-SUFFIX,youtu.be)),REJECT'
    printf '%s\n' '  # v1.25.0: ALL Yandex domains go DIRECT (RU). Yandex Go / Plus / Bank are geo-'
    printf '%s\n' '  # sensitive and break on any non-RU exit; the app uses yandex-net.ru /'
    printf '%s\n' '  # yandexcom.net which are NOT covered by the yandex.ru/.net namespace. These'
    printf '%s\n' '  # are also listed in /etc/geomask/zapret-always-exclude.txt so nfqws never'
    printf '%s\n' '  # DPI-mangles them (owner: Yandex must bypass zapret too).'
    for _yd in yandex.ru yandex.net yandex.com yandex.com.tr yandexcloud.net yandex-net.ru yandexcom.net yandex-team.ru yastatic.net yasandbox.net ya.ru yandex.kz yandex.by yandex.az yandex.am yandex.ge yandex.tj yandex.tm yandex.uz yandex.md yandex.aero yandex.co.il yandex.eu yandex.lt yandex.lv yandex.ee; do
      printf '  - DOMAIN-SUFFIX,%s,DIRECT\n' "$_yd"
    done
    printf '%s\n' '  - RULE-SET,ytvpn,VPN-noP2P'
    printf '%s\n' '  - RULE-SET,ytdirect,DIRECT'
    printf '%s\n' '  - DOMAIN-SUFFIX,cloudflare-ech.com,AI'
    printf '%s\n' '  - RULE-SET,ai,AI'
    printf '%s\n' '  # torrent tracker endpoints (public lists) - DIRECT, after ai so the AI policy always wins'
    printf '%s\n' '  # v1.22.0: forum/catalog sites stay DIRECT - Cloudflare rejects the VPN exit'
    printf '%s\n' '  # IPs, so routing them to a VPN makes them unreachable (measured 502 vs 301).'
    printf '%s\n' '  - RULE-SET,torrentsites,DIRECT'
    printf '%s\n' '  - RULE-SET,torrentdirect,VPN-noP2P'
    printf '%s\n' '  # torrent client listening port: peers that dial US must not reach the VPN slot;'
    printf '%s\n' '  # with a RESERVE/VPN lane configured geomask repoints this to that lane'
    printf '%s\n' '  - SRC-PORT,41552,DIRECT'
    printf '%s\n' '  - RULE-SET,mtrickle,VPN-noP2P'
    printf '%s\n' '  # STUN: stop WebRTC leaking the real (RU) IP, keep calls working'
    printf '%s\n' '  - AND,((NETWORK,udp),(DST-PORT,3478)),VPN-noP2P'
    printf '%s\n' '  - AND,((NETWORK,udp),(DST-PORT,19302)),VPN-noP2P'

    printf '%s\n' '  - MATCH,GLOBAL'
    printf '\n'
    printf '%s\n' 'sniffer:'
    printf '%s\n' '  enable: true'
    printf '%s\n' '  parse-pure-ip: true'
    printf '%s\n' '  override-destination: true'
    printf '%s\n' '  sniff:'
    printf '%s\n' '    HTTP:'
    printf '%s\n' '      ports: [80, 8080-8880]'
    printf '%s\n' '    TLS:'
    printf '%s\n' '      ports: [443, 8443, 5228]'
    printf '%s\n' '    QUIC:'
    printf '%s\n' '      ports: [443, 8443]'
  } > "$_tmpconf" || { bad "cannot write $_tmpconf"; return 1; }
  # ruleset files must exist before mihomo -t
  mkdir -p "$(P /etc/mihomo/ruleset)"
  for rf in mtrickle ai ytdirect ytvpn torrentdirect torrentsites; do
    [ -s "$(P /etc/mihomo/ruleset/$rf.yaml)" ] || printf 'payload: []\n' > "$(P /etc/mihomo/ruleset/$rf.yaml)"
  done
  if mihomo_validate "$_tmpconf"; then
    info "mihomo -t on new config: PASS"
  else
    bad "mihomo -t FAILED on new config - keeping old"; rm -f "$_tmpconf"; return 1
  fi
  if [ -f "$_c" ]; then cp -p "$_c" "$_c.bak_geomask_$(date +%s 2>/dev/null || echo bak)"; fi
  # The config carries subscription URLs and the controller secret: root-only.
  chmod 600 "$_tmpconf" 2>/dev/null
  mv -f "$_tmpconf" "$_c" || { bad "cannot install new config"; return 1; }
  chmod 600 "$_c" 2>/dev/null
  info "config installed"
  return 0
}

# runtime provider refresh through mihomo API - NO restart, VPN stays up
api_refresh_provider() { # api_refresh_provider <name> <url>
  [ -n "${2:-}" ] || return 1
  # re-read config from file (re-fetches provider subscription)
  controller_curl -s -m15 -f -X PUT "http://127.0.0.1:9090/configs" \
    -H 'Content-Type: application/json' \
    -d "{\"path\":\"/etc/mihomo/config.yaml\"}" >/dev/null 2>&1
}

# ============================================================ SAFETY layer
# full settings backup (restorable via LuCI) - MANDATORY before any router change
# v1.9.0: stored persistently in /root/geomask-backups/ (retention: freshest one - replaced by
#         the next successful backup; full history lives on the PC via fetch_backup.ps1).
#         Built in /tmp first, then moved: sysupgrade -b archives /root, so an existing copy
#         must not be present while the new one is created (that nesting bloated archives in
#         v1.6-1.8). The folder is published read-only over SMB (share 'geomask-backups',
#         see ensure_smb_share) and linked from the panel.
BACKUP_KEEP=1          # freshest copy on the router; full history lives on the PC
BACKUP_RECOVERY=/etc/geomask/backup-recovery

# Diagnostics of the backup path must reach the operator even when the function runs inside
# a command substitution: `_bk=$(ensure_backup full)` used to swallow every warning,
# including the path of the only remaining copy (audit 14.11.2026, F03).
_bnote() { printf '  %s\n' "$*" >&2; }
_bwarn() { printf '  [WARN] %s\n' "$*" >&2; }
_bbad() { printf '  [FAIL] %s\n' "$*" >&2; }

# A non-empty file is not a backup: sysupgrade can return 0 and still leave a truncated or
# empty archive, and that file used to replace the last good copy during rotation.
archive_ok() { # archive_ok <file> -> 0 only for a readable tar.gz that carries a router tree
  # A gzip stream is not an archive: `gzip -t` accepts arbitrary compressed bytes, and such a
  # file then replaced the last good backup. The table of contents is the only proof that
  # sysupgrade produced a tar at all, so no fallback is allowed when tar is missing.
  [ -s "$1" ] || return 1
  have tar || return 1
  tar -tzf "$1" >/dev/null 2>&1 || return 1
  # A readable tar of one arbitrary file is not a router backup: sysupgrade always archives
  # /etc, so at least one etc/ entry must be present (audit 14.11.2026, F29).
  tar -tzf "$1" 2>/dev/null | grep -qE '(^|/)etc/' || return 1
  # CRC/length of the whole stream: tar can stop at the first damaged member and still exit 0
  if have gzip; then gzip -t "$1" >/dev/null 2>&1 || return 1; fi
  return 0
}

_backup_park_restore() { # _backup_park_restore <park> <dir> -> 0 only when every parked copy is back
  _rp_ok=1
  for _rp in "$1"/*.tar.gz; do
    [ -f "$_rp" ] || continue
    mv -f "$_rp" "$2/" 2>/dev/null || { _rp_ok=0; _bwarn "не удалось вернуть $(basename "$_rp") - копия осталась в $1"; }
  done
  [ "$_rp_ok" = 1 ] && rm -rf "$1"
  return $((1 - _rp_ok))
}

_backup_recovery_write() { # _backup_recovery_write <park> <reason>
  mkdir -p "$(dirname "$(P $BACKUP_RECOVERY)")" 2>/dev/null || return 1
  { printf 'park=%s\n' "$1"; printf 'reason=%s\n' "$2"; printf 'ts=%s\n' "$(date +%FT%T 2>/dev/null)"; } \
    > "$(P $BACKUP_RECOVERY).tmp" 2>/dev/null || return 1
  mv -f "$(P $BACKUP_RECOVERY).tmp" "$(P $BACKUP_RECOVERY)" 2>/dev/null
}

_backup_recovery_park() { sed -n 's/^park=//p' "$(P $BACKUP_RECOVERY)" 2>/dev/null | head -1; }

_backup_recovery_clear() { rm -f "$(P $BACKUP_RECOVERY)" 2>/dev/null; }

_backup_keep_failed() { # a parked copy could not be returned: keep it and say exactly where
  _bkf_park=$1
  _backup_recovery_write "$_bkf_park" "restore failed"
  _bbad "прежняя резервная копия осталась в $_bkf_park"
  _bbad "  перенесите её вручную: mv $_bkf_park/*.tar.gz $(P $BACKUP_DIR)/"
  _bbad "  путь записан в $(P $BACKUP_RECOVERY); следующая попытка сначала восстановит её"
}

ensure_backup() { # ensure_backup [full|any] -> path on stdout, rc=1 on failure
  # v1.30.15: the previous archive is no longer deleted before the new one exists, and a
  # reduced tar is never passed off as a sysupgrade backup. Old copies are parked outside
  # /root while sysupgrade archives /root (that nesting was the reason for the old delete),
  # and they come back untouched if creation fails.
  _mode="${1:-full}"
  _ts=$(date +%Y%m%d-%H%M%S 2>/dev/null || echo bak)
  _dir="$(P $BACKUP_DIR)"
  mkdir -p "$_dir" 2>/dev/null || { _bbad "cannot create $_dir"; return 1; }
  # A previous run may have left the only copy parked. Recover it BEFORE touching anything,
  # and refuse to continue while it is still there: two runs in one shell used to delete the
  # same park with `rm -rf` at the start of the next attempt (audit 14.11.2026, F03).
  _prev=$(_backup_recovery_park)
  if [ -n "$_prev" ]; then
    if [ -d "$_prev" ] && ls "$_prev"/*.tar.gz >/dev/null 2>&1; then
      if ! _backup_park_restore "$_prev" "$_dir"; then
        _bbad "в $_prev остаётся резервная копия, вернуть её автоматически не удалось"
        _bbad "  перенесите вручную: mv $_prev/*.tar.gz $_dir/"
        return 1
      fi
      _bnote "восстановлены ранее отложенные копии из $_prev"
    fi
    _backup_recovery_clear
  fi
  # Unique park per attempt, created with mktemp: never reuse (and never remove) a directory
  # that may still hold the last copy.
  _park=$(mktemp -d "$(P /tmp)/geomask-bk-park-XXXXXX" 2>/dev/null) || { _bbad "cannot create a park directory"; return 1; }
  _park_fail=0
  for _old in "$_dir"/router-backup-*.tar.gz; do
    [ -f "$_old" ] || continue
    # A copy that cannot be parked stays inside /root and would end up nested in the new
    # archive. Stop here, before anything is created: no mutation has happened yet.
    mv -f "$_old" "$_park/" 2>/dev/null || _park_fail=1
  done
  if [ "$_park_fail" = 1 ]; then
    _backup_park_restore "$_park" "$_dir" || _backup_keep_failed "$_park"
    _bbad "не удалось убрать прежние копии из $_dir - бэкап не создавался"
    return 1
  fi
  _tmp="$(P /tmp)/geomask-bk-$_ts.tar.gz"
  rm -f "$_tmp"
  _full=0
  _su_err=""
  if have sysupgrade; then
    _su_err=$(sysupgrade -b "$_tmp" 2>&1) && archive_ok "$_tmp" && _full=1
  else
    _su_err="sysupgrade not found"
  fi
  if [ "$_full" = 0 ]; then
    rm -f "$_tmp"
    if [ "$_mode" = full ]; then
      # put the parked copies back: a failed run must not cost the router its only backup
      _backup_park_restore "$_park" "$_dir" || _backup_keep_failed "$_park"
      _bbad "полный бэкап (sysupgrade -b) не создан"
      [ -n "$_su_err" ] && _bnote "sysupgrade: $(printf '%s' "$_su_err" | tail -2 | tr '\n' ' ')"
      return 1
    fi
    _tmp="$(P /tmp)/geomask-bk-$_ts-partial.tar.gz"
    if ! tar czf "$_tmp" -C "$(P /)" etc root >/dev/null 2>&1 || ! archive_ok "$_tmp"; then
      rm -f "$_tmp"
      _backup_park_restore "$_park" "$_dir" || _backup_keep_failed "$_park"
      _bbad "cannot create backup"
      return 1
    fi
    _bwarn "полный бэкап не создан - сохранена частичная копия (etc + root)"
  fi
  if [ "$_full" = 1 ]; then
    _dest="$_dir/router-backup-$_ts.tar.gz"
  else
    _dest="$_dir/router-backup-$_ts-partial.tar.gz"
  fi
  if ! mv -f "$_tmp" "$_dest" || ! archive_ok "$_dest"; then
    rm -f "$_tmp"
    [ -f "$_dest" ] && rm -f "$_dest"
    _backup_park_restore "$_park" "$_dir" || _backup_keep_failed "$_park"
    _bbad "cannot store a verified backup into $_dir"
    return 1
  fi
  chmod 600 "$_dest" 2>/dev/null
  # Record the archive as verified: the panel's write gate accepts only an archive a backup
  # creator checked (a fresh mtime alone proves nothing).
  mkdir -p "$(dirname "$(P /etc/geomask/backup-ok)")" 2>/dev/null
  { printf 'file=%s\n' "$_dest"; printf 'ts=%s\n' "$(date +%s)"; } > "$(P /etc/geomask/backup-ok).tmp" 2>/dev/null \
    && mv -f "$(P /etc/geomask/backup-ok).tmp" "$(P /etc/geomask/backup-ok)" 2>/dev/null
  # rotation happens only now, and never touches the copy just written
  _n=0
  for _old in $(ls -1t "$_dir"/router-backup-*.tar.gz 2>/dev/null); do
    _n=$((_n+1))
    [ "$_n" -gt "$BACKUP_KEEP" ] && [ "$_old" != "$_dest" ] && rm -f "$_old"
  done
  rm -rf "$_park"
  printf '%s' "$_dest"
  return 0
}

backup_gate() { # a verified full backup before the first write of this run
  [ "${GM_BACKUP_DONE:-0}" = 1 ] && return 0
  _bk=$(ensure_backup full) || {
    bad "нет полного бэкапа - изменения на роутере не начинаются"
    info "  Причина и путь сохранённой копии напечатаны выше (stderr)."
    info "  LuCI -> Система -> Резервная копия / Обновление прошивки -> Создать архив"
    return 1
  }
  GM_BACKUP_DONE=1
  GM_BACKUP_PATH="$_bk"
  info "полный бэкап: $_bk"
  return 0
}

# publish the backup folder over SMB via the existing ksmbd server. Publishing a full
# sysupgrade archive (network passwords, keys, subscription URLs) is an explicit decision,
# so the share is created only when the owner opted in with the marker file.
#
# Ownership rule (audit 14.11.2026, F04): a section is ours only when its `name` is
# geomask-backups. Anonymous `@share[N]` references are NEVER cached across a delete - uci
# renumbers them, so a saved index can point at a foreign share after one removal and the
# next write would repoint that share at /root/geomask-backups. Every delete re-reads the
# list, and sections that are not ours are never modified or removed.
_smb_sections() { uci -q show ksmbd 2>/dev/null | sed -n 's/^\(ksmbd\.[^=]*\)=share$/\1/p'; }
_smb_ours() { # prints our section ids, one per line
  for _so in $(_smb_sections); do
    [ "$(uci -q get "$_so.name" 2>/dev/null)" = "$SMB_SHARE_NAME" ] && printf '%s\n' "$_so"
  done
}

ensure_smb_share() {
  _init=""
  for c in ksmbd1 ksmbd; do
    [ -x "$(P /etc/init.d/$c)" ] && _init=$c && break
  done
  [ -n "$_init" ] || { info "ksmbd not installed - SMB share for backups skipped (folder still local)"; return 0; }
  have uci || { warn "no uci - SMB share skipped"; return 0; }
  # A new folder is private; an existing one is left as the owner made it.
  if [ ! -d "$(P $BACKUP_DIR)" ]; then
    mkdir -p "$(P $BACKUP_DIR)" 2>/dev/null && chmod 700 "$(P $BACKUP_DIR)" 2>/dev/null
  fi
  _ours=$(_smb_ours)
  if [ ! -f "$(P $SMB_SHARE_ENABLE)" ]; then
    # Nothing is changed here: not the share, not ksmbd, not the accounts. An old share is
    # reported with its actual access rules instead of being silently "hardened".
    if [ -n "$_ours" ]; then
      _s=$(printf '%s\n' "$_ours" | head -1)
      _go=$(uci -q get "$_s.guest_ok" 2>/dev/null)
      _fr=$(uci -q get "$_s.force_root" 2>/dev/null)
      info "SMB share '$SMB_SHARE_NAME': существующая шара оставлена как настроена (автопубликация выключена)"
      case "$_go" in ''|0|no) ;; *) warn "  ВНИМАНИЕ: шара открыта для гостей (guest_ok=$_go) - закройте её в LuCI -> ksmbd" ;; esac
      case "$_fr" in 1|yes) warn "  ВНИМАНИЕ: force_root=1 - архив читается от root, права 0600 сами по себе не защищают" ;; esac
      warn "  Управляемая шара: touch $SMB_SHARE_ENABLE и создайте именованного пользователя ksmbd"
    else
      info "SMB share для бэкапов не публикуется по умолчанию (включить: touch $SMB_SHARE_ENABLE)"
    fi
    return 0
  fi
  chmod 700 "$(P $BACKUP_DIR)" 2>/dev/null
  _changed=0
  # Drop duplicated sections with OUR name only, re-reading after every delete so a shifted
  # @share[N] can never address somebody else's section.
  while :; do
    _ours=$(_smb_ours)
    _count=$(printf '%s\n' "$_ours" | grep -c . 2>/dev/null || echo 0)
    [ "${_count:-0}" -gt 1 ] || break
    _drop=$(printf '%s\n' "$_ours" | sed -n '2p')
    [ -n "$_drop" ] || break
    uci delete "$_drop" 2>/dev/null || break
    uci commit ksmbd 2>/dev/null
    _changed=1
    info "SMB share '$SMB_SHARE_NAME': duplicate section removed"
  done
  _found=$(printf '%s\n' "$_ours" | head -1)
  if [ -z "$_found" ]; then
    _sec=$(uci add ksmbd share 2>/dev/null)
    [ -n "$_sec" ] || { warn "uci add failed - SMB share skipped"; return 1; }
    uci set "ksmbd.$_sec.name=$SMB_SHARE_NAME"
    uci set "ksmbd.$_sec.path=$BACKUP_DIR"
    uci set "ksmbd.$_sec.read_only=yes"
    uci set "ksmbd.$_sec.guest_ok=no"
    uci commit ksmbd 2>/dev/null || { warn "uci commit failed - SMB share skipped"; return 1; }
    _found="ksmbd.$_sec"
    _changed=1
    info "SMB share '$SMB_SHARE_NAME' -> $BACKUP_DIR (read-only, аутентификация): created (section $_sec)"
  else
    _p=$(uci -q get "$_found.path" 2>/dev/null)
    if [ "$_p" != "$BACKUP_DIR" ]; then
      uci set "$_found.path=$BACKUP_DIR"
      uci set "$_found.read_only=yes"
      uci set "$_found.guest_ok=no"
      uci commit ksmbd 2>/dev/null
      _changed=1
      info "SMB share '$SMB_SHARE_NAME': path fixed -> $BACKUP_DIR"
    else
      # path ok, but v1.9.0/1.9.1 may have stored quoted values ('1') - normalize to yes
      _ro=$(uci -q get "$_found.read_only" 2>/dev/null)
      case "$_ro" in
        1|yes) : ;;
        *) uci set "$_found.read_only=yes"; uci commit ksmbd 2>/dev/null; _changed=1 ;;
      esac
      # an opt-in share must not stay open to guests from an older release
      _go=$(uci -q get "$_found.guest_ok" 2>/dev/null)
      case "$_go" in
        ''|0|no) : ;;
        *) uci set "$_found.guest_ok=no"; uci commit ksmbd 2>/dev/null; _changed=1; info "SMB share: гостевой доступ выключен" ;;
      esac
    fi
  fi
  # v1.9.5: force user root (share under /root is unreachable for the guest uid)
  _fr=$(uci -q get "$_found.force_root" 2>/dev/null)
  [ "$_fr" = 1 ] || { uci set "$_found.force_root=1"; uci commit ksmbd 2>/dev/null; _changed=1; }
  # No account is created here. A published backup needs a named ksmbd user with a password
  # the owner chooses; `backup`/`backup` was a known credential in every geomask install.
  if have ksmbd.adduser && ! grep -qE '^[[:space:]]*[^#[:space:]]' "$(P /etc/ksmbd/ksmbd.conf)" 2>/dev/null; then
    info "SMB share: создайте пользователя вручную: ksmbd.adduser <имя>"
  fi
  if [ "$_changed" = 1 ]; then
    # restart ONLY the file server (not the network stack); verify right away.
    # `P` keeps this on the root the run was pointed at: a bare /etc/init.d/... restart reaches
    # the host that executes the script, not the router tree under test (review 15.11, point 1).
    "$(P /etc/init.d/$_init)" restart >/dev/null 2>&1 || true
    sleep 2
  fi
  # a leftover share section without a name is reported, never deleted: it is not ours
  for _s in $(_smb_sections); do
    [ -z "$(uci -q get "$_s.name" 2>/dev/null)" ] && warn "ksmbd: безымянная секция $_s оставлена без изменений"
  done
  if grep -qF "[$SMB_SHARE_NAME]" "$(P /etc/ksmbd/ksmbd.conf)" 2>/dev/null; then
    info "SMB share present in ksmbd.conf: \\\\$(lan_ip)\\$SMB_SHARE_NAME"
  else
    warn "share [$SMB_SHARE_NAME] not found in /etc/ksmbd/ksmbd.conf - check LuCI -> ksmbd"
    return 1
  fi
  return 0
}

# dry-run: start a COPY of the mihomo config on shifted ports in a temp dir.
# rc=0 only if mihomo actually starts with the new config. Never touches live service.
mihomo_trial_run() {
  _c="$(P $MIHOMO_CONF)"
  [ -s "$_c" ] || { bad "config missing for trial"; return 1; }
  _td="$(P /tmp)/gm-trial-$$"
  rm -rf "$_td"; mkdir -p "$_td"
  cp -a "$(dirname "$_c")/." "$_td/" 2>/dev/null || cp -a "$(P /etc/mihomo)" "$_td" 2>/dev/null || {
    warn "trial: cannot copy mihomo dir"; rm -rf "$_td"; return 1; }
  sed -i -e 's/^mixed-port:.*/mixed-port: 17890/' \
         -e 's/^external-controller:.*/external-controller: 127.0.0.1:19090/' \
         -e 's/^[[:space:]]*port: 7891/    port: 17901/' \
         -e "s|path: /etc/mihomo/|path: $_td/|g" "$_td/config.yaml" 2>/dev/null
  mihomo -d "$_td" -f config.yaml > "$_td/trial.log" 2>&1 &
  _tp=$!
  sleep 3
  if kill -0 "$_tp" 2>/dev/null; then
    info "trial run: OK (config starts, no restart done)"
    kill "$_tp" 2>/dev/null
    wait "$_tp" 2>/dev/null
    rm -rf "$_td"
    return 0
  fi
  bad "trial run FAILED - live mihomo NOT touched"
  sed 's/^/    | /' "$_td/trial.log" 2>/dev/null | tail -5
  rm -rf "$_td"
  return 1
}

# restart mihomo and verify it really came back (pid + API). NO silent failures.
mihomo_restart_verified() {
  initd mihomo restart >/dev/null 2>&1
  sleep 3
  if ! svc_alive mihomo; then
    bad "mihomo did NOT come back after restart!"
    return 1
  fi
  if ! controller_curl -s -m3 "http://127.0.0.1:9090/version" 2>/dev/null | grep -qi 'mihomo\|meta'; then
    bad "mihomo API not responding after restart!"
    return 1
  fi
  info "mihomo restarted and verified (pid $(pidof mihomo))"
  return 0
}

# full safe mihomo restart: backup -> trial -> restart -> verify -> rollback on failure
safe_mihomo_restart() {
  _c="$(P $MIHOMO_CONF)"
  if [ "$GM_RESTART" != 1 ]; then
    warn "restart skipped (no --restart); will apply at next mihomo start"
    return 0
  fi
  backup_gate || return 1
  _bk="$GM_BACKUP_PATH"
  info "backup: $_bk"
  # the pre-image is the file as it was BEFORE this run; copying the current file here (the
  # old behaviour) made the "rollback" restore the candidate that had just failed
  _pre="${GM_PRE_CONFIG:-}"
  [ -s "$_pre" ] || _pre=$(ls -1t "$_c".bak_geomask_* 2>/dev/null | head -1)
  if ! mihomo_trial_run; then
    # the candidate is already on disk at this point: leaving it there means the next
    # restart picks up a config that does not start. Put the pre-run file back.
    if [ -n "$_pre" ] && [ -s "$_pre" ]; then
      cp -p "$_pre" "$_c" && info "прежний конфиг возвращён ($_pre)"
    else
      warn "копии прежнего конфига нет - проверьте $_c вручную"
    fi
    bad "trial failed - live mihomo NOT restarted"
    return 1
  fi
  if mihomo_restart_verified; then
    info "restart verified OK"
    return 0
  fi
  bad "restart FAILED - rolling back config and re-starting"
  if [ -n "$_pre" ] && [ -s "$_pre" ]; then
    cp -p "$_pre" "$_c"
    /etc/init.d/mihomo restart >/dev/null 2>&1
    sleep 3
    if svc_alive mihomo && controller_curl -s -m3 "http://127.0.0.1:9090/version" 2>/dev/null | grep -qi 'mihomo\|meta'; then
      info "rollback OK: предыдущий конфиг восстановлен, mihomo отвечает ($_pre)"
    else
      bad "rollback FAILED - RESTORE FROM BACKUP: $_bk"
    fi
  else
    bad "нет копии прежнего конфига; RESTORE FROM BACKUP: $_bk"
  fi
  return 1
}

# ============================================================ STEP 4: AI-DNS - no DNS leak for AI devices
# Browsing of AI-mode devices goes through the AI tunnel, but their DNS used to be
# resolved by the router itself and left via the real ISP IP -> DNS leak: geo checkers
# see "page from <AI country>, DNS from <ISP country>" and flag VPN usage.
# This step puts DNS of AI-mode devices into the same AI tunnel:
#   device DNS (any dst, port 53)
#     --DNAT (nat priority -110; wins over ALL other DNS interception on this router)-->
#     192.168.0.53:53 (2nd dnsmasq) -> 127.0.0.1:5055 (2nd DoH worker as user dnsai)
#     --nft mark 0x64 (skuid)--> ip rule fwmark 0x64 table 101 -> dev AI (exit = AI node)
# Permanent opt-out: touch /etc/geomask-aidns.off  (step becomes a no-op)

AIDNS_IP=""          # discovered from the LAN (aidns_ip): 192.168.0.53 is one owner's net
AIDNS_PORT=5055
AIDNS_DNS_PORT=5353
AIDNS_USER=dnsai
AIDNS_MARK=0x64
AIDNS_RULE_PREF=19902

aidns_user_exists() { grep -q "^$AIDNS_USER:" "$(P /etc/passwd)" 2>/dev/null; }

aidns_generate_nft() { # (re)write the nft include from the current ai device list
  _uid=$(cat "$(P /etc/geomask-aidns.uid)" 2>/dev/null)
  [ -n "$_uid" ] || _uid=$(awk -F: -v u="$AIDNS_USER" '$1==u{print $3}' "$(P /etc/passwd)" 2>/dev/null)
  [ -n "$_uid" ] || _uid=65533
  _ips=$(awk '$2=="ai" && $1 !~ /^#/ {print $1}' "$(P /etc/geo-devices.list)" 2>/dev/null)
  _list=""
  for _ip in $_ips; do _list="$_list $_ip,"; done
  _list=${_list%,}
  {
    printf '# geomask AI-DNS (auto-generated from /etc/geo-devices.list - do not edit)\n'
    printf '# DNS of AI-mode devices goes into the AI tunnel: no DNS leak, no geo mismatch.\n'
    printf '# idempotent include pattern (same as 20-https-dns-proxy-notrack.nft)\n'
    printf 'add table inet geomask_ai_dns\n'
    printf 'flush table inet geomask_ai_dns\n'
    printf 'add chain inet geomask_ai_dns pre_nat { type nat hook prerouting priority -110; policy accept; }\n'
    printf 'add chain inet geomask_ai_dns out_mark { type route hook output priority -150; policy accept; }\n'
    printf 'add rule inet geomask_ai_dns out_mark meta skuid %s mark set %s\n' "$_uid" "$AIDNS_MARK"
    if [ -n "$_list" ]; then
      printf 'add rule inet geomask_ai_dns pre_nat ip saddr { %s } meta l4proto { tcp, udp } th dport 53 dnat ip to %s:%s\n' "$_list" "$AIDNS_IP" "$AIDNS_DNS_PORT"
    fi
  } > /tmp/geomask-aidns.nft || { rm -f /tmp/geomask-aidns.nft; bad "cannot render AI-DNS rules"; return 1; }
  if nft -c -f /tmp/geomask-aidns.nft >/dev/null 2>&1; then
    if save_stream /usr/share/nftables.d/ruleset-post/98-geomask-ai-dns.nft 644 < /tmp/geomask-aidns.nft; then
      rm -f /tmp/geomask-aidns.nft
      return 0
    fi
    rm -f /tmp/geomask-aidns.nft
    bad "cannot write the AI-DNS include - DNS interception is not installed"
    return 1
  fi
  rm -f /tmp/geomask-aidns.nft
  bad "generated AI-DNS nft rules failed syntax check"
  return 1
}

step4_check() {
  _need=0
  mod_skipped ai_dns && return 0
  _aip=$(aidns_ip)
  if [ -z "$_aip" ]; then
    bad "не определён адрес LAN - AI-DNS проверить нечем (uci show network.lan)"
    return 1
  fi
  AIDNS_IP="$_aip"
  if [ -f "$(P /etc/geomask-aidns.off)" ]; then
    info "AI-DNS: disabled (/etc/geomask-aidns.off present)"
    return 0
  fi
  aidns_user_exists && info "user $AIDNS_USER: present" || { warn "user $AIDNS_USER: missing"; _need=1; }
  [ -x "$(P /usr/sbin/https-dns-proxy)" ] && info "https-dns-proxy: present" || { warn "https-dns-proxy: missing"; _need=1; }
  if have netstat; then
    netstat -ltnu 2>/dev/null | grep -q "127.0.0.1:$AIDNS_PORT " && info "AI DoH worker (:$AIDNS_PORT): listening" || { warn "AI DoH worker not listening on :$AIDNS_PORT"; _need=1; }
    netstat -ltnu 2>/dev/null | grep -q "$AIDNS_IP:$AIDNS_DNS_PORT " && info "AI dnsmasq ($AIDNS_IP:$AIDNS_DNS_PORT): listening" || { warn "AI dnsmasq not listening on $AIDNS_IP:$AIDNS_DNS_PORT"; _need=1; }
  else
    warn "netstat unavailable - listener checks skipped"
  fi
  _lanif=$(lan_iface)
  _alias=$(ip -4 addr show "$_lanif" 2>/dev/null)
  if [ -z "$_alias" ]; then
    warn "cannot read $_lanif addresses (ip unavailable?)"
  elif printf '%s' "$_alias" | grep -q " $AIDNS_IP/"; then
    info "alias $AIDNS_IP on $_lanif: present"
  else
    warn "alias $AIDNS_IP missing on $_lanif"; _need=1
  fi
  ip rule show 2>/dev/null | grep -q "fwmark $AIDNS_MARK" && info "ip rule fwmark $AIDNS_MARK -> table 101: present" || { warn "ip rule fwmark $AIDNS_MARK -> 101 missing"; _need=1; }
  nft list table inet geomask_ai_dns >/dev/null 2>&1 && info "nft AI-DNS table: loaded" || { warn "nft AI-DNS table missing"; _need=1; }
  _tbl=$(nft list table inet geomask_ai_dns 2>/dev/null)
  # The mark rule alone only proves that dnsai's own sockets are routed; it says nothing about
  # client DNS. Both halves are required, and the DNAT target must be the address this router
  # actually computed (audit 14.11.2026, F08).
  if [ -n "$_tbl" ]; then
    printf '%s' "$_tbl" | grep -q "mark set $AIDNS_MARK" \
      && info "AI-DNS: dnsai sockets are marked $AIDNS_MARK" \
      || { bad "AI-DNS: mark rule for $AIDNS_MARK missing"; _need=1; }
  fi
  _aiips=$(awk '$2=="ai" && $1 !~ /^#/ {print $1}' "$(P /etc/geo-devices.list)" 2>/dev/null)
  if [ -z "$_aiips" ]; then
    info "ai-mode devices: none (nothing to DNAT)"
  elif [ -z "$_tbl" ]; then
    bad "AI-DNS DNAT: cannot read rules (nft list empty)"; _need=1
  elif ! printf '%s' "$_tbl" | grep -q "dnat ip to $AIDNS_IP:$AIDNS_DNS_PORT"; then
    # Without this rule the AI devices resolve through the ordinary dnsmasq: the leak the
    # feature exists to prevent. Fail closed, never report "no leak" from the route alone.
    bad "AI-DNS DNAT to $AIDNS_IP:$AIDNS_DNS_PORT missing - AI devices would use the router DNS"
    _need=1
  else
    _miss=0
    for _ip in $_aiips; do
      printf '%s' "$_tbl" | grep -q "$_ip" || _miss=1
    done
    if [ "$_miss" = 0 ]; then info "AI-DNS DNAT: all ai devices covered -> $AIDNS_IP:$AIDNS_DNS_PORT"
    else bad "AI-DNS DNAT: some ai devices missing from rules"; _need=1; fi
  fi
  return $_need
}
step4_apply() {
  mod_skipped ai_dns && return 0
  if [ -f "$(P /etc/geomask-aidns.off)" ]; then info "AI-DNS disabled by flag - nothing to do"; return 0; fi
  _aip=$(aidns_ip)
  if [ -z "$_aip" ]; then
    bad "не определён адрес LAN - AI-DNS некуда привязать (проверьте uci show network.lan)"
    return 1
  fi
  AIDNS_IP="$_aip"
  # v1.30.7: same rule as step 1 - what is installable from the feeds is installed here,
  # not left to the owner. https-dns-proxy is the DoH worker this step configures.
  if ! have https-dns-proxy && [ ! -x "$(P /usr/sbin/https-dns-proxy)" ]; then
    if have apk; then
      info "installing: https-dns-proxy (apk)"
      apk add https-dns-proxy >/dev/null 2>&1 && info "installed: https-dns-proxy" \
        || warn "apk add https-dns-proxy failed"
    elif have opkg; then
      info "installing: https-dns-proxy (opkg)"
      opkg install https-dns-proxy >/dev/null 2>&1 && info "installed: https-dns-proxy" \
        || warn "opkg install https-dns-proxy failed"
    fi
  fi
  # v1.30.15: no worker - no DNS/network rewrite. The step used to warn and continue,
  # sending AI devices to a dnsmasq whose upstream does not exist.
  if ! have https-dns-proxy && [ ! -x "$(P /usr/sbin/https-dns-proxy)" ]; then
    bad "https-dns-proxy не установлен - AI-DNS не настраивается (DNS и сеть не менялись)"
    info "  Поставьте пакет и повторите шаг: apk add https-dns-proxy (или opkg install)"
    info "  Либо откажитесь от AI-DNS: touch /etc/geomask-aidns.off"
    return 1
  fi
  backup_gate || return 1
  _bk="$GM_BACKUP_PATH"
  info "backup: $_bk"
  # Everything this step writes is recorded first, so a refusal in the middle leaves the
  # router exactly as it was: uci network.lanai, the uid marker, the alias.
  _prev_lanai_exists=0
  _prev_lanai_proto=""; _prev_lanai_dev=""; _prev_lanai_ip=""; _prev_lanai_mask=""
  if uci -q get network.lanai >/dev/null 2>&1; then
    _prev_lanai_exists=1
    _prev_lanai_proto=$(uci -q get network.lanai.proto 2>/dev/null)
    _prev_lanai_dev=$(uci -q get network.lanai.device 2>/dev/null)
    _prev_lanai_ip=$(uci -q get network.lanai.ipaddr 2>/dev/null)
    _prev_lanai_mask=$(uci -q get network.lanai.netmask 2>/dev/null)
  fi
  _prev_uid_marker=$(tr -dc '0-9' < "$(P /etc/geomask-aidns.uid)" 2>/dev/null)
  _aidns_rollback() {
    if [ "$_prev_lanai_exists" = 1 ]; then
      uci set network.lanai=interface 2>/dev/null
      [ -n "$_prev_lanai_proto" ] && uci set network.lanai.proto="$_prev_lanai_proto" 2>/dev/null
      [ -n "$_prev_lanai_dev" ] && uci set network.lanai.device="$_prev_lanai_dev" 2>/dev/null
      [ -n "$_prev_lanai_ip" ] && uci set network.lanai.ipaddr="$_prev_lanai_ip" 2>/dev/null
      [ -n "$_prev_lanai_mask" ] && uci set network.lanai.netmask="$_prev_lanai_mask" 2>/dev/null
    else
      uci -q delete network.lanai 2>/dev/null
    fi
    uci commit network 2>/dev/null
    if [ -n "$_prev_uid_marker" ]; then
      printf '%s\n' "$_prev_uid_marker" > "$(P /etc/geomask-aidns.uid)" 2>/dev/null
    else
      rm -f "$(P /etc/geomask-aidns.uid)" 2>/dev/null
    fi
    warn "AI-DNS: изменения отменены (uci network.lanai и маркер uid восстановлены)"
  }
  # 1) dedicated user for the AI DoH worker (sockets get marked by uid)
  _uid=$(awk -F: -v u="$AIDNS_USER" '$1==u{print $3; exit}' "$(P /etc/passwd)" 2>/dev/null)
  case "$_uid" in ''|*[!0-9]*) _uid="" ;; esac
  if [ -z "$_uid" ]; then
    _uid=65533
    while awk -F: -v u="$_uid" '$3==u{found=1} END{exit found?0:1}' "$(P /etc/passwd)" 2>/dev/null; do _uid=$((_uid-1)); done
    printf '%s:x:%s:%s:geomask AI-DNS:/var/run/%s:/bin/false\n' "$AIDNS_USER" "$_uid" "$_uid" "$AIDNS_USER" >> "$(P /etc/passwd)"
    grep -q "^$AIDNS_USER:" "$(P /etc/group)" 2>/dev/null || printf '%s:x:%s:\n' "$AIDNS_USER" "$_uid" >> "$(P /etc/group)"
    info "user $AIDNS_USER created (uid $_uid)"
  fi
  # The marker is the only thing the backend and hotplug read. An existing user without it
  # (marker lost, or the user was created by hand) used to leave AI-DNS silently disabled.
  _uid_marker=$(tr -dc '0-9' < "$(P /etc/geomask-aidns.uid)" 2>/dev/null)
  if [ "$_uid_marker" != "$_uid" ]; then
    save_stream /etc/geomask-aidns.uid 644 <<ASSET_EOF
$_uid
ASSET_EOF
  fi
  # 2) alias IP on the LAN interface for the AI dnsmasq (device and prefix discovered)
  _lanif=$(lan_iface)
  _lanprefix=$(ip -4 addr show "$_lanif" 2>/dev/null | sed -n 's/.*inet [0-9.]*\/\([0-9][0-9]*\).*/\1/p' | head -1)
  case "$_lanprefix" in ''|*[!0-9]*) _lanprefix=24 ;; esac
  _lanmask=$(_prefix_to_mask "$_lanprefix")
  if ! ip -4 addr show "$_lanif" 2>/dev/null | grep -q " $AIDNS_IP/"; then
    if ! uci -q get network.lanai >/dev/null; then uci set network.lanai=interface; fi
    uci set network.lanai.proto='static'
    uci set network.lanai.device="$_lanif"
    uci set network.lanai.ipaddr="$AIDNS_IP"
    # UCI netmask is dotted; a bare prefix is not what netifd expects for a static address.
    uci set network.lanai.netmask="$_lanmask"
    if ! uci commit network 2>/dev/null; then
      _aidns_rollback; return 1
    fi
    /etc/init.d/network reload >/dev/null 2>&1 || warn "network reload rc!=0 - alias may need reboot"
    sleep 1
    if ip -4 addr show "$_lanif" | grep -q " $AIDNS_IP/"; then
      info "alias $AIDNS_IP/$_lanprefix: up"
    else
      # No alias - no DNAT target. Refuse here instead of pointing AI devices at a dead DNS.
      bad "alias $AIDNS_IP не поднялся на $_lanif - AI-DNS не настраивается"
      _aidns_rollback
      info "  Проверьте: uci show network.lanai; ip -4 addr show $_lanif"
      return 1
    fi
  fi
  # 3) AI DoH worker (second https-dns-proxy instance, runs as dnsai)
  save_stream /etc/init.d/ai-doh 755 <<'ASSET_EOF'
@@ASSET:ai-doh.init@@
ASSET_EOF
  # 4) AI dnsmasq (upstream = the AI DoH worker; RU-domain resolvers copied from main dnsmasq)
  {
    printf 'listen-address=%s\n' "$AIDNS_IP"
    printf 'bind-interfaces\n'
    printf 'port=%s\n' "$AIDNS_DNS_PORT"
    printf 'no-resolv\n'
    printf 'no-poll\n'
    printf 'cache-size=1000\n'
    printf 'domain-needed\n'
    printf 'bogus-priv\n'
    printf 'server=127.0.0.1#%s\n' "$AIDNS_PORT"
    _s=$(uci -q get dhcp.@dnsmasq[0].server 2>/dev/null)
    for _e in $_s; do case "$_e" in /*) printf 'server=%s\n' "$_e" ;; esac; done
  } > "$(P /etc/dnsmasq-ai.conf)" || { bad "cannot write /etc/dnsmasq-ai.conf"; _aidns_rollback; return 1; }
  save_stream /etc/init.d/dnsmasq-ai 755 <<'ASSET_EOF'
@@ASSET:dnsmasq-ai.init@@
ASSET_EOF
  # 5) nft rules (DNAT for ai devices + mark for dnsai sockets)
  aidns_generate_nft || { _aidns_rollback; return 1; }
  # 6) ip rule: marked DNS sockets go through the AI tunnel
  ip rule show 2>/dev/null | grep -q "fwmark $AIDNS_MARK" || ip rule add pref "$AIDNS_RULE_PREF" fwmark "$AIDNS_MARK" table 101
  # 7) services on + reload firewall to apply nft file
  initd ai-doh enable >/dev/null 2>&1 || true
  initd dnsmasq-ai enable >/dev/null 2>&1 || true
  initd ai-doh restart >/dev/null 2>&1 || { warn "ai-doh did not start"; }
  initd dnsmasq-ai restart >/dev/null 2>&1 || { warn "dnsmasq-ai did not start"; }
  # A failed reload leaves the old ruleset in place: say so instead of claiming success.
  if ! initd firewall reload >/dev/null 2>&1; then
    bad "firewall reload failed - AI-DNS rules may not be active"
    sleep 1
    initd firewall reload >/dev/null 2>&1 || { bad "firewall reload failed again"; return 1; }
  fi
  sleep 1
  return 0
}
step4_verify() { step4_check; }

# ============================================================ STEP 5: magitrickle -> mihomo sync
# v1.13.0: write the bundled lists template + seeder to the router (idempotent; asset injected once).
write_lists_assets() {
  mkdir -p "$(P /etc/geomask/lists)" 2>/dev/null || true
  save_stream /etc/geomask/lists/magitrickle-groups.yaml 644 <<'ASSET_EOF'
@@ASSET:MagiTrickleGroups@@
ASSET_EOF
  save_stream /usr/bin/geomask-seed-lists.py 755 <<'ASSET_EOF'
@@ASSET:geomask-seed-lists.py@@
ASSET_EOF
}

# v1.13.0: restore MagiTrickle domain lists from the bundled template.
#   seed_lists ""    -> auto: seed only if MagiTrickle has no groups (fresh install)
#   seed_lists force -> overwrite current groups with the template (backup first)
# magitrickled owns config.yaml, so it is stopped around the write, then restarted + synced.
seed_lists() {
  _force="${1:-}"
  _tpl="$(P /etc/geomask/lists/magitrickle-groups.yaml)"
  _cfg="$(P /etc/magitrickle/state/config.yaml)"
  _py="$(P /usr/bin/geomask-seed-lists.py)"
  [ -s "$_tpl" ] || { warn "lists template missing ($_tpl) - skip seed"; return 0; }
  [ -f "$_py" ]  || { warn "seed script missing ($_py) - skip seed"; return 0; }
  if [ "$_force" != force ]; then
    # A fresh install starts magitrickle a moment before its config exists. Wait a bounded
    # time for it: the old message promised an auto-seed later that nothing ever performed.
    _wait=0
    while [ ! -f "$_cfg" ] && [ "$_wait" -lt 10 ]; do
      _wait=$((_wait+1)); sleep 2
    done
    if [ ! -f "$_cfg" ]; then
      warn "lists: MagiTrickle ещё не создал конфиг - автозаполнение не выполнено (запустите --seed-lists позже)"
      return 0
    fi
    python3 "$_py" --check-empty --config="$_cfg" --template="$_tpl"; _crc=$?
    case "$_crc" in
      0) : ;;
      1) info "lists: MagiTrickle already configured - auto-seed skipped (use --seed-lists to restore)"; return 0 ;;
      *) warn "lists: не удалось проверить конфиг MagiTrickle (rc=$_crc) - автозаполнение пропущено, файл не тронут"; return 0 ;;
    esac
  fi
  info "lists: seeding MagiTrickle groups from template (mode=${_force:-ifempty})..."
  _farg=""
  [ "$_force" = force ] && _farg="--force"
  # magitrickled owns config.yaml: writing while it runs is a race that can lose the result.
  # A failed stop used to be ignored and the file was written anyway (audit 14.11.2026, F19).
  _was_running=0
  svc_alive magitrickled && _was_running=1
  if ! initd magitrickle stop >/dev/null 2>&1; then
    bad "lists: не удалось остановить magitrickle - конфиг не записывается (гонка с демоном)"
    return 1
  fi
  _w=0
  while [ "$_w" -lt 5 ] && svc_alive magitrickled; do _w=$((_w+1)); sleep 1; done
  if svc_alive magitrickled; then
    initd magitrickle start >/dev/null 2>&1 || true
    bad "lists: magitrickled всё ещё работает - конфиг не записывается"
    return 1
  fi
  _wan=$(wan_iface)
  if [ -z "$_wan" ]; then
    warn "lists: WAN-интерфейс не определён - direct-группы останутся с pppoe-wan из шаблона"
    warn "  проверьте вручную: uci show network.wan; ip route show default"
  fi
  _out=$(python3 "$_py" $_farg --config="$_cfg" --template="$_tpl" --wan-iface="$_wan" 2>&1); _rc=$?
  _start_ok=1
  initd magitrickle start >/dev/null 2>&1 || _start_ok=0
  sleep 2
  svc_alive magitrickled || _start_ok=0
  if [ "$_start_ok" = 0 ]; then
    bad "lists: magitrickle не поднялся после записи"
    [ "$_was_running" = 1 ] && info "  он работал до операции - проверьте logread | tail -20"
  fi
  # regenerate mihomo rulesets + hot-reload mihomo (no mihomo restart)
  _sync_ok=1
  sh "$(P /root/sync_mtrickle_mihomo.sh)" >/dev/null 2>&1 || _sync_ok=0
  controller_curl -s -X PUT "http://127.0.0.1:9090/configs" -H 'Content-Type: application/json' \
    -d '{"path":"/etc/mihomo/config.yaml"}' >/dev/null 2>&1 || true
  printf '%s\n' "$_out" | sed 's/^/  | /'
  if [ "$_rc" -eq 0 ] && [ "$_start_ok" = 1 ] && [ "$_sync_ok" = 1 ]; then
    info "lists: seed applied"
    return 0
  fi
  [ "$_rc" -ne 0 ] && bad "lists: seed failed rc=$_rc"
  [ "$_sync_ok" = 0 ] && bad "lists: sync_mtrickle_mihomo.sh failed - mihomo rulesets may be stale"
  return 1
}

# v1.28.0: the nightly audit can be owned by the per-path scheduler instead of the legacy
# 03:30 cron. Both halves ask this: step5_apply must not add the legacy cron when a
# schedule is active, and step5_check must not fail because the legacy cron is absent.
nodescan_schedule_active() {
  python3 - "$(P /usr/lib/geomask/geomask-node-audit.py)" <<'PYEOF' 2>/dev/null
import importlib.util, sys
try:
    spec = importlib.util.spec_from_file_location('node_audit', sys.argv[1])
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    data, _ = mod.load_store()
    print(1 if any((p.get('schedule') or {}).get('enabled')
                   for p in data.get('paths', {}).values()) else 0)
except Exception:
    print(0)
PYEOF
}

step5_check() {
  _need=0
  _s="$(P /root/sync_mtrickle_mihomo.sh)"
  if [ -s "$_s" ]; then
    info "sync script: present"
    [ -x "$_s" ] || warn "sync script not executable (chmod +x on router)"
  else
    bad "sync script missing: /root/sync_mtrickle_mihomo.sh"; _need=1
  fi
  if crontab -l 2>/dev/null | grep -q 'sync_mtrickle_mihomo'; then info "cron */5: present"; else bad "cron entry missing"; _need=1; fi
  # v1.10.0: event sync watchdog (service enabled + running; graceful if script absent on old installs)
  if [ -x "$(P /etc/init.d/geomask-syncd)" ]; then
    # A daemon that is installed but not (yet) running is a WARNING, not a failed install.
    # This used to set _need=1, which made step5's verify abort the whole --auto run - so on any
    # host where the daemon had not been started yet (and in the sandbox, where services cannot
    # really run) geomask refused to finish installing. CI had been red for 40+ runs over this.
    if pgrep -f geomask-syncd.sh >/dev/null 2>&1; then info "syncd: running"
    else warn "syncd: installed but not running (start it: /etc/init.d/geomask-syncd start)"; fi
    ls "$(P /etc/rc.d)" 2>/dev/null | grep -q 'geomask-syncd' && info "syncd: enabled" \
      || warn "syncd: not enabled at boot (run: /etc/init.d/geomask-syncd enable)"
  else
    bad "syncd: /etc/init.d/geomask-syncd missing"; _need=1
  fi
  if ! mod_skipped guard; then
    if [ -x "$(P /usr/bin/geomask-guard.sh)" ]; then info "guard: present"; else bad "guard missing: /usr/bin/geomask-guard.sh"; _need=1; fi
    if [ -x "$(P /etc/hotplug.d/iface/99-geomask-guard)" ]; then info "guard hotplug: present"; else bad "guard hotplug missing"; _need=1; fi
  fi
  cron_verify guard '# geomask-guard$' 'guard cron */5'
  # v1.11.0: node audit plumbing
  if [ -x "$(P /usr/bin/geomask-node-scan.sh)" ] && [ -s "$(P /etc/geomask-nodes.conf)" ]; then info "node-scan: installed"
  else bad "node-scan missing (script/conf)"; _need=1; fi
  if crontab -l 2>/dev/null | grep -q 'geomask-node-scan'; then info "nodescan cron 03:30: present"
  elif [ "$(nodescan_schedule_active)" = "1" ]; then info "nodescan: per-path scheduler is active (legacy cron retired)"
  else bad "nodescan cron missing"; _need=1; fi
  # v1.14.0: youtube edge watchdog
  # v1.21.5: the VPN lane must contain ONLY subscription nodes. DIRECT as a group member was a
  # workaround for a misdiagnosis (the real cause was provider health-check hiding every node);
  # left in place it silently moves VPN-lane traffic onto the plain, DPI-visible path instead of
  # failing loudly. A hard 502 is the correct behaviour when the subscription is down.
  if grep -qE '^[[:space:]]*- name: VPN$' "$_c" 2>/dev/null; then
    _vb=$(awk '/^[[:space:]]*- name: VPN$/{f=1;next} f&&/^[[:space:]]*- name:/{exit} f' "$_c")
    if printf '%s' "$_vb" | grep -qE '^\s*-\s+DIRECT\s*$'; then
      bad "the VPN group contains DIRECT - VPN-lane traffic leaks to the plain path silently when nodes fail"; _need=1
    else
      _vt=$(printf '%s' "$_vb" | awk '/^    type:/{sub(/^[^:]*:[[:space:]]*/,"");print;exit}')
      info "VPN lane: ${_vt:-unknown}, subscription nodes only"
    fi
  fi
  # v1.29.0: optional modules. Their pieces are only installed when the module is selected,
  # so their checks are gated too - otherwise a minimal install fails its own verification.
  if ! mod_skipped youtube; then
    if [ -x "$(P /usr/bin/geomask-ytwatch.sh)" ] && [ -s "$(P /etc/geomask-ytwatch.conf)" ]; then info "ytwatch: installed"
    else bad "ytwatch missing (script/conf)"; _need=1; fi
  fi
  cron_verify youtube '# geomask-ytwatch$' 'ytwatch cron */1'
  cron_verify youtube '# geomask-ytwatch-reset$' 'ytwatch reset cron'
  # v1.15.0: torrent admin
  if ! mod_skipped torrent; then
    if [ -x "$(P /usr/bin/geomask-torrent.sh)" ] && [ -d "$(P /etc/geomask/torrent)" ]; then info "torrent admin: installed"
    else bad "torrent admin missing (script/dir)"; _need=1; fi
  fi
  # v1.18.0: VPN lane audit
  if ! mod_skipped diagnostic; then
    if [ -x "$(P /usr/bin/geomask-vpnwatch.sh)" ] && [ -s "$(P /etc/geomask/vpnwatch.conf)" ]; then info "vpnwatch: installed"
    else bad "vpnwatch missing (script/conf)"; _need=1; fi
    if [ -x "$(P /usr/bin/geomask-morning-check.sh)" ]; then info "morning check: installed"
    else bad "morning check script missing"; _need=1; fi
  fi
  cron_verify diagnostic '# geomask-vpnwatch$' 'vpnwatch cron */1' soft
  cron_verify doctor '# geomask-doctor-prune$' 'doctor prune cron' soft
  # the extra lane is optional; report it, never fail because of it
  if [ -e "$(P /sys/class/net/VPN-noP2P)" ]; then
    info "lane VPN-noP2P: netdev present (MagiTrickle can select it)"
  else
    info "lane VPN-noP2P: not installed (run: geomask-lane.sh install)"
  fi
  svc_alive magitrickled && info "magitrickle: running" || { bad "magitrickle not running"; _need=1; }
  return $_need
}
step5_apply() {
  save_stream /root/sync_mtrickle_mihomo.sh 755 <<'ASSET_EOF'
@@ASSET:sync_mtrickle_mihomo.sh@@
ASSET_EOF
  save_stream /etc/mihomo/ruleset/ytdirect.yaml 644 <<'ASSET_EOF'
@@ASSET:ytdirect.yaml@@
ASSET_EOF
  # v1.29.0: the core mihomo config always references these rulesets, so a deselected
  # module must still leave a valid (empty) file behind - otherwise `mihomo -t` fails.
  ruleset_stub youtube /etc/mihomo/ruleset/ytdirect.yaml
  # v1.13.3: googlevideo -> VPN. Source of truth is the MagiTrickle group "GoogleVideo VPN";
  # sync regenerates ytvpn.yaml from it. Seed the file only if missing so mihomo -t passes before
  # first sync; never clobber an existing one here.
  if [ ! -s "$(P /etc/mihomo/ruleset/ytvpn.yaml)" ]; then
    save_stream /etc/mihomo/ruleset/ytvpn.yaml 644 <<'ASSET_EOF'
@@ASSET:ytvpn.yaml@@
ASSET_EOF
  else
    info "ytvpn list: keeping existing /etc/mihomo/ruleset/ytvpn.yaml (sync-managed)"
  fi
  ruleset_stub youtube /etc/mihomo/ruleset/ytvpn.yaml
  # v1.17.0: lane split - IP rules must never reach the restricted VPN subscription.
  # mtrickle_bulk.yaml is sync-generated; seed it empty so mihomo -t passes before the first sync.
  if [ ! -s "$(P /etc/mihomo/ruleset/mtrickle_bulk.yaml)" ]; then
    printf '%s\n%s\n' '# AUTO-GENERATED by /root/sync_mtrickle_mihomo.sh from magitrickle config - DO NOT EDIT' 'payload: []' > "$(P /etc/mihomo/ruleset/mtrickle_bulk.yaml)"
    info "mtrickle_bulk list: created empty (sync will fill it)"
  else
    info "mtrickle_bulk list: keeping existing /etc/mihomo/ruleset/mtrickle_bulk.yaml"
  fi
  # v1.15.0: torrent tracker allow-list -> DIRECT (static asset, generated by geomask-torrent.sh)
  if [ ! -s "$(P /etc/mihomo/ruleset/torrentdirect.yaml)" ]; then
    save_stream /etc/mihomo/ruleset/torrentdirect.yaml 644 <<'ASSET_EOF'
@@ASSET:torrentdirect.yaml@@
ASSET_EOF
  else
    info "torrentdirect list: keeping existing /etc/mihomo/ruleset/torrentdirect.yaml"
  fi
  ruleset_stub torrent /etc/mihomo/ruleset/torrentdirect.yaml
  # v1.20.4: zapret force-list exceptions (direction B). Owner-edited; never overwritten.
  if [ -s "$(P /etc/geomask/zapret-force-keep.txt)" ]; then
    info "zapret force-keep: keeping existing /etc/geomask/zapret-force-keep.txt"
  else
    mkdir -p "$(P /etc/geomask)" 2>/dev/null
    save_stream /etc/geomask/zapret-force-keep.txt 644 <<'ASSET_EOF'
@@ASSET:zapret-force-keep.txt@@
ASSET_EOF
  fi
  # v1.25.0: domains that must bypass zapret DPI even though they go DIRECT (Yandex).
  if [ -s "$(P /etc/geomask/zapret-always-exclude.txt)" ]; then
    info "zapret always-exclude: keeping existing /etc/geomask/zapret-always-exclude.txt"
  else
    mkdir -p "$(P /etc/geomask)" 2>/dev/null
    save_stream /etc/geomask/zapret-always-exclude.txt 644 <<'ASSET_EOF'
@@ASSET:zapret-always-exclude.txt@@
ASSET_EOF
  fi
  # v1.17.0: torrent admin - rebuild the tracker ruleset / toggle the DIRECT listener from the panel
  if module_selected torrent; then mkdir -p "$(P /etc/geomask/torrent)" 2>/dev/null; fi
  save_stream /usr/bin/geomask-torrent.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-torrent.sh@@
ASSET_EOF
  # v1.21.4: keep an existing lane across reinstalls - it carries an interface the owner may have
  # assigned MagiTrickle lists to, and losing it silently reroutes those lists.
  if [ -e "$(P /sys/class/net/VPN-noP2P)" ] && [ -x "$(P /usr/bin/geomask-lane.sh)" ]; then
    info "lane VPN-noP2P: already present, left untouched"
  elif [ -x "$(P /usr/bin/geomask-lane.sh)" ] && [ -n "${GM_AUTO_LANE:-}" ]; then
    "$(P /usr/bin/geomask-lane.sh)" install >/dev/null 2>&1 || warn "lane install failed"
  fi
  # v1.22.1: DNS safety audit - read-only, explains "site address not found" before it happens
  save_stream /usr/bin/geomask-dnscheck.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-dnscheck.sh@@
ASSET_EOF
  # v1.21.0: extra tunnel lane - gives MagiTrickle's interface dropdown a real netdev that
  # always exits through the restricted subscription, so a list can be pointed at it directly.
  save_stream /usr/bin/geomask-lane.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-lane.sh@@
ASSET_EOF
  # v1.20.6: morning check - read-only audit the owner runs after the restricted
  # subscription comes back, before enabling the torrent client again.
  save_stream /usr/bin/geomask-morning-check.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-morning-check.sh@@
ASSET_EOF
  # v1.18.0: VPN lane audit - record what tries to use the P2P-restricted subscription while it
  # is offline, so the operator can see the future load before switching it back on.
  if [ ! -s "$(P /etc/geomask/vpnwatch.conf)" ]; then
    save_stream /etc/geomask/vpnwatch.conf 644 <<'ASSET_EOF'
@@ASSET:geomask-vpnwatch.conf@@
ASSET_EOF
  else
    info "vpnwatch conf: keeping existing /etc/geomask/vpnwatch.conf"
  fi
  save_stream /usr/bin/geomask-vpnwatch.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-vpnwatch.sh@@
ASSET_EOF
  cron_ensure diagnostic '# geomask-vpnwatch$' '* * * * * /usr/bin/geomask-vpnwatch.sh --tick >/dev/null 2>&1 # geomask-vpnwatch'
  save_stream /etc/hotplug.d/iface/99-default-vpn-route 755 <<'ASSET_EOF'
@@ASSET:99-default-vpn-route@@
ASSET_EOF
  # pristine copy: the backend restores it if the live script ever goes missing, and it is
  # the only place that knows this router's LAN device and TUN name
  save_stream /usr/lib/geomask/99-default-vpn-route.dist 755 <<'ASSET_EOF'
@@ASSET:99-default-vpn-route@@
ASSET_EOF
  save_stream /usr/bin/geomask-guard.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-guard.sh@@
ASSET_EOF
  save_stream /etc/hotplug.d/iface/99-geomask-guard 755 <<'ASSET_EOF'
@@ASSET:99-geomask-guard@@
ASSET_EOF
  cron_ensure guard '# geomask-guard$' '*/5 * * * * /usr/bin/geomask-guard.sh >/dev/null 2>&1 # geomask-guard'
  if crontab -l 2>/dev/null | grep -q 'sync_mtrickle_mihomo'; then
    info "cron already present"
  else
    ( crontab -l 2>/dev/null; echo '*/5 * * * * /root/sync_mtrickle_mihomo.sh' ) | crontab - 2>/dev/null && info "cron added: */5 sync" || warn "cannot set crontab"
  fi
  # v1.11.0: nightly node audit (registry check of every subscription server)
  save_stream /usr/bin/geomask-node-scan.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-node-scan.sh@@
ASSET_EOF
  if [ ! -s "$(P /etc/geomask-nodes.conf)" ]; then
    save_stream /etc/geomask-nodes.conf 644 <<'ASSET_EOF'
@@ASSET:geomask-nodes.conf@@
ASSET_EOF
  else
    info "nodes conf: keeping existing /etc/geomask-nodes.conf"
  fi
  # v1.28.0: the night audit is now owned by the per-path scheduler.
  # The legacy 03:30 nodescan cron keeps running for paths that were never configured,
  # so a reinstall cannot silently stop auditing a router the owner never migrated.
  # Migration only seeds check-only schedules; it never enables auto-apply.
  _migrate_nodescan_cron() {
    if crontab -l 2>/dev/null | grep -q 'geomask-node-scan.*geomask-nodescan'; then
      _old_time=$(crontab -l 2>/dev/null | grep 'geomask-node-scan.*geomask-nodescan' \
                  | awk '{printf "%02d:%02d", $2, $1}' | head -1)
      [ -n "$_old_time" ] || _old_time="03:30"
      if [ -f "$(P /usr/lib/geomask/geomask-node-audit.py)" ]; then
        _seeded=$(python3 - "$_old_time" <<'PYEOF' 2>/dev/null || echo 0
import sys
sys.path.insert(0, '/usr/lib/geomask')
import importlib.util
spec = importlib.util.spec_from_file_location(
    'node_audit', '/usr/lib/geomask/geomask-node-audit.py')
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)
when = sys.argv[1]
seeded = 0
for ident in ('vpn', 'vpn_nop2p', 'ai'):
    current = mod.schedule_get(ident).get('schedule') or {}
    if current.get('enabled'):
        continue          # the owner already chose a schedule: never overwrite it
    mod.schedule_set(ident, 'true', when, 'check-only')
    seeded += 1
print(seeded)
PYEOF
)
        info "legacy nodescan cron found (${_old_time}); seeded check-only schedules for ${_seeded:-0} unconfigured path(s)"
      else
        warn "node-audit module missing: leaving the legacy nodescan cron untouched"
      fi
    else
      info "legacy nodescan cron: none"
    fi
  }
  _migrate_nodescan_cron
  # Install the legacy cron only if it is absent AND no path has a schedule, so a router
  # that the owner migrated is not audited twice every night.
  if crontab -l 2>/dev/null | grep -q 'geomask-node-scan'; then
    info "nodescan cron already present"
  elif [ "$(nodescan_schedule_active)" = "1" ]; then
    info "per-path scheduler is active: not adding the legacy nodescan cron"
  else
    ( crontab -l 2>/dev/null; echo '30 3 * * * /usr/bin/geomask-node-scan.sh >/dev/null 2>&1 # geomask-nodescan' ) | crontab - 2>/dev/null && info "cron added: 03:30 nodescan" || warn "cannot set crontab"
  fi
  # v1.14.0: YouTube edge watchdog - failing *.googlevideo.com edges get pinned to VPN,
  # released back to zapret nightly. Source of truth stays in MagiTrickle (group feeds ytvpn.yaml).
  save_stream /usr/bin/geomask-ytwatch.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-ytwatch.sh@@
ASSET_EOF
  if [ ! -s "$(P /etc/geomask-ytwatch.conf)" ]; then
    save_stream /etc/geomask-ytwatch.conf 644 <<'ASSET_EOF'
@@ASSET:geomask-ytwatch.conf@@
ASSET_EOF
  else
    # Keeping the operator's file must not mean "never learn new options": every key that the
    # shipped default introduces is appended if absent. Existing values are never touched -
    # that is how blanket_permanent failed to reach a live router and had to be added by hand.
    save_stream /tmp/geomask-ytwatch.conf.new 644 <<'ASSET_EOF'
@@ASSET:geomask-ytwatch.conf@@
ASSET_EOF
    _added=$(python3 - "$(P /etc/geomask-ytwatch.conf)" /tmp/geomask-ytwatch.conf.new <<'PYEOF'
import sys
live_p, new_p = sys.argv[1], sys.argv[2]
live=open(live_p,encoding='utf-8',errors='replace').read()
have={l.split('=',1)[0].strip() for l in live.splitlines() if '=' in l and not l.strip().startswith('#')}
add=[l for l in open(new_p,encoding='utf-8',errors='replace').read().splitlines()
     if '=' in l and not l.strip().startswith('#') and l.split('=',1)[0].strip() not in have]
if add:
    open(live_p,'a',encoding='utf-8',newline='\n').write('\n# added by geomask upgrade\n'+'\n'.join(add)+'\n')
print(len(add))
PYEOF
) || _added=0
    rm -f /tmp/geomask-ytwatch.conf.new
    if [ "${_added:-0}" != "0" ]; then
      info "ytwatch conf: kept existing settings, added $_added new option(s)"
    else
      info "ytwatch conf: keeping existing /etc/geomask-ytwatch.conf"
    fi
  fi
  # v1.20.4: the scan runs every minute (was */5). An old entry is rewritten in place;
  # v1.29.0: the migration only runs for a selected module, and cron_ensure owns creation.
  if module_selected youtube \
     && crontab -l 2>/dev/null | grep -qE '^\*/5 \* \* \* \* /usr/bin/geomask-ytwatch\.sh.*# geomask-ytwatch$'; then
    ( crontab -l 2>/dev/null | sed 's|^\*/5 \* \* \* \* /usr/bin/geomask-ytwatch.sh|*/1 * * * * /usr/bin/geomask-ytwatch.sh|' ) | crontab - 2>/dev/null \
      && info "ytwatch cron migrated */5 -> */1" || warn "cannot migrate the ytwatch cron"
  fi
  cron_ensure youtube '# geomask-ytwatch$' '*/1 * * * * /usr/bin/geomask-ytwatch.sh >/dev/null 2>&1 # geomask-ytwatch'
  cron_ensure youtube '# geomask-ytwatch-reset$' '20 4 * * * /usr/bin/geomask-ytwatch.sh --reset >/dev/null 2>&1 # geomask-ytwatch-reset'
  # v1.29.1: diagnostics logs keep 7 days (each run prunes its own file; this catches idle ones)
  cron_ensure doctor '# geomask-doctor-prune$' '40 4 * * * /usr/lib/geomask/geomask-doctor.py prune >/dev/null 2>&1 # geomask-doctor-prune'
  # v1.10.0: event sync watchdog - magitrickle save -> sync within ~seconds (cron stays as backup)
  if have apk; then apk add inotifywait >/dev/null 2>&1 || true; fi
  save_stream /usr/bin/geomask-syncd.sh 755 <<'ASSET_EOF'
@@ASSET:geomask-syncd.sh@@
ASSET_EOF
  save_stream /etc/init.d/geomask-syncd 755 <<'ASSET_EOF'
@@ASSET:geomask-syncd.init@@
ASSET_EOF
  initd geomask-syncd enable >/dev/null 2>&1 || true
  if pgrep -f geomask-syncd.sh >/dev/null 2>&1; then
    info "syncd: already running"
  else
    initd geomask-syncd restart >/dev/null 2>&1 || true
    sleep 1
    pgrep -f geomask-syncd.sh >/dev/null 2>&1 && info "syncd: started" || warn "syncd: cannot start (check logread)"
  fi
  if ! svc_alive magitrickled; then
    info "starting magitrickle..."
    initd magitrickle start >/dev/null 2>&1 || true
  fi
  if [ "$GM_RESTART" = 1 ]; then
    info "running sync once (--restart)..."
    sh "$(P /root/sync_mtrickle_mihomo.sh)" 2>&1 | sed 's/^/  | /' || true
  else
    warn "sync not run (it may restart mihomo). Run later: sh /root/sync_mtrickle_mihomo.sh  or use --restart"
  fi
  # v1.13.0: ship the lists template + seeder, and auto-seed MagiTrickle if it is empty (fresh install).
  write_lists_assets
  seed_lists ""
  # v1.29.0: a run that installs sync can also be the only install step (`--step 5 --modules=...`).
  modules_state_sync
  return 0
}
step5_verify() { step5_check; }

# ============================================================ STEP 6: services (start missing only)
SVC_LIST="dnsmasq magitrickled mihomo hev-socks5-tunnel rpcd ai-doh dnsmasq-ai"
# ai-doh/dnsmasq-ai run as generic binaries (https-dns-proxy/dnsmasq), so pidof
# by service name never matches - check their listening ports instead.
aidns_svc_ok() {
  case "$1" in
    ai-doh)     netstat -ltnu 2>/dev/null | grep -q '127.0.0.1:5055 ' ;;
    dnsmasq-ai)
      _aiip=${AIDNS_IP:-$(aidns_ip)}
      [ -n "$_aiip" ] && netstat -ltnu 2>/dev/null | grep -q "$_aiip:5353 " ;;
  esac
}
step6_check() {
  _need=0
  for s in $SVC_LIST; do
    case "$s" in
      magitrickled) _p=magitrickled ;;
      *) _p=$s ;;
    esac
    if [ -f "$(P /etc/geomask-aidns.off)" ] && { [ "$s" = ai-doh ] || [ "$s" = dnsmasq-ai ]; }; then
      info "$s: AI-DNS disabled - skipped"; continue
    fi
    if ! module_selected ai_dns && { [ "$s" = ai-doh ] || [ "$s" = dnsmasq-ai ]; }; then
      info "$s: модуль ai_dns не выбран - skipped"; continue
    fi
    if [ "$s" = hev-socks5-tunnel ] && ! module_selected path_ai && ! module_selected ai_dns; then
      info "$s: не нужен выбранным модулям - skipped"; continue
    fi
    case "$s" in
      ai-doh|dnsmasq-ai)
        if aidns_svc_ok "$s"; then info "$s: listening"
        else warn "$s: NOT listening"; _need=1; fi
        ;;
      *) svc_alive "$_p" && info "$s: running" || { warn "$s: NOT running"; _need=1; } ;;
    esac
  done
  return $_need
}
step6_apply() {
  for s in $SVC_LIST; do
    _p=$s; [ "$s" = magitrickled ] && _p=magitrickle
    if [ -f "$(P /etc/geomask-aidns.off)" ] && { [ "$s" = ai-doh ] || [ "$s" = dnsmasq-ai ]; }; then
      info "$s: AI-DNS disabled - skipped"; continue
    fi
    if ! module_selected ai_dns && { [ "$s" = ai-doh ] || [ "$s" = dnsmasq-ai ]; }; then
      info "$s: модуль ai_dns не выбран - skipped"; continue
    fi
    if [ "$s" = hev-socks5-tunnel ] && ! module_selected path_ai && ! module_selected ai_dns; then
      info "$s: не нужен выбранным модулям - skipped"; continue
    fi
    case "$s" in
      ai-doh|dnsmasq-ai)
        if aidns_svc_ok "$s"; then info "$s: already listening - untouched"; continue; fi
        info "starting $s (not listening)..."
        initd "$s" start >/dev/null 2>&1 || warn "cannot start $s"
        ;;
      *)
        if svc_alive "$s"; then info "$s: already running - untouched"; continue; fi
        info "starting $s (it was down)..."
        initd "$_p" start >/dev/null 2>&1 || warn "cannot start $s"
        ;;
    esac
  done
  return 0
}
step6_verify() { step6_check; }

# ============================================================ STEP 7: end-to-end verify (read-only)
step7_check() {
  _need=0
  _r=$(nslookup ya.ru 127.0.0.1 2>/dev/null | awk '/^Address: /{print $2}' | tail -1)
  if [ -n "$_r" ] && [ "$_r" != "127.0.0.1" ]; then info "DNS normal (ya.ru -> $_r)"; else bad "DNS broken for normal domains"; _need=1; fi
  _b=$(nslookup doubleclick.net 127.0.0.1 2>/dev/null | awk '/^Address: /{print $2}' | tail -1)
  case "$_b" in
    ""|0.0.0.0|::) info "DNS adblock (doubleclick.net -> ${_b:-NXDOMAIN})" ;;
    *) warn "adblock: doubleclick.net resolves to $_b (adblock-fast may be off)" ;;
  esac
  _code=$(curl -m 5 -s -o /dev/null -w '%{http_code}' http://www.gstatic.com/generate_204 2>/dev/null)
  [ "$_code" = "204" ] && info "connectivity: 204 OK" || { bad "connectivity: HTTP ${_code:-none}"; _need=1; }
  if _px=$(controller_curl -f -m 5 -s http://127.0.0.1:9090/proxies 2>/dev/null); then
    printf '%s' "$_px" | grep -q '"VPN"' && info "mihomo group VPN: in API" || { bad "mihomo group VPN missing"; _need=1; }
    printf '%s' "$_px" | grep -q '"AI"' && info "mihomo group AI: in API" || { bad "mihomo group AI missing"; _need=1; }
  else
    bad "mihomo controller request failed (check authentication/connectivity)"; _need=1
  fi
  if have ubus && module_selected luci; then
    ubus list 2>/dev/null | grep -qx 'geo-sync' && info "geo ubus: OK" || { bad "geo ubus: missing"; _need=1; }
  elif ! module_selected luci; then
    info "geo ubus: панель (модуль luci) не выбрана - проверка пропущена"
  fi
  if ip rule show 2>/dev/null | grep -q "iif $(lan_iface) ipproto icmp"; then info "ICMP bypass rule: present"; else warn "ICMP bypass rule absent - LAN ping may die in TUN"; fi
  # Routing depends on the hotplug script and its shared helper; a missing helper silently
  # disables the tunnel policy after the next ifup (audit follow-up, N01/N02).
  for _rf in /etc/hotplug.d/iface/99-default-vpn-route /usr/lib/geomask/geomask-routes.sh; do
    if [ -s "$(P "$_rf")" ]; then info "routing: $_rf present"
    else bad "routing: $_rf missing - VPN policy will not be applied on ifup"; _need=1; fi
  done
  if [ -f "$(P /tmp/geomask-routes/error-100)" ]; then
    bad "routing: last route sync failed ($(cat "$(P /tmp/geomask-routes/error-100)" 2>/dev/null)) - LAN may go direct"
    _need=1
  fi
  # IPv6 is not tunnelled (mihomo ipv6: false, IPv4-only policy): if the router or the LAN
  # still has global IPv6, services see the real address. OFF is the default now, so the check
  # reports a live leak as a failure and a merely-latent one as a warning (audit follow-up, N00).
  _v6_global=$(ip -6 addr show scope global 2>/dev/null | grep -c 'inet6 ')
  [ -n "$_v6_global" ] || _v6_global=0
  _v6_assign=$(uci -q get network.lan.ip6assign 2>/dev/null)
  _v6_ra=$(uci -q get dhcp.lan.ra 2>/dev/null)
  if [ "$GM_IPV6" = keep ]; then
    info "IPv6: сохранён по --ipv6=keep (глобальных адресов: $_v6_global)"
  elif [ "$_v6_global" -gt 0 ]; then
    bad "IPv6: $_v6_global глобальных адресов - реальный IP уходит мимо VPN (панель -> IPv6 -> Отключить)"
    _need=1
  elif [ "$_v6_assign" = 0 ] && [ "$_v6_ra" = disabled ]; then
    info "IPv6: выключен (ядро + LAN + firewall)"
  else
    # A warning here used to be skipped by run_step ("check: ALL GOOD"), so the default
    # "IPv6 off everywhere" was never applied on a router that had no global address yet but
    # still handed out IPv6 on the LAN. Latent leak is still a leak: fail the check so the
    # step actually runs.
    bad "IPv6: глобальных адресов нет, но LAN по-прежнему раздаёт IPv6 (ip6assign=${_v6_assign:-не задан}, ra=${_v6_ra:-не задан}) - префикс появится при подъёме WAN"
    _need=1
  fi
  # Console lane: while it is switched on, the rule is the only thing that keeps the console
  # off the normal path. A missing rule looks like "the game broke", so it is a failure here.
  _cs="$(P /etc/geomask/console.state)"
  if [ -f "$_cs" ] && [ "$(sed -n 's/^enabled=//p' "$_cs" 2>/dev/null | head -1)" = 1 ]; then
    _cip=$(sed -n 's/^ip=//p' "$_cs" 2>/dev/null | head -1)
    if ip rule show 2>/dev/null | grep -q "from $_cip lookup 102" \
       && ip route show table 102 2>/dev/null | grep -q '^default'; then
      info "console: отдельный выход включён для $_cip"
    else
      bad "console: правило для $_cip пропало - консоль идёт напрямую (панель -> «Включить путь консоли»)"
      _need=1
    fi
  fi
  # AI-DNS: client DNS of AI devices must be intercepted AND exit through the AI tunnel.
  # Checking only the fwmark route proved nothing about the clients: the DNAT rule can be
  # absent while this line still printed "no leak" (audit 14.11.2026, F08).
  if [ -f "$(P /etc/geomask-aidns.off)" ] || [ ! -f "$(P /etc/geomask-aidns.uid)" ]; then
    info "AI-DNS: not installed (DNS of AI devices resolves via router - run the aidns step)"
  else
    _rt=$(ip route get 1.1.1.1 mark 0x64 2>/dev/null)
    if [ -z "$_rt" ]; then
      warn "AI-DNS: routing check returned nothing (ip route unavailable?)"
    elif printf '%s' "$_rt" | grep -q 'dev AI'; then
      info "AI-DNS: marked DNS exits via AI tunnel"
    else
      bad "AI-DNS: marked DNS does NOT route via AI tunnel (leak!)"; _need=1
    fi
    _aip=$(aidns_ip)
    _aiips=$(awk '$2=="ai" && $1 !~ /^#/ {print $1}' "$(P /etc/geo-devices.list)" 2>/dev/null)
    if [ -z "$_aip" ]; then
      bad "AI-DNS: listen address cannot be determined - clients are not intercepted"; _need=1
    elif [ -n "$_aiips" ]; then
      _tbl=$(nft list table inet geomask_ai_dns 2>/dev/null)
      if printf '%s' "$_tbl" | grep -q "dnat ip to $_aip:$AIDNS_DNS_PORT"; then
        info "AI-DNS: client DNS for ai devices is redirected to $_aip:$AIDNS_DNS_PORT"
      else
        bad "AI-DNS: client DNAT to $_aip:$AIDNS_DNS_PORT is missing - ai devices use the router DNS"; _need=1
      fi
    fi
  fi
  return $_need
}
# Turning IPv6 off is the only writing action of the final step. It goes through the installed
# backend so the three layers (kernel, LAN/odhcpd, forwarding guard) live in exactly one place.
apply_ipv6_default() {
  if [ "$GM_IPV6" = keep ]; then
    info "IPv6: оставлен как есть (--ipv6=keep)"
    return 0
  fi
  _be="$(P /usr/bin/geo-backend.sh)"
  if [ ! -x "$_be" ]; then
    # With --modules core,path_vpn the backend is not installed. Reporting success here made
    # the installer believe IPv6 was handled while nothing was changed.
    bad "IPv6: backend не установлен - выключение IPv6 не выполнено (нужен модуль luci/core с geo-backend.sh)"
    return 1
  fi
  # No uci means this is not a router we can manage network settings on (a test sandbox or a
  # broken image). Saying "not applicable" is honest; failing the whole run is not.
  if ! command -v uci >/dev/null 2>&1; then
    warn "IPv6: uci недоступен в этом окружении - состояние IPv6 не менялось"
    return 0
  fi
  # The backend keeps its own defaults for the marker and the backup tree; hand it the paths
  # this installer actually uses, so a prefixed/test root and the real router agree.
  _out=$(GM_BACKUP_OK="$(P /etc/geomask/backup-ok)" GM_BACKUP_DIR="$(P $BACKUP_DIR)" \
         "$_be" ipv6 off 2>&1)
  case "$_out" in
    *'"ok":true'*) info "IPv6: выключен (ядро + LAN + firewall)"; return 0 ;;
    *) bad "IPv6: выключить не удалось: $(printf '%s' "$_out" | tail -1)"; return 1 ;;
  esac
}

step7_apply() { apply_ipv6_default; }
step7_verify() { step7_check; }

# ============================================================ runner
STEP_NAMES="env geo subs aidns sync services verify"

step_desc() {
  case "$1" in
    env)      printf 'проверка окружения: версия OpenWrt, место на диске, зависимости (только чтение)' ;;
    geo)      printf 'гео-оверлей: панель "Гео-маскировка и AI" в LuCI + бэкенд geo-sync' ;;
    subs)     printf 'подписки: ссылки VPN/AI и группы VPN/AI в mihomo (проверка доступности)' ;;
    aidns)    printf 'AI-DNS: DNS AI-устройств через их же туннель — нет утечки DNS (ставится по умолчанию)' ;;
    sync)     printf 'sync: синк magitrickle→mihomo: watchdog (секунды) + cron-страховка' ;;
    services) printf 'сервисы: mihomo, magitrickle, hev-туннели, dnsmasq, веб-интерфейс' ;;
    verify)   printf 'сквозная проверка: выходы VPN/AI, DNS, группа AI, интернет (ничего не меняет)' ;;
    *)        printf '' ;;
  esac
}

step_fn() { # step_fn N action -> call stepN_action
  _n=$1; _a=$2
  case "$_n-$_a" in
    1-check) step1_check ;; 1-apply) step1_apply ;; 1-verify) step1_verify ;;
    2-check) step2_check ;; 2-apply) step2_apply ;; 2-verify) step2_verify ;;
    3-check) step3_check ;; 3-apply) step3_apply ;; 3-verify) step3_verify ;;
    4-check) step4_check ;; 4-apply) step4_apply ;; 4-verify) step4_verify ;;
    5-check) step5_check ;; 5-apply) step5_apply ;; 5-verify) step5_verify ;;
    6-check) step6_check ;; 6-apply) step6_apply ;; 6-verify) step6_verify ;;
    7-check) step7_check ;; 7-apply) step7_apply ;; 7-verify) step7_verify ;;
    *) bad "unknown step $_n"; return 1 ;;
  esac
}

run_step() { # run_step N  (interactive/auto common logic)
  _n=$1
  _name=$(echo "$STEP_NAMES" | cut -d' ' -f"$_n")
  hdr "$_n/7" "$_name"
  _fc_before=$FAILCNT
  if step_fn "$_n" check; then
    info "check: ALL GOOD"
    PASS=$((PASS+1))
    SKIP=$((SKIP+1))
    return 0
  fi
  info "check: issues found - apply needed"
  if [ "$GM_CHECK_ONLY" = 1 ]; then
    info "(check-only mode: not applying)"
    return 1
  fi
  if [ "$GM_AUTO" = 1 ] || [ "$GM_YES" = 1 ] || ask "Apply step $_n ($_name)?"; then
    # every step below writes to the router: one verified full backup per run, before it.
    # Step 1 installs packages (apk/opkg), so it is a writing step too - it used to run
    # before any backup existed (audit 14.11.2026, F13). Step 6 starts the services, which is
    # just as much of a change and was the only writing step without the gate (review 15.11).
    case "$_n" in
     1|2|3|4|5|6|7) backup_gate || return 1 ;;
    esac
    # v1.29.0: an installing step is the right moment to ask which modules to carry.
    case "$_n" in 2|4|5) modules_maybe_prompt ;; esac
    if step_fn "$_n" apply; then
      info "--- verify ---"
      if step_fn "$_n" verify; then
        info "verify: PASS"
        # check-phase failures were fixed by apply - drop them from the global count
        FAILCNT=$_fc_before
        return 0
      else
        bad "verify: FAILED after apply"
        return 1
      fi
    else
      bad "apply failed or was skipped"
      return 1
    fi
  else
    info "skipped by user"
    SKIP=$((SKIP+1))
    return 2
  fi
}

# ============================================================ terminal UI
if [ -t 1 ]; then
  C_R="$(printf '\033[1;31m')"; C_G="$(printf '\033[1;32m')"; C_Y="$(printf '\033[1;33m')"
  C_B="$(printf '\033[1;36m')"; C_M="$(printf '\033[1;35m')"; C_DIM="$(printf '\033[38;5;244m')"
  NC="$(printf '\033[0m')"
else
  C_R=""; C_G=""; C_Y=""; C_B=""; C_M=""; C_DIM=""; NC=""
fi

clr()   { [ -t 1 ] && command -v clear >/dev/null 2>&1 && clear; return 0; }
PAUSE() { [ "$GM_YES" = 1 ] && return 0; [ -t 0 ] || return 0; printf '%sНажмите Enter...%s' "$C_DIM" "$NC"; read -r _p || true; echo; }

_maskurl()  { printf '%s' "${1:-}" | sed 's|/[^/]*$|/...|'; }
_row()      { printf '%s%-20s%s %s\n' "$C_Y" "$1:" "$NC" "$2"; }
_api_node() { controller_curl -s -m2 "http://127.0.0.1:9090/proxies/$1" 2>/dev/null | grep -oE '"now":"[^"]*"' | head -1 | sed 's/"now":"//;s/"$//'; }

_svc_row() { # _svc_row <label> <initd> <pidof-name>
  if [ ! -f "$(P /etc/init.d/$2)" ]; then _row "$1" "${C_DIM}не установлен${NC}"; return; fi
  if pidof "${3:-$2}" >/dev/null 2>&1; then _row "$1" "${C_G}запущен${NC}"; else _row "$1" "${C_R}остановлен${NC}"; fi
}

dashboard() {
  _model=$(cat "$(P /tmp/sysinfo/model)" 2>/dev/null)
  _rel=$(grep '^DISTRIB_RELEASE=' "$(P /etc/openwrt_release)" 2>/dev/null | cut -d"'" -f2)
  _row "Роутер" "${_model:-OpenWrt}${_rel:+ ${C_DIM}/ OpenWrt $_rel${NC}}"
  _svc_row "Zapret" zapret nfqws
  _svc_row "Mihomo" mihomo
  _svc_row "MagiTrickle" magitrickle magitrickled
  _svc_row "HevSocks5" hev-socks5-tunnel
  _svc_row "Dnsmasq" dnsmasq
  if [ -x "$(P /etc/init.d/adblock-fast)" ]; then
    _ab=$(grep -c 'server=/' "$(P /var/run/adblock-fast/dnsmasq.servers)" 2>/dev/null)
    _row "Adblock" "${C_G}${_ab:-0} доменов${NC}"
  fi
  _vpn=$(_api_node VPN); _ai=$(_api_node AI)
  _row "VPN узел" "${_vpn:-${C_DIM}нет ответа API${NC}}"
  _row "AI узел"  "${_ai:-${C_DIM}нет ответа API${NC}}"
  if [ -s "$(P /usr/bin/geo-backend.sh)" ] && ubus list 2>/dev/null | grep -qx 'geo-sync'; then
    _row "Geo LuCI" "${C_G}установлена${NC}"
  else
    _row "Geo LuCI" "${C_R}не установлена${NC}"
  fi
  if ip link show AI >/dev/null 2>&1; then _ait="${C_G}поднят${NC}"; else _ait="${C_DIM}нет${NC}"; fi
  _naic=$(grep -c ' ai ' "$(P /etc/geo-devices.list)" 2>/dev/null)
  _row "AI-туннель" "$_ait${_naic:+ · устройств: ${_naic:-0}}"
  _mt=$(grep -c 'DOMAIN-SUFFIX' "$(P /etc/mihomo/ruleset/mtrickle.yaml)" 2>/dev/null)
  _row "Sync правил" "${_mt:-0} в mtrickle.yaml"
  if [ -f "$(P /root/.geomask-norestart)" ]; then
    _row "VPN-рестарты" "${C_G}запрещены (pin)${NC}"
  else
    _row "VPN-рестарты" "${C_Y}разрешены${NC}"
  fi
}

print_banner() {
  printf '%s+========================================+%s\n' "$C_M" "$NC"
  printf '%s|%s      %sGEOMASK%s  -  geo-masking stack   %s|%s\n' "$C_M" "$NC" "$C_B" "$NC" "$C_M" "$NC"
  printf '%s+========================================+%s %sv%s%s\n' "$C_M" "$NC" "$C_DIM" "$GM_VERSION" "$NC"
}

show_menu() {
  echo
  printf '%s1)%s %sБыстрая диагностика%s %s(только чтение)%s\n'    "$C_B" "$NC" "$C_G" "$NC" "$C_DIM" "$NC"
  printf '%s2)%s %sПошаговый мастер%s %s(статус шагов, запуск любого отдельно)%s\n' "$C_B" "$NC" "$C_G" "$NC" "$C_DIM" "$NC"
  printf '%s3)%s %sПанель Гео%s %s(переустановить / обновить)%s\n'  "$C_B" "$NC" "$C_G" "$NC" "$C_DIM" "$NC"
  printf '%sf)%s %sУдалить -> установить -> настроить geomask%s\n'  "$C_B" "$NC" "$C_Y" "$NC"
  printf '%s0)%s Выход\n'                                          "$C_B" "$NC"
}

diag_quick() {
  PASS=0; FAILCNT=0; SKIP=0
  GM_CHECK_ONLY=1
  for n in 1 2 3 4 5 6 7; do run_step "$n" || true; done
  GM_CHECK_ONLY=0
  echo
  log "${C_DIM}== ДИАГНОСТИКА: pass=$PASS fail=$FAILCNT ==$NC"
}

# human-readable description of each step (bypasses ANY memory of "what is what")
step_desc() {
  case "$1" in
    env)      printf 'проверка окружения: версия OpenWrt, место на диске, зависимости (только чтение)' ;;
    geo)      printf 'гео-оверлей: панель "Гео-маскировка и AI" в LuCI + бэкенд geo-sync' ;;
    subs)     printf 'подписки: ссылки VPN/AI и группы VPN/AI в mihomo (проверка доступности)' ;;
    sync)     printf 'sync: синк magitrickle→mihomo: watchdog (секунды) + cron-страховка' ;;
    services) printf 'сервисы: mihomo, magitrickle, hev-туннели, dnsmasq, веб-интерфейс' ;;
    verify)   printf 'сквозная проверка: выходы VPN/AI, DNS, группа AI, интернет (ничего не меняет)' ;;
    *)        printf '' ;;
  esac
}

# step-by-step master: show status of every step, let the user run any single step
menu_master() {
  while :; do
    _n=1
    for _nm in $STEP_NAMES; do
      _d=$(step_desc "$_nm")
      if step_fn "$_n" check >/dev/null 2>&1; then
        printf '  %s%d)%s %s%-9s%s %s — %s %sвыполнено%s\n' "$C_B" "$_n" "$NC" "$C_Y" "$_nm" "$NC" "$_d" "$C_G" "$NC"
      else
        printf '  %s%d)%s %s%-9s%s %s — %s %sтребует внимания%s\n' "$C_B" "$_n" "$NC" "$C_Y" "$_nm" "$NC" "$_d" "$C_R" "$NC"
      fi
      _n=$((_n+1))
    done
    echo
    printf 'Номер шага для запуска (Enter - назад): '
    read -r _sel || return
    case "$_sel" in
      ''|q|Q) return ;;
      [1-7]) run_step "$_sel" || true; PAUSE ;;
      *) printf '%sнет такого шага%s\n' "$C_R" "$NC"; sleep 1 ;;
    esac
  done
}

# prompt for a subscription URL; keeps current value on Enter; honors flags/--yes
prompt_url() { # prompt_url <label> <current> <flag-value>  -> prints url, rc=1 if none
  _lbl="$1"; _cur="$2"; _flag="$3"
  if [ -n "$_flag" ]; then printf '%s' "$_flag"; return 0; fi
  if [ -n "$_cur" ]; then
    if [ "$GM_YES" = 1 ] || [ ! -t 0 ]; then printf '%s' "$_cur"; return 0; fi
    printf '%s [Enter = оставить %s]: ' "$_lbl" "$(_maskurl "$_cur")"
    read -r _v || _v=""
    printf '%s' "${_v:-$_cur}"
    return 0
  fi
  if [ "$GM_YES" = 1 ] || [ ! -t 0 ]; then return 1; fi
  while :; do
    printf '%s: ' "$_lbl"
    read -r _v || return 1
    case "$_v" in
      http://*|https://*) printf '%s' "$_v"; return 0 ;;
      '') return 1 ;;
      *) printf '  URL должен начинаться с http:// или https://\n' ;;
    esac
  done
}

# remove geomask parts (geo overlay, sync script, cron); keeps mihomo config
# $1 = noreload: skip the rpcd reload (caller re-registers right after install)
geomask_uninstall() {
  for f in /usr/bin/geo-backend.sh /usr/libexec/rpcd/geo-sync \
           /usr/share/rpcd/acl.d/luci-app-geo-sync.json \
           /usr/share/luci/menu.d/luci-app-geo-sync.json; do
    if [ -f "$(P "$f")" ]; then rm -f "$(P "$f")"; info "removed: $f"; fi
  done
  rm -f "$(P /www/luci-static/resources/view/geo-sync/main.js)" 2>/dev/null || true
  rmdir "$(P /www/luci-static/resources/view/geo-sync)" 2>/dev/null || true
  if [ -f "$(P /root/sync_mtrickle_mihomo.sh)" ]; then rm -f "$(P /root/sync_mtrickle_mihomo.sh)"; info "removed: sync script"; fi
  # v1.10.0: stop+remove the event sync watchdog
  if [ -x "$(P /etc/init.d/geomask-syncd)" ]; then
    initd geomask-syncd stop >/dev/null 2>&1 || true
    initd geomask-syncd disable >/dev/null 2>&1 || true
    pkill -f geomask-syncd.sh 2>/dev/null || true
    rm -f "$(P /etc/init.d/geomask-syncd)" "$(P /usr/bin/geomask-syncd.sh)"
    info "removed: syncd watchdog"
  fi
  # v1.11.0: node audit removal
  if crontab -l 2>/dev/null | grep -q 'geomask-node-scan'; then
    crontab -l 2>/dev/null | grep -v 'geomask-node-scan' | crontab - 2>/dev/null || true
  fi
  rm -f "$(P /usr/bin/geomask-node-scan.sh)"
  info "removed: node-scan (conf /etc/geomask-nodes.conf left for reference)"
  # v1.14.0: youtube edge watchdog removal. Release the auto-pins ONLY on a real uninstall:
  # --reinstall calls this too, and resetting there wiped every accumulated edge pin
  # (observed 31.10 18:21 - a self-update dropped 10 working pins).
  if [ -z "$1" ] && [ -x "$(P /usr/bin/geomask-ytwatch.sh)" ]; then
    "$(P /usr/bin/geomask-ytwatch.sh)" --reset >/dev/null 2>&1
  fi
  if crontab -l 2>/dev/null | grep -q 'geomask-ytwatch'; then
    crontab -l 2>/dev/null | grep -v 'geomask-ytwatch' | crontab - 2>/dev/null || true
  fi
  rm -f "$(P /usr/bin/geomask-ytwatch.sh)"
  info "removed: ytwatch (conf /etc/geomask-ytwatch.conf and /etc/geomask/ytwatch.state kept for reference)"
  # v1.15.0: torrent admin removal (ruleset + listener left in place: they belong to mihomo config)
  rm -f "$(P /usr/bin/geomask-torrent.sh)"
  info "removed: torrent admin (lists in /etc/geomask/torrent and the ruleset kept for reference)"
  # v1.18.0: vpnwatch removal (the audit log is kept - it is the evidence the operator collected)
  if crontab -l 2>/dev/null | grep -q 'geomask-vpnwatch'; then
    crontab -l 2>/dev/null | grep -v 'geomask-vpnwatch' | crontab - 2>/dev/null || true
  fi
  rm -f "$(P /usr/bin/geomask-vpnwatch.sh)"
  rm -f "$(P /usr/bin/geomask-morning-check.sh)"
  # The lane owns a service and a listener. Remove it ONLY on a real uninstall: --reinstall goes
  # through this function too, and wiping the lane there silently deletes an interface the owner
  # has assigned MagiTrickle lists to (same class of bug as the YouTube pins, fixed in v1.20.x).
  if [ -z "$1" ] && [ -x "$(P /usr/bin/geomask-lane.sh)" ]; then
    "$(P /usr/bin/geomask-lane.sh)" remove >/dev/null 2>&1 || warn "lane removal reported a problem"
  fi
  rm -f "$(P /usr/bin/geomask-lane.sh)"
  rm -f "$(P /usr/bin/geomask-dnscheck.sh)"
  info "removed: vpnwatch (conf /etc/geomask/vpnwatch.conf and the audit log kept)"
  # v1.28.0: node-audit subsystem modules. The settings store (/etc/geomask/node-audit.json),
  # its event log and the immutable report/pool directories are deliberately KEPT - they are
  # the operator's desired policies and the evidence behind them.
  for _m in geomask-node-audit.py geomask-audit-state.py geomask-config-tx.py \
            geomask-config-owner.py geomask-apply.py geomask-lane-torrent.py \
            geomask-sync-youtube.py geomask-audit-scheduler.py geomask-subscription-status.py \
            geomask-slot-patch.py geomask-console.py geomask-dnsguard.sh \
            geomask-diag-spool.py; do
    rm -f "$(P /usr/lib/geomask/$_m)"
  done
  if crontab -l 2>/dev/null | grep -q 'geomask-audit-schedule'; then
    crontab -l 2>/dev/null | grep -v 'geomask-audit-schedule' | crontab - 2>/dev/null || true
  fi
  info "removed: node-audit modules (settings, events and reports kept under /etc/geomask)"
  if crontab -l 2>/dev/null | grep -q 'sync_mtrickle_mihomo'; then
    crontab -l 2>/dev/null | grep -v 'sync_mtrickle_mihomo' | crontab - 2>/dev/null && info "cron entry removed"
  fi
  [ "$1" = "noreload" ] || initd rpcd reload 2>/dev/null || true
  return 0
}

# ---- reinstall preflight and rollback ---------------------------------------
# geomask_uninstall deletes the panel, backend, RPC registration, cron entries and helper
# scripts. The old flow called it first and only then asked write_mihomo_config, which can
# refuse a foreign config - the refusal arrived after the components were already gone.
#
# The snapshot is the rollback contract: everything uninstall removes or reconfigures must be
# in it, including "this file did not exist" and the autostart links. A component that is
# missing from the snapshot cannot be restored, and the previous version still reported a
# successful rollback (audit 14.11.2026, F05).
#
# A reinstall rewrites more than the panel files: write_mihomo_config patches the subscription
# URLs, AI-DNS and the sync step write uci and the generated rulesets, and the install stamps
# the version and the module selection. Leaving those out let a failed reinstall report a clean
# rollback while the router kept the new configuration (review 15.11, #23).
REINSTALL_TRACKED="/usr/libexec/rpcd/geo-sync
/usr/share/rpcd/acl.d/luci-app-geo-sync.json
/usr/share/luci/menu.d/luci-app-geo-sync.json
/www/luci-static/resources/view/geo-sync/main.js
/etc/init.d/geomask-syncd
/etc/hotplug.d/iface/99-default-vpn-route
/usr/lib/geomask/geomask-routes.sh
/usr/bin/geo-backend.sh
/root/sync_mtrickle_mihomo.sh
/etc/geomask/backup-share.enable
/etc/geomask-aidns.uid
/etc/geomask-aidns.ip
/etc/geomask-aidns.off
/etc/mihomo/config.yaml
/etc/config/network
/etc/config/dhcp
/etc/config/ksmbd
/etc/geomask/version
/etc/geomask/modules.json
/etc/geomask/modules-state.json"
# Directories whose whole content is part of the snapshot. The installer's own files in
# /usr/bin are matched by name, because that directory holds everything else on the router.
REINSTALL_TRACKED_DIRS="/usr/lib/geomask /etc/mihomo/ruleset"
REINSTALL_TRACKED_BIN="/usr/bin"

_reinstall_save() { # _reinstall_save <snapshot-dir> <install-path>
  [ -f "$(P "$2")" ] || return 0
  _rs_dir="$1/files$(dirname "$2")"
  mkdir -p "$_rs_dir" 2>/dev/null || return 1
  cp -p "$(P "$2")" "$_rs_dir/" 2>/dev/null || return 1
  printf '%s\n' "$2" >> "$1/present"
}

_reinstall_snapshot() { # _reinstall_snapshot <dir> -> 0 when the current components are saved
  mkdir -p "$1/files" 2>/dev/null || return 1
  : > "$1/present"; : > "$1/absent"; : > "$1/rc.d"
  crontab -l > "$1/crontab" 2>/dev/null || : > "$1/crontab"
  # An empty crontab is a state too: the file is always written, and restore always applies it.
  [ -f "$1/crontab" ] || : > "$1/crontab"
  for _f in ${REINSTALL_TRACKED:-}; do
    if [ -f "$(P "$_f")" ]; then
      _reinstall_save "$1" "$_f" || return 1
    else
      printf '%s\n' "$_f" >> "$1/absent"
    fi
  done
  # Globbed paths are expanded against the real root, so they are listed through P instead:
  # otherwise the snapshot silently missed every helper script.
  for _rd in ${REINSTALL_TRACKED_DIRS:-/usr/lib/geomask /etc/mihomo/ruleset}; do
    for _rf in "$(P "$_rd")"/*; do
      [ -f "$_rf" ] || continue
      _reinstall_save "$1" "${_rf#"$GM_PREFIX"}" || return 1
    done
  done
  for _rd in ${REINSTALL_TRACKED_BIN:-/usr/bin}; do
    for _rf in "$(P "$_rd")"/geomask*; do
      [ -f "$_rf" ] || continue
      _reinstall_save "$1" "${_rf#"$GM_PREFIX"}" || return 1
    done
  done
  # Autostart links: `disable` removes them, and a restore that only copies files back leaves
  # the service stopped without saying so.
  for _rl in "$(P /etc/rc.d)"/*geomask*; do
    [ -e "$_rl" ] || continue
    printf '%s\n' "${_rl#"$GM_PREFIX"}" >> "$1/rc.d"
  done
  return 0
}

_reinstall_restore() { # _reinstall_restore <dir> -> 0 only when every saved component is back
  _rr=0
  _list="$1/restore.list"
  ( cd "$1/files" 2>/dev/null && find . -type f ) > "$_list" 2>/dev/null || return 1
  while IFS= read -r _rel; do
    [ -n "$_rel" ] || continue
    _dst="$(P "${_rel#.}")"
    mkdir -p "$(dirname "$_dst")" 2>/dev/null || { _rr=1; continue; }
    cp -p "$1/files/$_rel" "$_dst" 2>/dev/null || _rr=1
  done < "$_list"
  # Byte check: the loop above only reproduces what `find` listed. A snapshot that lost a
  # component (interrupted copy, a full disk, a killed run) looked like a clean rollback, so
  # every path recorded as present must exist in the copy tree AND end up as the same bytes.
  if [ -f "$1/present" ]; then
    while IFS= read -r _rp; do
      [ -n "$_rp" ] || continue
      if [ ! -f "$1/files$_rp" ]; then
        bad "откат: в снимке нет копии $_rp"; _rr=1; continue
      fi
      cmp -s "$1/files$_rp" "$(P "$_rp")" || { bad "откат: $_rp не восстановлен"; _rr=1; }
    done < "$1/present"
  fi
  # Files this failed install created are not in the snapshot: remove them, or the next
  # start would mix the restored components with a half-written new version.
  for _rd in ${REINSTALL_TRACKED_BIN:-/usr/bin}; do
    for _rf in "$(P "$_rd")"/geomask*; do
      [ -f "$_rf" ] || continue
      grep -qxF ".${_rf#"$GM_PREFIX"}" "$_list" || rm -f "$_rf" 2>/dev/null || _rr=1
    done
  done
  for _rd in ${REINSTALL_TRACKED_DIRS:-/usr/lib/geomask /etc/mihomo/ruleset}; do
    for _rf in "$(P "$_rd")"/*; do
      [ -f "$_rf" ] || continue
      grep -qxF ".${_rf#"$GM_PREFIX"}" "$_list" || rm -f "$_rf" 2>/dev/null || _rr=1
    done
  done
  # Tracked paths that did not exist before must not survive the rollback either.
  if [ -f "$1/absent" ]; then
    while IFS= read -r _ra; do
      [ -n "$_ra" ] || continue
      [ -e "$(P "$_ra")" ] && { rm -f "$(P "$_ra")" 2>/dev/null || _rr=1; }
    done < "$1/absent"
  fi
  # cron: always restored, including the empty state (the old `-s` test skipped it)
  if [ -f "$1/crontab" ]; then crontab "$1/crontab" 2>/dev/null || _rr=1; fi
  # autostart links: recreate exactly what existed, drop what appeared during the failed run
  for _rl in "$(P /etc/rc.d)"/*geomask*; do
    [ -e "$_rl" ] || continue
    grep -qxF "${_rl#"$GM_PREFIX"}" "$1/rc.d" 2>/dev/null || rm -f "$_rl" 2>/dev/null || _rr=1
  done
  if [ -s "$1/rc.d" ]; then
    while IFS= read -r _rl; do
      [ -n "$_rl" ] || continue
      mkdir -p "$(dirname "$(P "$_rl")")" 2>/dev/null || { _rr=1; continue; }
      # the target is the init script behind a [SK]NN prefix, whatever the prefix is
      _rb=${_rl##*/}
      _rb=${_rb#S}; _rb=${_rb#K}
      _rb=$(printf '%s' "$_rb" | sed 's/^[0-9][0-9]//')
      # A filesystem without symlink support (or a copy fallback) may still produce the entry:
      # what matters is that the autostart entry exists again.
      ln -sf "../init.d/$_rb" "$(P "$_rl")" 2>/dev/null \
        || { [ -e "$(P "$_rl")" ] || _rr=1; }
    done < "$1/rc.d"
  fi
  # a restored init script is not running by itself: bring back what was enabled before
  if [ -s "$1/rc.d" ] && [ -f "$(P /etc/init.d/geomask-syncd)" ] \
     && grep -q 'geomask-syncd' "$1/rc.d" 2>/dev/null; then
    initd geomask-syncd start >/dev/null 2>&1 || _rr=1
  fi
  initd rpcd reload >/dev/null 2>&1 || true
  # Keep the snapshot when anything is still missing: it is the only copy of the old state.
  [ "$_rr" = 0 ] && rm -rf "$1"
  return $_rr
}

_reinstall_steps() { # _reinstall_steps <vpn-url> -> 0 only when every critical step succeeded
  _rvpn="$1"
  hdr "1/6" "удаление geomask"
  geomask_uninstall noreload || { bad "удаление не завершено"; return 1; }
  hdr "2/6" "гео-оверлей LuCI"
  step2_apply || { bad "файлы панели не записаны"; return 1; }
  step2_verify || { bad "проверка панели не пройдена"; return 1; }
  hdr "3/6" "mihomo: подписка + AI-USA"
  if write_mihomo_config "$_rvpn" ""; then
    api_refresh_provider sub "$_rvpn" && info "provider sub refreshed (no restart)" || warn "provider sub: refresh failed, применится при старте mihomo"
  else
    bad "конфиг mihomo не записан"
    return 1
  fi
  hdr "4/6" "AI-DNS (нет утечки DNS)"
  step4_apply || { bad "AI-DNS не настроен"; return 1; }
  step4_verify || { bad "проверка AI-DNS не пройдена"; return 1; }
  hdr "5/6" "синхронизация + роутинг"
  step5_apply || { bad "синхронизация не выполнена"; return 1; }
  step5_verify || { bad "проверка синхронизации не пройдена"; return 1; }
  hdr "6/6" "сервисы"
  step6_apply || { bad "сервисы не настроены"; return 1; }
  # The security baseline is part of a reinstall/update, not an optional extra: an update that
  # leaves IPv6 leaking is the same half-done repair the owner complained about elsewhere.
  # `--ipv6=keep` is the documented way out.
  hdr "IPv6" "выключение по умолчанию"
  apply_ipv6_default || { bad "IPv6 не выключен - переустановка отменена (--ipv6=keep, чтобы сохранить IPv6)"; return 1; }
  hdr "VERIFY" "итоговая проверка"
  step7_check || { bad "итоговая проверка не пройдена"; return 1; }
  info "verify: PASS"
  return 0
}

# full flow: uninstall -> install geo -> rewrite mihomo 2-subs -> sync+cron -> services -> verify
menu_reinstall() {
  hdr "REINSTALL" "Удалить -> установить -> настроить geomask"
  warn "Удалены и переустановлены: гео-оверлей LuCI, sync-скрипт, cron."
  warn "Mihomo конфиг: существующий 2-подписочный сохраняется (патчатся только ссылки подписок);"
  warn "без конфига/маркеров подписок — запись шаблоном (старый — в бэкапе)."
  warn "Mihomo НЕ перезапускается: подписки применяются через API без обрыва VPN."
  _c="$(P $MIHOMO_CONF)"
  _curv=""
  if [ -s "$_c" ]; then _curv=$(_prov_url "$_c" sub); fi
  # Every refusal is decided BEFORE the first removal: a foreign config, no room for the
  # snapshot, no way to reach the LAN. Nothing has been touched at this point.
  if [ -s "$_c" ] && ! geomask_config_shaped "$_c" && [ "${GM_ADOPT:-0}" != 1 ] \
     && [ "${GM_REPLACE:-0}" != 1 ]; then
    bad "на роутере свой конфиг mihomo - переустановка его не перезапишет"
    info "  Точечное управление: --adopt-config; полная замена с потерей настроек: --replace-config"
    return 1
  fi
  _free=$(df -k "$(P /tmp)" 2>/dev/null | awk 'NR==2{print $4}')
  case "$_free" in
    ''|*[!0-9]*) ;;
    *) [ "$_free" -lt 5120 ] && { bad "мало места в /tmp (${_free} КБ) - переустановка отменена"; return 1; } ;;
  esac
  ask "Продолжить переустановку?" || { warn "отменено"; return 1; }
  # Ownership of the mihomo config is decided by the YAML parser: without it a geomask
  # config looks foreign and the flow would uninstall everything and then refuse. Check
  # BEFORE the first removal, not at step 3, and only when there is a config to judge.
  if [ -s "$(P $MIHOMO_CONF)" ] && ! _py_yaml_ok; then
    bad "python3 и/или python3-yaml недоступны - владение конфигом mihomo не определить"
    info "  Установите пакеты и повторите: apk add python3 python3-yaml (или opkg install ...)"
    return 1
  fi
  backup_gate || return 1
  modules_maybe_prompt
  _vpn=$(prompt_url "Ссылка на ОБЩУЮ VPN-подписку (AI берёт из неё USA-узлы)" "$_curv" "$GM_VPN_URL") || { bad "URL подписки не задан"; return 1; }
  # A snapshot from an earlier failed attempt may still hold the only copy of the old
  # components: never delete a fixed name here (same rule as the backup park, F03).
  _snap=$(mktemp -d "$(P /tmp)/geomask-reinstall-XXXXXX" 2>/dev/null) \
    || { bad "не удалось создать каталог снимка в /tmp"; return 1; }
  _reinstall_snapshot "$_snap" || { bad "не удалось сохранить текущие компоненты - переустановка отменена"; rm -rf "$_snap"; return 1; }
  if ! _reinstall_steps "$_vpn"; then
    bad "переустановка не завершена - возвращаю прежние компоненты"
    _reinstall_restore "$_snap" || bad "откат неполный: копии остались в $_snap"
    return 1
  fi
  rm -rf "$_snap"
  log "Пересстановка geomask завершена."
  return 0
}

menu_loop() {
  while :; do
    clr
    print_banner
    echo
    dashboard
    show_menu
    printf '\n%sВыберите пункт:%s ' "$C_Y" "$NC"
    read -r _c || exit 0
    case "$_c" in
      1) diag_quick; PAUSE ;;
      2) menu_master || true; PAUSE ;;
      3) hdr "PANEL" "Панель Гео: переустановка/обновление"
         warn "Обновляет файлы панели (backend/rpcd/acl/страница); mihomo не трогается."
         run_step 2 || true; PAUSE ;;
      f|F) menu_reinstall || true; PAUSE ;;
      0|q|Q|"") exit 0 ;;
      *) printf '%sнеизвестный пункт%s\n' "$C_R" "$NC"; sleep 1 ;;
    esac
  done
}

usage() { sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; }

# ---- args ----
while [ $# -gt 0 ]; do
  case "$1" in
    --auto) GM_AUTO=1 ;;
    --check) GM_CHECK_ONLY=1 ;;
    --yes|-y) GM_YES=1 ;;
    --restart) GM_RESTART=1 ;;
    --backup) GM_BACKUP=1 ;;
    --reinstall) GM_REINSTALL=1 ;;
    --adopt-config) GM_ADOPT=1 ;;
    --replace-config) GM_REPLACE=1 ;;
    --step) shift; GM_STEP="${1:-}" ;;
    --vpn-url) shift; GM_VPN_URL="${1:-}" ;;
    --ai-url) shift; GM_AI_URL="${1:-}" ;;
    --modules) shift; GM_MODULES=$(printf '%s' "${1:-}" | tr ',' ' ') ;;
    --modules=*) GM_MODULES=$(printf '%s' "${1#--modules=}" | tr ',' ' ') ;;
    --list-modules)
      for _m in $GM_ALL_MODULES; do
        if module_required "$_m"; then _tag="[обязательный]"; else _tag="[по выбору]   "; fi
        printf "  %-18s %s %s\n" "$_m" "$_tag" "$(module_label "$_m")"
      done
      exit 0 ;;
    --seed-lists) GM_SEED_LISTS=1 ;;
    --ipv6) shift; GM_IPV6="${1:-off}" ;;
    --ipv6=*) GM_IPV6="${1#--ipv6=}" ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'unknown option: %s (see --help)\n' "$1"; exit 2 ;;
  esac
  shift
done

# validate --modules: a typo would otherwise install nothing and report success.
# A function, not an inline block: the regression test used to re-implement this logic and
# could pass while the installer itself was broken.
normalize_modules() { # normalize_modules <selection> -> validated selection with required modules
  _sel="$1"
  _valid=""
  for _m in $_sel; do
    case " $GM_ALL_MODULES " in
      *" $_m "*) _valid="$_valid $_m" ;;
      *) printf 'unknown module: %s (see --list-modules)\n' "$_m" >&2; return 2 ;;
    esac
  done
  _sel=$(printf '%s' "$_valid" | sed 's/^ *//;s/  */ /g')
  # core and path_vpn are not optional: the interactive picker adds them, the CLI used to
  # accept a set without them and install a product that cannot route anything.
  for _m in $GM_REQUIRED_MODULES; do
    case " $_sel " in *" $_m "*) ;; *) _sel="$_sel $_m" ;; esac
  done
  printf '%s' "$_sel" | sed 's/^ *//;s/  */ /g'
}

if [ -n "$GM_MODULES" ]; then
  GM_MODULES=$(normalize_modules "$GM_MODULES") || exit 2
fi

case "$GM_IPV6" in
  off|keep) ;;
  *) printf 'unknown --ipv6 value: %s (off|keep)\n' "$GM_IPV6" >&2; exit 2 ;;
esac

# hard pin: router owner may forbid restarts permanently via flag file
if [ "$GM_RESTART" = 1 ] && [ -f "$(P /root/.geomask-norestart)" ]; then
  log "NOTE: /root/.geomask-norestart present - ignoring --restart (owner forbids VPN interruption)."
  GM_RESTART=0
fi

RC=0
if [ "$GM_BACKUP" = 1 ]; then
  _b=$(ensure_backup full) && { info "полный бэкап: $_b"; info "SMB (свежая копия): \\\\$(lan_ip)\\geomask-backups ; история на ПК: geomask\\fetch_backup.ps1"; RC=0; } || { bad "полный бэкап не создан"; RC=1; }
elif [ "$GM_REINSTALL" = 1 ]; then
  menu_reinstall || RC=1
elif [ "$GM_SEED_LISTS" = 1 ]; then
  if backup_gate; then write_lists_assets && seed_lists force || RC=1; else RC=1; fi
elif [ -n "$GM_STEP" ]; then
  run_step "$GM_STEP" || RC=1
elif [ "$GM_AUTO" = 1 ] || [ "$GM_CHECK_ONLY" = 1 ]; then
  log "geomask v$GM_VERSION  mode: $([ "$GM_CHECK_ONLY" = 1 ] && echo check || echo auto)"
  if [ "$GM_CHECK_ONLY" != 1 ] && ! preflight; then
    bad "preflight не пройден - ничего не изменено"
    log ""
    log "== SUMMARY: pass=$PASS fail=$FAILCNT skipped_steps=$SKIP =="
    exit 1
  fi
  for n in 1 2 3 4 5 6 7; do
    if [ "$GM_CHECK_ONLY" = 1 ]; then
      run_step "$n" || true
    else
      run_step "$n" || { [ $? -eq 1 ] && { RC=1; bad "aborting on step $n failure"; break; }; }
    fi
  done
else
  menu_loop
fi

log ""
log "${C_DIM}== SUMMARY: pass=$PASS fail=$FAILCNT skipped_steps=$SKIP ==$NC"
[ "$FAILCNT" -eq 0 ] || RC=1
exit $RC
