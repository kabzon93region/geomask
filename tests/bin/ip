#!/bin/sh
# stub ip: `rule` -> state/ip_rules; `link`/`addr` -> fake Mihomo/LAN.
#
# Non-main route tables are STATEFUL (R12 review, round 2): a writer reconciles its ownership
# record with `ip route show table <t>`, so a stateless stub that answers every read with an
# empty table makes a healthy reconcile look like a lost table (the empty read-back guard then
# correctly refuses to record and returns 77). State: ${GM_STATE:-/tmp}/ip_table_<table>, one
# route line per line; `replace` swaps the entry with the same destination prefix, `del`
# removes the exact line, `show` prints the file.
_state=${GM_STATE:-/tmp}
mkdir -p "$_state" 2>/dev/null

case "$*" in
  "rule show") cat "$_state/ip_rules" 2>/dev/null; exit 0 ;;
  "rule add "*) printf '%s\n' "$*" >> "$_state/ip_rules"; exit 0 ;;
  "rule del "*) exit 0 ;;
  "route show table main")
    # one connected LAN route: enough for the shared route helper to have work to do
    echo "192.168.0.0/24 dev br-lan proto kernel scope link src 192.168.0.1"
    exit 0 ;;
  "route show table "*" exact "*) exit 1 ;;
  "route show default") echo "default via 192.168.0.254 dev br-lan"; exit 0 ;;
  "route "*)
    _rcmd=$2
    shift 2
    _rt=''
    if [ "${1:-}" = table ] && [ "$#" -ge 2 ]; then
      _rt=$2
      shift 2
    fi
    [ -n "$_rt" ] || exit 0
    _f="$_state/ip_table_$_rt"
    case "$_rcmd" in
      show)
        [ -f "$_f" ] && cat "$_f"
        exit 0 ;;
      replace)
        _line=$*
        _pfx=${_line%% *}
        if [ -f "$_f" ]; then
          awk -v p="$_pfx" '$1 != p' "$_f" > "$_f.new" 2>/dev/null && mv -f "$_f.new" "$_f"
        fi
        printf '%s\n' "$_line" >> "$_f"
        exit 0 ;;
      del)
        _line=$*
        if [ -f "$_f" ]; then
          awk -v l="$_line" '$0 != l' "$_f" > "$_f.new" 2>/dev/null && mv -f "$_f.new" "$_f"
        fi
        exit 0 ;;
    esac
    exit 0 ;;
  *"addr show"*)
    # the router's LAN address, plus the AI-DNS alias the aidns step adds
    echo "    inet 192.168.0.1/24 brd 192.168.0.255 scope global br-lan"
    echo "    inet 192.168.0.53/24 brd 192.168.0.255 scope global br-lan"
    exit 0 ;;
  *link*show*) echo "3: Mihomo: <POINTOPOINT,UP> mtu 8500"; exit 0 ;;
  *) exit 0 ;;
esac
